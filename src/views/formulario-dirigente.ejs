            const email = document.getElementById(`dirigenteEmail${i}`).value;

            dirigentes.push([
                { text: `${nome}\n${cargo}`, fontSize:10 },
                { text: `RG: ${rg} — ${orgao}/${ufOrg}\nCPF: ${cpf}`, fontSize:10 },
                { text: `${end}\nTel: ${tel}\nEmail: ${email}`, fontSize:10 }
            ]);
        }

        // textos condicionais
        const txContasRej = contasRej
            ? [
                { text: 'V – tiveram as contas rejeitadas, mas demonstraram, nos termos do art. 39, IV, alíneas "a", "b" e "c", da Lei nº 13.019, de 2014, que:', margin:[0,10], alignment:'justify' },
                { text: 'V.1 – a irregularidade que motivou a rejeição das contas foi sanada e que os débitos eventualmente imputados foram quitados;', margin:[15,5], alignment:'justify' },
                { text: 'V.2 – a decisão de rejeição das contas foi reconsiderada ou revista;', margin:[15,5], alignment:'justify' },
                { text: 'V.3 – a decisão sobre a apreciação das contas está pendente de decisão sobre recurso com efeito suspensivo;', margin:[15,5], alignment:'justify' }
              ]
            : [{ text: 'V – não tiveram as contas rejeitadas pela Administração Pública nos últimos cinco anos.', margin:[0,10], alignment:'justify' }];

        const txSancoes = sancoes
            ? { text: 'VI – foram punidos, mas o período que durou a penalidade já se exauriu.', margin:[0,10], alignment:'justify' }
            : { text: 'VI – não foram punidos com as sanções previstas no art. 39, inciso V, alíneas "a", "b", "c" e "d", da Lei nº 13.019, de 2014.', margin:[0,10], alignment:'justify' };

        const txImprobidade = improbidade
            ? { text: 'c) foram consideradas responsáveis por ato de improbidade, mas os respectivos efeitos, nos prazos previstos no art. 12, incisos I, II e III, da Lei nº 8.429, de 1992, já se exauriram.', margin:[15,5], alignment:'justify' }
            : { text: 'c) não foram considerados responsáveis por ato de improbidade.', margin:[15,5], alignment:'justify' };

        const docDef = {
            pageSize: 'A4',
            pageMargins: [40, 90, 40, 45],
            background: watermark
                ? () => [{ image: watermark, width: 595, height: 842, opacity: 0.45, absolutePosition: { x:0, y:0 } }]
                : undefined,
            header: (page) => ({
                stack: [
                    { text: nomeEntidade.toUpperCase(), fontSize:14, bold:true, alignment:'center', color:'#003087' },
                    { text: enderecoEntidade, fontSize:9.5, alignment:'center', italics:true, color:'#555', margin:[0,2,0,0] }
                ],
                margin: [40, page === 1 ? 14 : 40, 40, 10]
            }),
            footer: (page, count) => ({
                text: `Página ${page} de ${count}`,
                alignment:'right', margin:[0,0,40,12], fontSize:9, color:'#777'
            }),
            content: [
                {
                    text: 'DECLARAÇÃO DOS ARTIGOS 26 E 27 DO DECRETO Nº 8.726/2016\nE ARTIGO 39 DA LEI Nº 13.019/2014',
                    style:'titulo', alignment:'center', margin:[0,16,0,14]
                },
                {
                    text: `Declaro, em nome da ${nomeEntidade} (CNPJ: ${cnpj}), nos termos dos artigos 26, caput, inciso VII, e 27 do Decreto nº 8.726, de 27 de abril de 2016, e artigo 39, incisos III ao VII, da Lei nº 13.019, de 31 de julho de 2014, que os seus dirigentes abaixo relacionados, a saber:`,
                    alignment:'justify', lineHeight:1.3, margin:[0,0,0,12]
                },
                {
                    text: 'RELAÇÃO NOMINAL ATUALIZADA DOS DIRIGENTES DA ENTIDADE',
                    style:'subtitulo', alignment:'center', decoration:'underline', margin:[0,8,0,12]
                },
                {
                    table: {
                        headerRows: 1,
                        widths: ['30%','35%','35%'],
                        body: [
                            [
                                { text:'Nome e Cargo',                         bold:true, fillColor:'#dce6f4', alignment:'center', fontSize:10 },
                                { text:'Identidade, Órgão, UF e CPF',          bold:true, fillColor:'#dce6f4', alignment:'center', fontSize:10 },
                                { text:'Endereço, Telefone e E-mail',           bold:true, fillColor:'#dce6f4', alignment:'center', fontSize:10 }
                            ],
                            ...dirigentes
                        ]
                    },
                    layout: {
                        hLineWidth: (i,n) => (i===0||i===n.table.body.length)?2:1,
                        vLineWidth: (i,n) => (i===0||i===n.table.widths.length)?2:1,
                        hLineColor: () => '#6680aa',
                        vLineColor: () => '#6680aa',
                        paddingLeft: () => 6, paddingRight: () => 6,
                        paddingTop: () => 5, paddingBottom: () => 5
                    },
                    margin:[0,0,0,14]
                },
                { text:'I – não são membros de Poder ou do Ministério Público, nem dirigem órgão ou entidade da Administração Pública Federal;', margin:[0,8], alignment:'justify', lineHeight:1.3 },
                { text:'II – não são cônjuges, companheiros ou parentes em linha reta, colateral ou por afinidade até o segundo grau de membros de Poder, do Ministério Público ou de dirigentes de órgão ou entidade da Administração Pública Federal;', margin:[0,8], alignment:'justify', lineHeight:1.3 },
                { text:'III – não contratarão, com recursos da parceria, servidores ou empregados públicos, incluindo cônjuges, companheiros ou parentes em linha reta, colateral ou por afinidade até o segundo grau, salvo hipóteses previstas em lei específica ou na lei de diretrizes orçamentárias;', margin:[0,8], alignment:'justify', lineHeight:1.3 },
                { text:'IV – não serão remunerados, a qualquer título, com recursos repassados:', margin:[0,8], alignment:'justify', lineHeight:1.3 },
                { text:'a) membros de Poder, do Ministério Público ou dirigentes de órgão ou entidade da administração pública federal;', margin:[15,5], alignment:'justify', lineHeight:1.3 },
                { text:'b) servidores ou empregados públicos, incluindo cônjuges, companheiros ou parentes em linha reta, colateral ou por afinidade até o segundo grau, salvo hipóteses previstas em lei específica ou na lei de diretrizes orçamentárias;', margin:[15,5], alignment:'justify', lineHeight:1.3 },
                { text:'c) pessoas naturais condenadas por crimes contra a administração pública, patrimônio público, crimes eleitorais com pena privativa de liberdade ou lavagem de bens, direitos e valores;', margin:[15,5], alignment:'justify', lineHeight:1.3 },
                ...txContasRej,
                txSancoes,
                { text:'VII – não foram, nos últimos 8 (oito) anos:', margin:[0,8], alignment:'justify', lineHeight:1.3 },
                { text:'a) julgados com contas relativas a parcerias irregulares ou rejeitadas por Tribunal ou Conselho de Contas, em decisão irrecorrível;', margin:[15,5], alignment:'justify', lineHeight:1.3 },
                { text:'b) inabilitados por falta grave para exercer cargo em comissão ou função de confiança, enquanto durar a inabilitação;', margin:[15,5], alignment:'justify', lineHeight:1.3 },
                txImprobidade,
                { text:`\n${municipio}/${uf}, na data da assinatura eletrônica.`, alignment:'center', margin:[0,28,0,0], lineHeight:1.3 },
                { text:'_________________________________', alignment:'center', margin:[0,16] },
                { text: nomeRep,  alignment:'center', bold:true, margin:[0,4] },
                { text: cargoRep, alignment:'center', fontSize:11, color:'#555' }
            ],
            styles: {
                titulo:    { fontSize:14, bold:true, color:'#002147' },
                subtitulo: { fontSize:12, bold:true, color:'#002147' }
            },
            defaultStyle: { font:'Roboto', fontSize:11, lineHeight:1.25 }
        };

        pdfMake.createPdf(docDef).download(
            `declaracao-art2627_${nomeEntidade.replace(/\s+/g,'_')}.pdf`
        );
        mostrarToast('✅ PDF gerado com sucesso!');

    } catch(err) {
        console.error('Erro ao gerar PDF:', err);
        mostrarModal([`Erro inesperado ao gerar o PDF: ${err.message || err}. Tente novamente ou contate o suporte.`]);
    } finally {
        btn.classList.remove('btn-loading');
        btn.innerHTML = '📄 Gerar PDF — Art. 26/27';
    }
}

/* ══════════════════════════════════════════════════════════
   CNPJ FETCH
══════════════════════════════════════════════════════════ */
async function fetchCNPJ(cnpj) {
    const clean = cnpj.replace(/\D/g,'');
    if (clean.length !== 14) return;
    const msgEl = document.getElementById('cnpjMsg');
    msgEl.textContent = '🔍 Consultando…'; msgEl.className = 'campo-msg';
    try {
        const r = await fetch(`https://open.cnpja.com/office/${clean}`);
        const d = await r.json();
        if (d.status !== 404 && d.company) {
            document.getElementById('nomeEntidade').value = d.company.name || '';
            const a = d.address;
            if (a) {
                document.getElementById('enderecoEntidade').value =
                    `${a.street||''}, ${a.district||''}, ${a.city||''} - ${a.state||''}, CEP: ${a.zip||''}`.trim();
                await populateUFsDropdown(a.state);
                await populateMunicipiosDropdown(a.state, a.city);
            }
            msgEl.textContent = '✓ CNPJ encontrado'; msgEl.className = 'campo-msg ok';
            document.getElementById('cnpj').classList.remove('campo-erro');
            document.getElementById('cnpj').classList.add('campo-ok');
        } else {
            msgEl.textContent = 'CNPJ não encontrado'; msgEl.className = 'campo-msg erro';
            document.getElementById('cnpj').classList.add('campo-erro');
        }
    } catch(e) {
        msgEl.textContent = 'Erro ao consultar CNPJ (preenchimento manual disponível)';
        msgEl.className = 'campo-msg erro';
    }
}

/* ══════════════════════════════════════════════════════════
   INIT
══════════════════════════════════════════════════════════ */
document.addEventListener('DOMContentLoaded', async () => {
    await fetchUFs();
    await populateUFsDropdown();

    // UF → carrega municípios
    document.getElementById('ufEntidade').addEventListener('change', e => {
        populateMunicipiosDropdown(e.target.value);
    });

    // Filtro de letras
    document.getElementById('nomeRepresentante').addEventListener('input', function() {
        this.value = this.value.replace(/[^A-Za-zÀ-ÖØ-öø-ÿ\s]/g,'');
    });
    document.getElementById('cargoRepresentante').addEventListener('input', function() {
        this.value = this.value.replace(/[^A-Za-zÀ-ÖØ-öø-ÿ\s]/g,'');
    });

    document.getElementById('gerarCamposBtn').addEventListener('click', gerarCampos);

    document.getElementById('botaoGerarPDF').addEventListener('click', async () => {
        if (validarCamposObrigatorios()) await gerarPDF();
    });

    document.getElementById('cnpj').addEventListener('input', e => {
        formatarCNPJ(e.target);
        if (e.target.value.replace(/\D/g,'').length === 14) fetchCNPJ(e.target.value);
    });

    // Gera 1 dirigente por padrão
    gerarCampos();
});
</script>
