function formatarCNPJ(input) {
    let value = input.value.replace(/\D/g, '');
    value = value.replace(/^(\d{2})(\d)/, '$1.$2');
    value = value.replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3');
    value = value.replace(/\.(\d{3})(\d)/, '.$1/$2');
    value = value.replace(/(\d{4})(\d)/, '$1-$2');
    input.value = value.slice(0, 18);
}

async function fetchCNPJ(cnpj) {
    try {
        const cleanCNPJ = cnpj.replace(/\D/g, '');
        if (cleanCNPJ.length === 14) {
            const response = await fetch(`https://brasilapi.com.br/api/cnpj/v1/${cleanCNPJ}`);
            const data = await response.json();
            if (data.status !== 'ERROR') {
                document.getElementById('nomeEntidade').value = data.razao_social || data.nome;
                if (data.cep) {
                    await fetchCEPFromCNPJ(data.cep);
                } else {
                    document.getElementById('enderecoEntidade').value = '';
                }
            } else {
                alert('CNPJ inválido ou não encontrado.');
                document.getElementById('nomeEntidade').value = '';
                document.getElementById('enderecoEntidade').value = '';
            }
        }
    } catch (error) {
        console.error('Erro ao buscar CNPJ:', error);
        alert('Erro ao buscar CNPJ. Verifique sua conexão ou o CNPJ informado.');
        document.getElementById('nomeEntidade').value = '';
        document.getElementById('enderecoEntidade').value = '';
    }
}

async function fetchCEPFromCNPJ(cep) {
    try {
        const response = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
        const data = await response.json();
        if (!data.erro) {
            document.getElementById('enderecoEntidade').value = `${data.logradouro || ''}, ${data.bairro || ''}, ${data.localidade || ''} - ${data.uf || ''}, CEP: ${data.cep || ''}`.trim();
        } else {
            document.getElementById('enderecoEntidade').value = '';
        }
    } catch (error) {
        console.error('Erro ao buscar endereço:', error);
        document.getElementById('enderecoEntidade').value = '';
    }
}

