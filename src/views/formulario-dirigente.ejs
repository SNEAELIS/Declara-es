/* ══════════════════════════════════════════════════════════
   VALIDAÇÃO
══════════════════════════════════════════════════════════ */
function validarCamposObrigatorios() {
    const erros = [];
    document.querySelectorAll('.campo-erro').forEach(el => el.classList.remove('campo-erro'));

    // ── BLOCO 1: verifica se campos foram gerados ──────────
    if (!camposGerados || !document.getElementById('dirigenteNome1')) {
        document.getElementById('avisoCampos').classList.add('visivel');
        document.getElementById('avisoCampos').scrollIntoView({ behavior:'smooth', block:'center' });
        mostrarModal(['Clique em "Gerar campos" antes de gerar o PDF para que os campos dos dirigentes apareçam.']);
        return false;
    }

    // ── BLOCO 2: dados da entidade ─────────────────────────
    function req(id, label) {
        const el = document.getElementById(id);
        if (!el) return false;
        const val = el.tagName === 'SELECT' ? el.value : el.value.trim();
        if (!val) {
            el.classList.add('campo-erro');
            erros.push(`"${label}" é obrigatório.`);
            return false;
        }
        return true;
    }

    req('cnpj',              'CNPJ');
    req('nomeEntidade',      'Nome da Entidade');
    req('enderecoEntidade',  'Endereço');
    req('nomeRepresentante', 'Nome do Representante');
    req('cargoRepresentante','Cargo do Representante');
    req('ufEntidade',        'UF');
    req('municipioEntidade', 'Município');

    const nameRegex = /^[A-Za-zÀ-ÖØ-öø-ÿ\s]+$/;
    const nomeRep  = document.getElementById('nomeRepresentante').value.trim();
    const cargoRep = document.getElementById('cargoRepresentante').value.trim();
    if (nomeRep && !nameRegex.test(nomeRep)) {
        document.getElementById('nomeRepresentante').classList.add('campo-erro');
        erros.push('"Nome do Representante" deve conter apenas letras e espaços.');
    }
    if (cargoRep && !nameRegex.test(cargoRep)) {
        document.getElementById('cargoRepresentante').classList.add('campo-erro');
        erros.push('"Cargo do Representante" deve conter apenas letras e espaços.');
    }

    // ── BLOCO 3: dados de cada dirigente ───────────────────
    const num = parseInt(document.getElementById('numDirigentes').value) || 0;

    for (let i = 1; i <= num; i++) {
        const p = `Dirigente ${i}:`;

        const nome = document.getElementById(`dirigenteNome${i}`)?.value?.trim();
        if (!nome) { document.getElementById(`dirigenteNome${i}`)?.classList.add('campo-erro'); erros.push(`${p} "Nome" é obrigatório.`); }

        const cargo = document.getElementById(`dirigenteCargo${i}`)?.value?.trim();
        if (!cargo) { document.getElementById(`dirigenteCargo${i}`)?.classList.add('campo-erro'); erros.push(`${p} "Cargo" é obrigatório.`); }

        const cpfRaw = (document.getElementById(`dirigenteCPF${i}`)?.value || '').replace(/\D/g,'');
        if (cpfRaw.length !== 11) {
            document.getElementById(`dirigenteCPF${i}`)?.classList.add('campo-erro');
            erros.push(`${p} CPF inválido (informe 11 dígitos).`);
        }

        const rgRaw = (document.getElementById(`dirigenteRG${i}`)?.value || '').replace(/\D/g,'');
        if (rgRaw.length < 5) {
            document.getElementById(`dirigenteRG${i}`)?.classList.add('campo-erro');
            erros.push(`${p} RG inválido (mínimo 5 dígitos).`);
        }

        const orgao = document.getElementById(`dirigenteOrgao${i}`)?.value;
        if (!orgao) { document.getElementById(`dirigenteOrgao${i}`)?.classList.add('campo-erro'); erros.push(`${p} "Órgão Expedidor" é obrigatório.`); }

        const uf = document.getElementById(`dirigenteUF${i}`)?.value;
        if (!uf) { document.getElementById(`dirigenteUF${i}`)?.classList.add('campo-erro'); erros.push(`${p} "UF do Órgão" é obrigatória.`); }

        const cepRaw = (document.getElementById(`dirigenteCEP${i}`)?.value || '').replace(/\D/g,'');
        if (cepRaw.length !== 8) {
            document.getElementById(`dirigenteCEP${i}`)?.classList.add('campo-erro');
            erros.push(`${p} CEP inválido.`);
        }

        const numero = document.getElementById(`dirigenteNumero${i}`)?.value?.trim();
        if (!numero) { document.getElementById(`dirigenteNumero${i}`)?.classList.add('campo-erro'); erros.push(`${p} "Número" do endereço é obrigatório.`); }

        const telRaw = (document.getElementById(`dirigenteTelefone${i}`)?.value || '').replace(/\D/g,'');
        if (telRaw.length < 10) {
            document.getElementById(`dirigenteTelefone${i}`)?.classList.add('campo-erro');
            erros.push(`${p} Telefone inválido.`);
        }

        const email = document.getElementById(`dirigenteEmail${i}`)?.value?.trim();
        if (!email) {
            document.getElementById(`dirigenteEmail${i}`)?.classList.add('campo-erro');
            erros.push(`${p} "E-mail" é obrigatório.`);
        } else {
            const emailStatus = document.getElementById(`emailStatus${i}`)?.textContent || '';
            if (emailStatus.includes('inválido') || emailStatus.includes('já usado')) {
                erros.push(`${p} Corrija o e-mail (${emailStatus}).`);
            }
        }
    }

    if (erros.length > 0) {
        mostrarModal(erros);
        const primeiro = document.querySelector('.campo-erro');
        if (primeiro) primeiro.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return false;
    }

    return true;
}

/* ══════════════════════════════════════════════════════════
   IMAGEM BASE64
══════════════════════════════════════════════════════════ */
function getBase64Image(src) {
    return new Promise((resolve) => {
        const img = new Image();
        img.crossOrigin = 'Anonymous';
        img.onload = () => {
            try {
                const canvas = document.createElement('canvas');
                canvas.width = img.width; canvas.height = img.height;
                canvas.getContext('2d').drawImage(img, 0, 0);
                resolve(canvas.toDataURL('image/jpeg'));
            } catch(e) { resolve(null); }
        };
        img.onerror = () => resolve(null);
        img.src = src;
    });
}

