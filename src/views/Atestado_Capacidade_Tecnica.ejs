                yPos += 10;
                doc.setFontSize(12);
                doc.text('Instrumentos de Parceria Anteriores (quando houver): Não foram fornecidos.', margin, yPos);
            } else {
                for (const i of annexOrder) {
                    yPos = addNewPdfPage(true);
                    yPos += 30;
                    doc.setFontSize(18);
                    doc.setTextColor(0, 0, 255);
                    doc.text('ANEXO', pageWidth / 2, yPos, { align: 'center' });
                    doc.setTextColor(0, 0, 0);
                    yPos += 15;
                    doc.setFontSize(14);
                    doc.text('HISTÓRICO', margin, yPos);
                    yPos += 10;
                    doc.setFontSize(12);

                    const nomeProjeto = document.getElementById(`nomeProjeto-${i}`)?.value || 'Não informado';
                    const tipoParceriaAnterior = document.getElementById(`tipoParceriaAnterior-${i}`)?.options[document.getElementById(`tipoParceriaAnterior-${i}`).selectedIndex].text || 'Não informado';
                    const nrAnoAnterior = document.getElementById(`nrAnoAnterior-${i}`)?.value || 'Não informado';
                    const orgaoAnterior = document.getElementById(`orgaoAnterior-${i}`)?.value || 'Não informado';
                    const entidadesParceiras = document.getElementById(`entidadesParceiras-${i}`)?.value || 'Não informado';
                    const numeroBeneficiados = document.getElementById(`numeroBeneficiados-${i}`)?.value || 'Não informado';
                    const atividadesDesenvolvidas = document.getElementById(`atividadesDesenvolvidas-${i}`)?.value || 'Não informado';
                    const dataInicio = formatDateToBrazilian(document.getElementById(`dataInicio-${i}`)?.value);
                    const dataTermino = formatDateToBrazilian(document.getElementById(`dataTermino-${i}`)?.value);
                    const estruturasFisicas = document.getElementById(`estruturasFisicas-${i}`)?.value || 'Não informado';
                    const qualificacaoPessoal = document.getElementById(`qualificacaoPessoal-${i}`)?.value || 'Não informado';

                    const addTextSection = (label, value) => {
                        if (!value || value.trim() === '') return;
                        const labelHeight = 6;
                        const valueLines = doc.splitTextToSize(value, pageWidth - margin * 2 - 5);
                        const valueHeight = valueLines.length * 5;

                        if (yPos + labelHeight + valueHeight > pageHeight - margin) {
                            yPos = addNewPdfPage(true);
                            yPos += 30;
                            doc.setFontSize(14);
                            doc.text('HISTÓRICO', margin, yPos);
                            yPos += 10;
                            doc.setFontSize(12);
                        }

                        doc.setFont('helvetica', 'bold');
                        doc.text(label, margin, yPos);
                        yPos += labelHeight;

                        doc.setFont('helvetica', 'normal');
                        doc.text(valueLines, margin + 5, yPos);
                        yPos += valueHeight + 5;
                    };

                    addTextSection('Nome do Projeto/Ação:', nomeProjeto);
                    if (tipoParceriaAnterior !== 'Nenhum / Não se aplica') {
                        addTextSection('Tipo de Parceria Anterior:', tipoParceriaAnterior);
                        addTextSection('Nº / Ano (Anterior):', nrAnoAnterior);
                        addTextSection('Órgão/Entidade Parceira Anterior:', orgaoAnterior);
                    } else {
                        addTextSection('Instrumentos de Parceria Anteriores (quando houver):', 'Não foram fornecidos.');
                    }
                    addTextSection('Entidades Parceiras:', entidadesParceiras);
                    addTextSection('Número de Beneficiados:', numeroBeneficiados);
                    addTextSection('Data de Início:', dataInicio);
                    addTextSection('Data de Término:', dataTermino);
                    addTextSection('Ações/Atividades Desenvolvidas:', atividadesDesenvolvidas);

                    const tipoAtestadoValue = document.getElementById('tipoAtestado').value;
                    if (tipoAtestadoValue === 'termoFomento') {
                        addTextSection('Estruturas Físicas:', estruturasFisicas);
                        addTextSection('Qualificação Profissional:', qualificacaoPessoal);
                    }

                    // Renderização de arquivos
                    yPos = addNewPdfPage(true);
                    yPos += 30;
                    doc.setFontSize(12);
                    doc.text('- Documentos Comprobatórios:', margin, yPos);
                    yPos += 10;

                    let filesToRenderInPDF = [];
                    const evidenceTypes = ['fotos', 'materiais', 'midia', 'instrumentos'];
                    for (const type of evidenceTypes) {
                        const inputs = document.querySelectorAll(`input[id^="${type}-${i}-"]`);
                        inputs.forEach(input => {
                            if (input.files) {
                                Array.from(input.files).forEach(file => filesToRenderInPDF.push({ file }));
                            }
                        });
                    }

                    for (const { file } of filesToRenderInPDF) {
                        if (file.type.startsWith('image/')) {
                            const reader = new FileReader();
                            const imgData = await new Promise((resolve) => {
                                reader.onload = () => resolve(reader.result);
                                reader.readAsDataURL(file);
                            });
                            const img = new Image();
                            img.src = imgData;
                            await new Promise((resolve) => { img.onload = resolve; });

                            const maxWidth = pageWidth - 2 * margin;
                            const maxHeight = pageHeight - (margin * 2) - 40;
                            const ratio = Math.min(maxWidth / img.width, maxHeight / img.height);
                            const finalHeight = img.height * ratio;
                            const finalWidth = img.width * ratio;
                            const captionHeight = 15;

                            if (yPos + finalHeight + captionHeight > pageHeight - margin) {
                                yPos = addNewPdfPage(true);
                                yPos += 30;
                                doc.setFontSize(12);
                                doc.text('- Documentos Comprobatórios (continuação):', margin, yPos);
                                yPos += 10;
                            }

                            doc.addImage(imgData, file.type.split('/')[1].toUpperCase(), (pageWidth - finalWidth) / 2, yPos, finalWidth, finalHeight);
                            yPos += finalHeight + 5;
                            doc.setFontSize(9);
                            doc.setTextColor(100, 100, 100);
                            doc.text(`Arquivo: ${file.name}`, pageWidth / 2, yPos, { align: 'center' });
                            doc.setTextColor(0, 0, 0);
                            yPos += 10;
                            doc.setFontSize(12);

                        } else if (file.type === 'application/pdf') {
                            const pdfBytes = await file.arrayBuffer();
                            const pdf = await pdfjsLib.getDocument({ data: pdfBytes }).promise;

                            for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
                                yPos = addNewPdfPage(true);
                                yPos += 25;

                                doc.setFontSize(10);
                                doc.setTextColor(100, 100, 100);
                                doc.text(`Documento Anexo: ${file.name} (Pág. ${pageNum}/${pdf.numPages})`, margin, yPos);
                                yPos += 5;

                                const page = await pdf.getPage(pageNum);
                                const highResScale = 2.0;
                                const viewport = page.getViewport({ scale: highResScale });

                                const canvas = document.createElement('canvas');
                                canvas.height = viewport.height;
                                canvas.width = viewport.width;
                                const context = canvas.getContext('2d');

                                await page.render({ canvasContext: context, viewport }).promise;

                                const imgData = canvas.toDataURL('image/jpeg', 0.9);

                                const maxWidth = pageWidth - (2 * margin);
                                const maxHeight = pageHeight - yPos - margin;
                                const scaleRatio = Math.min(maxWidth / viewport.width, maxHeight / viewport.height);

                                const finalWidth = viewport.width * scaleRatio;
                                const finalHeight = viewport.height * scaleRatio;
                                const xCentered = (pageWidth - finalWidth) / 2;

                                doc.addImage(imgData, 'JPEG', xCentered, yPos, finalWidth, finalHeight, undefined, 'FAST');

                                canvas.width = 0;
                                canvas.height = 0;
                                yPos += finalHeight + 10;
                            }
                        }
                    }
                }
            }

            const pdfName = `Atestado_Capacidade_Tecnica_${nomeEntidade.replace(/\s+/g, '_')}.pdf`;
            doc.save(pdfName);
            alert('PDF gerado com sucesso!');

        } catch (error) {
            console.error("Erro na geração do PDF:", error);
            alert('Erro ao gerar o PDF. Verifique o console para detalhes.');
        } finally {
            document.getElementById('loadingOverlay').style.display = 'none';
        }
    }
</script>
</script>
</body>
</html>