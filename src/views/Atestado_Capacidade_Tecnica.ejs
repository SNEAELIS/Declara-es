// ------------------------------------------------
// 12. Validação do arquivo único (Convênio - adendo)
// ------------------------------------------------
function validateSingleFile(input) {
    const file = input.files[0];
    if (!file) return;
    const validTypes = ['image/png', 'image/jpeg', 'application/pdf'];
    if (!validTypes.includes(file.type)) {
        alert('Apenas arquivos PNG, JPEG ou PDF são permitidos para o adendo.');
        input.value = '';
        return;
    }
    const maxSize = file.type === 'application/pdf' ? 10 * 1024 * 1024 : 5 * 1024 * 1024;
    if (file.size > maxSize) {
        alert(`O arquivo excede o tamanho máximo permitido (${file.type === 'application/pdf' ? '10 MB' : '5 MB'}).`);
        input.value = '';
    }
}

// ------------------------------------------------
// 13. Funções auxiliares
// ------------------------------------------------
async function getBase64ImageFromUrl(url) {
    try {
        const response = await fetch(url);
        if (!response.ok) throw new Error('Falha ao carregar imagem');
        const blob = await response.blob();
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onloadend = () => resolve(reader.result);
            reader.onerror = reject;
            reader.readAsDataURL(blob);
        });
    } catch (err) {
        console.error("Erro ao carregar imagem de marca d'água:", err);
        return null;
    }
}

function validateLettersOnly(input) {
    input.value = input.value.replace(/[^a-zA-Z\sÀ-ú]/g, '');
}

function addMoreFiles(type, annexId) {
    const container = document.getElementById(`${type}-${annexId}-container`);
    const fileInputs = container.querySelectorAll('input[type="file"]');
    if (fileInputs.length >= 5) {
        alert('Limite de 5 campos de upload por seção atingido.');
        return;
    }
    const newIndex = fileInputs.length + 1;
    const wrapper = document.createElement('div');
    wrapper.classList.add('file-input-wrapper');
    wrapper.id = `wrapper-${type}-${annexId}-${newIndex}`;
    const newInput = document.createElement('input');
    newInput.type = 'file';
    newInput.id = `${type}-${annexId}-${newIndex}`;
    newInput.accept = 'image/png,image/jpeg,application/pdf';
    newInput.multiple = true;
    newInput.onchange = (e) => validateMixedFiles(e.target);
    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.classList.add('remove-btn');
    removeBtn.textContent = 'Remover';
    removeBtn.onclick = () => wrapper.remove();
    wrapper.appendChild(newInput);
    wrapper.appendChild(removeBtn);
    const addBtn = container.querySelector('.add-btn');
    container.insertBefore(wrapper, addBtn);
}

function validateMixedFiles(input) {
    const files = input.files;
    if (files.length > 5) {
        alert('Máximo de 5 arquivos por vez.');
        input.value = '';
        return;
    }
    for (const file of files) {
        const isImage = file.type === 'image/png' || file.type === 'image/jpeg';
        const isPdf = file.type === 'application/pdf';
        if (!isImage && !isPdf) {
            alert('Apenas PNG, JPEG e PDF são permitidos.');
            input.value = '';
            return;
        }
        if (isImage && file.size > 5 * 1024 * 1024) {
            alert(`Imagem "${file.name}" excede 5 MB.`);
            input.value = '';
            return;
        }
        if (isPdf && file.size > 10 * 1024 * 1024) {
            alert(`PDF "${file.name}" excede 10 MB.`);
            input.value = '';
            return;
        }
    }
}

// ------------------------------------------------
// 14. Consulta CNPJ → BrasilAPI
// ------------------------------------------------
async function fetchEntityData() {
    const cnpjInput = document.getElementById('cnpj');
    const nomeEntidade = document.getElementById('nomeEntidade');
    const cepInput = document.getElementById('cep');
    const tipoAtestado = document.getElementById('tipoAtestado');
    const avisoEntePublico = document.getElementById('avisoEntePublico');
    let cnpj = cnpjInput.value.replace(/\D/g, '');
    if (cnpj.length !== 14) {
        avisoEntePublico.style.display = 'none';
        return;
    }
    nomeEntidade.value = 'Buscando dados...';
    try {
        const response = await fetch(`https://brasilapi.com.br/api/cnpj/v1/${cnpj}`);
        if (!response.ok) throw new Error('Erro na consulta');
        const data = await response.json();
        nomeEntidade.value = data.razao_social || 'Não encontrado';
        cepInput.value = data.cep || '';
        const removeAccents = (str) => str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toUpperCase();
        const razaoUpper = removeAccents(data.razao_social || '');
        const isEntePublico =
            ['2011','2038','2046','2062','2089','2100','2119','2135'].includes(data.natureza_juridica) ||
            razaoUpper.includes('PREFEITURA') ||
            razaoUpper.includes('MUNICIPIO') ||
            razaoUpper.includes('MUNICIPIO DE') ||
            razaoUpper.includes('ESTADO DE') ||
            razaoUpper.includes('GOVERNO DO DISTRITO FEDERAL') ||
            razaoUpper.includes('GOVERNO DO ESTADO') ||
            razaoUpper.includes('DISTRITO FEDERAL');
        if (isEntePublico && tipoAtestado.value === 'termoFomento') {
            alert('Atenção: Termo de Fomento é exclusivo para OSCs (entidades privadas sem fins lucrativos).\n\n' +
                  'CNPJs de Municípios, Estados ou Distrito Federal NÃO podem usar Termo de Fomento.\n' +
                  'Alterando automaticamente para Convênio.');
            tipoAtestado.value = 'convenio';
            toggleFormFields();
        }
        avisoEntePublico.style.display = isEntePublico ? 'block' : 'none';
        if (data.cep) await fetchAddressData();
    } catch (err) {
        alert(`Erro ao consultar CNPJ: ${err.message}`);
        nomeEntidade.value = '';
        avisoEntePublico.style.display = 'none';
    }
    if (isEntePublico) {
        document.querySelector('option[value="termoFomento"]').disabled = true;
        if (tipoAtestado.value === 'termoFomento') {
            tipoAtestado.value = 'convenio';
            toggleFormFields();
        }
    } else {
        document.querySelector('option[value="termoFomento"]').disabled = false;
    }
}

// ------------------------------------------------
// 15. Consulta CEP → BrasilAPI
// ------------------------------------------------
async function fetchAddressData() {
    const cepInput = document.getElementById('cep');
    const enderecoInput = document.getElementById('endereco');
    let cep = cepInput.value.replace(/\D/g, '');
    if (cep.length !== 8) {
        enderecoInput.value = '';
        return;
    }
    enderecoInput.value = 'Buscando endereço...';
    try {
        const response = await fetch(`https://brasilapi.com.br/api/cep/v1/${cep}`);
        if (!response.ok) throw new Error('Erro na consulta');
        const data = await response.json();
        enderecoInput.value = `${data.street || ''}, ${data.neighborhood || ''}, ${data.city || ''} - ${data.state || ''}`;
        document.getElementById('numero').focus();
    } catch (err) {
        alert(`Erro ao consultar CEP: ${err.message}`);
        enderecoInput.value = '';
    }
}

// ------------------------------------------------
// 16. Formata data para dd/mm/yyyy
// ------------------------------------------------
function formatDateToBrazilian(dateStr) {
    if (!dateStr) return '';
    const [year, month, day] = dateStr.split('-');
    return `${day.padStart(2, '0')}/${month.padStart(2, '0')}/${year}`;
}

