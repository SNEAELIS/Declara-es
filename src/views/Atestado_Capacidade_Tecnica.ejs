// Função para controlar a exclusividade dos Elementos Complementares
function configurarLogicaCheckboxes() {
    const checkboxesComuns = document.querySelectorAll('input[name="elementosComplementares"]:not(#nenhumElementos)');
    const checkboxNenhum = document.getElementById('nenhumElementos');

    // Lógica para quando clicar em "Não possuo nenhum"
    checkboxNenhum.addEventListener('change', function() {
        if (this.checked) {
            checkboxesComuns.forEach(cb => {
                cb.checked = false;    // Desmarca todos os outros
                cb.disabled = true;   // Desabilita todos os outros
            });
        } else {
            checkboxesComuns.forEach(cb => {
                cb.disabled = false;  // Habilita novamente se desmarcar o "Nenhum"
            });
        }
    });

    // Lógica para quando clicar em qualquer um dos outros
    checkboxesComuns.forEach(cb => {
        cb.addEventListener('change', function() {
            // Se algum comum estiver marcado, o "Nenhum" deve ser desabilitado
            const algumMarcado = Array.from(checkboxesComuns).some(c => c.checked);
            if (algumMarcado) {
                checkboxNenhum.checked = false;
                checkboxNenhum.disabled = true;
            } else {
                checkboxNenhum.disabled = false;
            }
        });
    });
}
function restaurarEstadoAcoesEstado() {
    const radioSim = document.querySelector('input[name="acoesNoEstado"][value="sim"]');
    const detalhesDiv = document.getElementById('detalhesAcoesEstado');

