        orgaoFields.style.display = 'none';
    } else {
        fields.style.display = 'block';
        orgaoFields.style.display = 'block';
    }
}

function removeAnnex(id, event) {
    event.stopPropagation();
    const annexToRemove = document.getElementById(`annex-accordion-${id}`);
    if (annexToRemove) {
        annexToRemove.remove();
        const index = annexOrder.indexOf(id);
        if (index > -1) {
            annexOrder.splice(index, 1);
        }
        delete fileCounters[id];
    }
}

// Validação do arquivo único opcional do Convênio (adendo)
function validateSingleFile(input) {
    const file = input.files[0];
    if (!file) return; // ok, campo opcional

    const validTypes = ['image/png', 'image/jpeg', 'application/pdf'];
    if (!validTypes.includes(file.type)) {
        alert('Apenas arquivos PNG, JPEG ou PDF são permitidos para o adendo.');
        input.value = '';
        return;
    }

    const maxSize = file.type === 'application/pdf' ? 10 * 1024 * 1024 : 5 * 1024 * 1024;
    if (file.size > maxSize) {
        alert(`O arquivo excede o tamanho máximo permitido (${file.type === 'application/pdf' ? '10 MB' : '5 MB'}).`);
        input.value = '';
        return;
    }
}

