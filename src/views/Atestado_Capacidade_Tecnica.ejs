    function updateAnnexFields() {
        document.getElementById('annexAccordionContainer').innerHTML = '';
        annexCount = 0;
        fileCounters = {};
        annexOrder = [];
    }

    function setupAccordionListener() {
        const container = document.getElementById('annexAccordionContainer');
        container.addEventListener('click', function(event) {
            const header = event.target.closest('.annex-accordion-header');
            if (!header || event.target.classList.contains('remove-annex-section-btn')) return;
            header.classList.toggle('active');
            const panel = header.nextElementSibling;
            panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
        });
    }

