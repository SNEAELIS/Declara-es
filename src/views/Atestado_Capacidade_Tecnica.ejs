    if (radioSim.checked) {
        detalhesDiv.style.display = 'block';
    } else {
        detalhesDiv.style.display = 'none';
    }
}

// ================================================
// 17. GERAÇÃO DO PDF - FUNÇÃO PRINCIPAL
// Versão expandida, organizada e comentada - Fevereiro 2026
// ================================================
async function generatePDF() {
    // ────────────────────────────────────────────────
    // Preparação inicial e coleta do tipo de atestado
    // ────────────────────────────────────────────────
    const tipoSelect = document.getElementById('tipoAtestado');
    const tipo = tipoSelect?.value;

    if (!tipo) {
        alert('Selecione o Tipo de Atestado (Termo de Fomento ou Convênio) antes de gerar o PDF.');
        tipoSelect?.focus?.();
        return;
    }

    const isTermoFomento = tipo === 'termoFomento';
    const isConvenio     = tipo === 'convenio';

    // ────────────────────────────────────────────────
    // 1. VALIDAÇÃO ESPECIAL: Termo de Fomento NÃO pode ser usado por ente público
    // ────────────────────────────────────────────────
    if (isTermoFomento) {
        const cnpjInput = document.getElementById('cnpj');
        const cnpjValor = cnpjInput?.value?.replace(/\D/g, '') || '';

        if (cnpjValor.length === 14) {
            try {
                const response = await fetch(`https://brasilapi.com.br/api/cnpj/v1/${cnpjValor}`);
                if (response.ok) {
                    const data = await response.json();
                    const razao = (data.razao_social || '').normalize("NFD").replace(/[\u0300-\u036f]/g, "").toUpperCase();

                    const naturezasPublicas = ['2011','2038','2046','2062','2089','2100','2119','2135'];
                    const isEntePublico =
                        naturezasPublicas.includes(data.natureza_juridica) ||
                        razao.includes('PREFEITURA') ||
                        razao.includes('MUNICIPIO') ||
                        razao.includes('MUNICIPIO DE') ||
                        razao.includes('ESTADO DE') ||
                        razao.includes('GOVERNO DO DISTRITO FEDERAL') ||
                        razao.includes('GOVERNO DO ESTADO') ||
                        razao.includes('DISTRITO FEDERAL');

                    if (isEntePublico) {
                        alert(
                            'ERRO: Termo de Fomento NÃO pode ser utilizado por entes públicos ' +
                            '(Municípios, Estados, Distrito Federal).\n\n' +
                            'Este CNPJ parece pertencer a um ente público.\n' +
                            'O tipo de atestado será alterado automaticamente para Convênio.'
                        );
                        tipoSelect.value = 'convenio';
                        toggleFormFields();
                        document.getElementById('avisoEntePublico').style.display = 'block';
                        return;
                    }
                }
            } catch (err) {
                console.warn('Não foi possível validar se o CNPJ é ente público:', err);
                // Não interrompe o fluxo, apenas avisa no console
            }
        }
    }

    // ────────────────────────────────────────────────
    // 2. VALIDAÇÕES GERAIS (campos que sempre são obrigatórios)
    // ────────────────────────────────────────────────
    const camposObrigatorios = [
        { id: 'nomeDirigente',    msg: 'Nome do Dirigente / Prefeito é obrigatório.' },
        { id: 'cnpj',             msg: 'CNPJ da entidade é obrigatório.' },
        { id: 'nomeEntidade',     msg: 'Nome da entidade não foi preenchido (verifique o CNPJ).' },
        { id: 'cep',              msg: 'CEP é obrigatório.' },
        { id: 'endereco',         msg: 'Endereço é obrigatório.' },
        { id: 'numero',           msg: 'Número do endereço é obrigatório.' },
        { id: 'numeroProposta',   msg: 'Número da Proposta Atual é obrigatório.' }
    ];

    for (const campo of camposObrigatorios) {
        const elemento = document.getElementById(campo.id);
        if (!elemento?.value?.trim()) {
            alert(campo.msg);
            elemento?.focus?.();
            return;
        }
    }

    // ────────────────────────────────────────────────
    // 3. VALIDAÇÕES ESPECÍFICAS POR TIPO DE ATESTADO
    // ────────────────────────────────────────────────
    if (isConvenio) {
        const matriculaEl = document.getElementById('matriculaFuncional');
        if (!matriculaEl?.value?.trim()) {
            alert('A Matrícula Funcional do Prefeito é obrigatória para Convênio.');
            matriculaEl?.focus?.();
            return;
        }
    }

    if (isTermoFomento) {
        // Campos do dirigente
        if (!document.getElementById('cargoDirigente')?.value?.trim()) {
            alert('O Cargo do Dirigente é obrigatório para Termo de Fomento.');
            return;
        }

        // Declarações obrigatórias
        if (!document.getElementById('capacidadeNaoConfunde')?.checked) {
            alert('É necessário marcar que "a capacidade técnica já instalada não se confunde".');
            return;
        }
        if (!document.getElementById('declaracaoEspecificacoes')?.checked) {
            alert('É necessário declarar o cumprimento das 3 especificações obrigatórias.');
            return;
        }

        // Rádios de abrangência e ações no estado
        if (!document.querySelector('input[name="acoesNoEstado"]:checked')) {
            alert('Informe se a OSC já realizou ações/parcerias no estado alcançado pela emenda.');
            return;
        }
        if (!document.querySelector('input[name="abrangenciaNacional"]:checked')) {
            alert('Informe se a entidade possui abrangência nacional no estatuto social.');
            return;
        }

        // Detalhamento obrigatório quando "Sim" nas ações no estado
        const acoesNoEstadoSim = document.querySelector('input[name="acoesNoEstado"][value="sim"]')?.checked;
        if (acoesNoEstadoSim) {
            const camposDetalhados = [
                { id: 'nomeProjetoAcao',          label: 'Nome do Projeto/Ação' },
                { id: 'tipoParceria',             label: 'Tipo de Parceria' },
                { id: 'anoAcao',                  label: 'Nº/Ano da parceria' },
                { id: 'orgaoParceiro',            label: 'Órgão / Entidade Parceira' },
                { id: 'numeroBeneficiarios',      label: 'Número de Beneficiários' },
                { id: 'atividadesRealizadas',     label: 'Atividades Realizadas' },
                { id: 'dataInicioAcao',           label: 'Data de Início' },
                { id: 'dataFimAcao',              label: 'Data de Fim' },
                { id: 'estrutura',                label: 'Estrutura Utilizada' },
                { id: 'qualificacaoProfissional', label: 'Qualificação Profissional da Equipe' }
            ];

            for (const campo of camposDetalhados) {
                const el = document.getElementById(campo.id);
                if (!el?.value?.trim()) {
                    alert(`Campo obrigatório não preenchido: "${campo.label}" (detalhamento de ações no estado)`);
                    el?.focus?.();
                    return;
                }
            }

            // Validação extra de formato do campo Nº/Ano
            const anoAcaoValor = document.getElementById('anoAcao')?.value?.trim() || '';
            if (anoAcaoValor && !/^\d{1,6}\/\d{4}$/.test(anoAcaoValor)) {
                if (!confirm(`O campo "Nº/Ano" (${anoAcaoValor}) não segue o formato recomendado (ex: 004947/2024).\n\nDeseja continuar mesmo assim?`)) {
                    document.getElementById('anoAcao')?.focus?.();
                    return;
                }
            }
        }

        // ────────────────────────────────────────────────
        // Validação de comprovação documental (Termo de Fomento)
        // ────────────────────────────────────────────────
        const nenhumElementosMarcado = document.getElementById('nenhumElementos')?.checked || false;
        const qtdElementosComplementares = document.querySelectorAll('input[name="elementosComplementares"]:checked:not(#nenhumElementos)').length;

        // Se marcou elementos complementares → deve ter pelo menos 1 bloco de anexo
        if (qtdElementosComplementares > 0 && annexOrder.length === 0) {
            alert(
                'Você marcou itens em "Elementos Complementares de Comprovação da Capacidade Técnica",\n' +
                'mas não adicionou nenhum bloco de histórico/anexo.\n\n' +
                'Adicione pelo menos um bloco de anexo para comprovar a capacidade.'
            );
            return;
        }

        // Verifica se todos os campos de upload dinâmicos (comprovação) têm pelo menos 1 arquivo
        const uploadsObrigatorios = document.querySelectorAll('#dynamicUploadFields input[type="file"][required]');
        for (const input of uploadsObrigatorios) {
            if (input.files.length === 0) {
                const labelTexto = input.closest('.input-container')
                    ?.querySelector('label')
                    ?.textContent
                    ?.replace('*', '')
                    ?.trim() || 'este campo de upload';

                alert(
                    `Você selecionou um tipo de comprovação que exige arquivo,\n` +
                    `mas nenhum arquivo foi anexado para:\n\n"${labelTexto}"\n\n` +
                    `Por favor, selecione pelo menos um arquivo.`
                );
                input.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }
        }

        // Verifica uploads nos anexos para elementos complementares
        for (const annexId of annexOrder) {
            const anexoUploads = document.querySelectorAll(`#uploadsAnexo-${annexId} input[type="file"][required]`);
            for (const input of anexoUploads) {
                if (input.files.length === 0) {
                    const labelTexto = input.closest('.input-container')
                        ?.querySelector('label')
                        ?.textContent
                        ?.replace('*', '')
                        ?.trim() || 'este campo de upload no anexo';

                    alert(
                        `No Anexo ${annexId}, você selecionou um item de elemento complementar que exige arquivo,\n` +
                        `mas nenhum arquivo foi anexado para:\n\n"${labelTexto}"\n\n` +
                        `Por favor, selecione pelo menos um arquivo.`
                    );
                    input.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return;
                }
            }
        }
    }

    // ────────────────────────────────────────────────
    // INÍCIO DA GERAÇÃO DO DOCUMENTO PDF
    // ────────────────────────────────────────────────
    document.getElementById('loadingOverlay').style.display = 'flex';

    try {
        const { jsPDF } = window.jspdf;
        if (!jsPDF) throw new Error('Biblioteca jsPDF não foi carregada corretamente.');

        const doc = new jsPDF({
            orientation: 'portrait',
            unit: 'mm',
            format: 'a4'
        });

        // Configurações gerais do documento
        const pageWidth = 210;
        const pageHeight = 297;
        const margin = 20;
        let yPos = margin;

        // ──────── Marca d'água ────────
        const watermarkUrl = 'https://i.ibb.co/Lz10svWs/Declara-es-page-0001.jpg';
        let watermarkBase64 = null;
        try {
            watermarkBase64 = await getBase64ImageFromUrl(watermarkUrl);
        } catch (e) {
            console.warn("Não foi possível carregar a marca d'água:", e);
        }

        const addWatermark = () => {
            if (watermarkBase64) {
                try {
                    doc.addImage(watermarkBase64, 'JPEG', 0, 0, pageWidth, pageHeight, null, 'FAST', 0, 0.18);
                } catch (e) {
                    console.warn('Erro ao aplicar marca d\'água na página:', e);
                }
            }
        };

        const newPage = (withWatermark = true) => {
            doc.addPage();
            if (withWatermark) addWatermark();
            return margin + 20;     // 20 mm = bom equilíbrio (era 65 mm!)
        };

        // Aplica marca d'água na primeira página
        addWatermark();

        // ────────────────────────────────────────────────
        // Cabeçalho principal do atestado
        // ────────────────────────────────────────────────
        doc.setFontSize(18);
        doc.setFont("helvetica", "bold");
        doc.setTextColor(0, 51, 102); // azul escuro
        doc.text("ATESTADO DE CAPACIDADE TÉCNICA", pageWidth / 2, yPos + 25, { align: "center" });
        yPos += 45;

        doc.setFontSize(12);
        doc.setFont("helvetica", "normal");
        doc.setTextColor(0);

        // Coleta todos os dados básicos do formulário
        const nomeDirigente = document.getElementById('nomeDirigente')?.value.trim() || "________________________________";
        const cargoDirigente = isTermoFomento ? (document.getElementById('cargoDirigente')?.value.trim() || "________________________________") : "Prefeito";
        const matricula = isConvenio ? (document.getElementById('matriculaFuncional')?.value.trim() || "Não informada") : "";
        const nomeEntidade = document.getElementById('nomeEntidade')?.value.trim() || "_______________________________________________";
        const cnpj = document.getElementById('cnpj')?.value.trim() || "__.___.___/____-__";
        const endereco = document.getElementById('endereco')?.value.trim() || "";
        const numeroEndereco = document.getElementById('numero')?.value.trim() || "";
        const complemento = document.getElementById('complemento')?.value.trim() || "";
        const cep = document.getElementById('cep')?.value.trim() || "";
        const enderecoCompleto = [endereco, numeroEndereco, complemento].filter(Boolean).join(", ") + (cep ? `, CEP ${cep}` : "");
        const proposta = document.getElementById('numeroProposta')?.value.trim() || "___________";

        let signatario = nomeDirigente;
        if (isTermoFomento && cargoDirigente) signatario += `, ${cargoDirigente}`;
        if (isConvenio && matricula) signatario += ` (Matrícula funcional: ${matricula})`;

        const fundamentacao = isConvenio
            ? "em atendimento ao art. 5º, da PORTARIA CONJUNTA MGI/MF/CGU Nº 33, DE 30 DE AGOSTO DE 2023."
            : "em atendimento ao art. 33, inciso V, da Lei nº 13.019/2014 e art. 26, inciso III, do Decreto nº 8.726/2016.";

        const textoIntroducao =
            `Eu, ${signatario}, ATESTO, para fins de formalização de ${tipoSelect.options[tipoSelect.selectedIndex].text} ` +
            `no âmbito do Ministério do Esporte - MESP, que a entidade ${nomeEntidade}, ` +
            `inscrita no CNPJ sob o nº ${cnpj}, situada no ${enderecoCompleto}, ` +
            `possui capacidade técnica e operacional para executar o objeto apresentado na Proposta nº ${proposta}, ` +
            `${fundamentacao}, considerando as experiências adquiridas na(s) execução de projeto(s)/ação(es) ` +
            `na(s) área(s) esportivo/educacional/social, devidamente especificada(s) no Histórico anexo(s).`;

        const linhasIntro = doc.splitTextToSize(textoIntroducao, pageWidth - margin * 2);
        doc.text(linhasIntro, margin, yPos);
        yPos += linhasIntro.length * 7 + 12;

        doc.text("Declaração emitida com base nas comprovações anexas.", margin, yPos);
        yPos += 30;

