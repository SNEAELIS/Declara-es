        // ────────────────────────────────────────────────
        // SEÇÃO DE COMPROVAÇÃO PRINCIPAL (Comprovação Institucional, Técnica, Operacional e Material - sempre incluída se houver arquivos)
        // Esta seção agora é independente dos anexos, para renderizar imagens, PDFs e outros arquivos mesmo sem anexos complementares.
        // Suporte para MP4 e áudio: como PDF não suporta embed de vídeo/áudio nativamente, exibe apenas nome e mensagem de placeholder.
        // ────────────────────────────────────────────────
        if (isTermoFomento) {
            let arquivosComprovacao = [];
            document.querySelectorAll('#dynamicUploadFields input[type="file"]').forEach(input => {
                if (input.files && input.files.length > 0) {
                    const label = input.closest('.input-container')?.querySelector('label')?.textContent?.trim() || 'Comprovação';
                    Array.from(input.files).forEach(file => {
                        arquivosComprovacao.push({ file, tipo: label });
                    });
                }
            });

            if (arquivosComprovacao.length > 0) {
                yPos = newPage(true);
                yPos += 15;

                doc.setFontSize(18);
                doc.setTextColor(0, 0, 180);
                doc.text("DOCUMENTOS COMPROBATÓRIOS PRINCIPAIS", pageWidth / 2, yPos, { align: "center" });
                doc.setTextColor(0);
                yPos += 12;

                doc.setFontSize(13);
                doc.text("Comprovação Institucional, Técnica, Operacional e Material", margin, yPos);
                yPos += 10;

                for (const { file, tipo } of arquivosComprovacao) {
                    if (yPos > pageHeight - 90) {
                        yPos = newPage(true);
                        yPos += 25;
                    }

                    doc.setFontSize(10);
                    doc.setTextColor(80);
                    doc.text(`Tipo: ${tipo} | Arquivo: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`, margin, yPos);
                    yPos += 6;

                    if (file.type.startsWith('image/')) {
                        try {
                            const dataUrl = await new Promise((res, rej) => {
                                const reader = new FileReader();
                                reader.onload = () => res(reader.result);
                                reader.onerror = rej;
                                reader.readAsDataURL(file);
                            });

                            const img = new Image();
                            await new Promise((res, rej) => {
                                img.onload = res;
                                img.onerror = rej;
                                img.src = dataUrl;
                            });

                            let largura = pageWidth - margin * 2;
                            let altura = (img.height / img.width) * largura;
                            const maxAlt = pageHeight - yPos - margin - 20;

                            if (altura > maxAlt) {
                                altura = maxAlt;
                                largura = (img.width / img.height) * altura;
                            }

                            doc.addImage(dataUrl, file.type.split('/')[1].toUpperCase(), margin, yPos, largura, altura);
                            yPos += altura + 12;
                        } catch (e) {
                            console.warn(`Erro ao inserir imagem da comprovação principal: ${file.name}`, e);
                            doc.setTextColor(180, 0, 0);
                            doc.text("[Erro ao exibir imagem]", margin + 5, yPos);
                            yPos += 10;
                        }
                    } else if (file.type === 'application/pdf') {
                        try {
                            const arrayBuffer = await file.arrayBuffer();
                            const pdfDoc = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;

                            for (let pg = 1; pg <= pdfDoc.numPages; pg++) {
                                if (yPos > pageHeight - 100) {
                                    yPos = newPage(true);
                                    yPos += 20;
                                }

                                doc.setFontSize(10);
                                doc.setTextColor(80);
                                doc.text(`Página ${pg} de ${pdfDoc.numPages} – ${file.name}`, margin, yPos);
                                yPos += 7;

                                const pagina = await pdfDoc.getPage(pg);
                                const escala = 1.8;
                                const viewport = pagina.getViewport({ scale: escala });

                                const canvas = document.createElement('canvas');
                                canvas.width = viewport.width;
                                canvas.height = viewport.height;
                                const ctx = canvas.getContext('2d');

                                await pagina.render({ canvasContext: ctx, viewport }).promise;

                                const imgData = canvas.toDataURL('image/jpeg', 0.88);

                                let w = pageWidth - margin * 2;
                                let h = (viewport.height / viewport.width) * w;
                                const maxH = pageHeight - yPos - margin - 15;

                                if (h > maxH) {
                                    h = maxH;
                                    w = (viewport.width / viewport.height) * h;
                                }

                                doc.addImage(imgData, 'JPEG', margin, yPos, w, h);
                                yPos += h + 12;

                                canvas.width = canvas.height = 0; // libera memória
                            }
                        } catch (e) {
                            console.warn(`Erro ao renderizar PDF da comprovação principal: ${file.name}`, e);
                            doc.setTextColor(180, 0, 0);
                            doc.text("[Não foi possível exibir o conteúdo do PDF]", margin + 5, yPos);
                            yPos += 12;
                        }
                    } else if (file.type.startsWith('video/') || file.type.startsWith('audio/')) {
