                                    doc.setFontSize(10);
                                    doc.setTextColor(80);
                                    doc.text(`Página ${pg} de ${pdfDoc.numPages} – ${file.name}`, margin, yPos);
                                    yPos += 7;

                                    const pagina = await pdfDoc.getPage(pg);
                                    const escala = 1.8;
                                    const viewport = pagina.getViewport({ scale: escala });

                                    const canvas = document.createElement('canvas');
                                    canvas.width = viewport.width;
                                    canvas.height = viewport.height;
                                    const ctx = canvas.getContext('2d');

                                    await pagina.render({ canvasContext: ctx, viewport }).promise;

                                    const imgData = canvas.toDataURL('image/jpeg', 0.88);

                                    let w = pageWidth - margin * 2;
                                    let h = (viewport.height / viewport.width) * w;
                                    const maxH = pageHeight - yPos - margin - 15;

                                    if (h > maxH) {
                                        h = maxH;
                                        w = (viewport.width / viewport.height) * h;
                                    }

                                    doc.addImage(imgData, 'JPEG', margin, yPos, w, h);
                                    yPos += h + 12;

                                    canvas.width = canvas.height = 0; // libera memória
                                }
                            } catch (e) {
                                console.warn(`Erro ao renderizar PDF do anexo ${annexId}: ${file.name}`, e);
                                doc.setTextColor(180, 0, 0);
                                doc.text("[Não foi possível exibir o conteúdo do PDF]", margin + 5, yPos);
                                yPos += 12;
                            }
                        } else if (file.type.startsWith('video/') || file.type.startsWith('audio/')) {
                            // Para MP4 e áudio: PDF não suporta embed, então exibe placeholder
                            doc.setTextColor(180, 0, 0);
                            doc.text("[Arquivo de vídeo/áudio não pode ser embedado diretamente no PDF. Consulte o arquivo original para visualização.]", margin + 5, yPos);
                            yPos += 10;
                        } else {
                            // Para outros tipos não suportados
                            doc.setTextColor(180, 0, 0);
                            doc.text("[Tipo de arquivo não suportado para renderização no PDF. Consulte o arquivo original.]", margin + 5, yPos);
                            yPos += 10;
                        }
                        doc.setTextColor(0); // Reset cor
                    }
                }
            }
        }

        // ────────────────────────────────────────────────
        // SEÇÃO DE OBSERVAÇÕES E ADENDO (somente Convênio)
        // ────────────────────────────────────────────────
        if (isConvenio) {
            yPos = newPage(true);
            yPos += 35;

            doc.setFontSize(18);
            doc.setTextColor(0, 0, 180);
            doc.text("OBSERVAÇÕES / ADENDO / COMPROVAÇÃO ADICIONAL", pageWidth / 2, yPos, { align: 'center' });
            doc.setTextColor(0);
            yPos += 20;

            const obsTexto = document.getElementById('observacoesConvenio')?.value.trim() || "Nenhuma observação adicional informada.";
            const linhasObs = doc.splitTextToSize(obsTexto, pageWidth - margin * 2);
            doc.setFontSize(12);
            doc.text(linhasObs, margin, yPos);
            yPos += linhasObs.length * 7 + 18;

            const arquivoAdendo = document.getElementById('adendoConvenio')?.files?.[0];

            if (arquivoAdendo) {
                doc.setFontSize(14);
                doc.text("Documento comprobatório adicional (adendo)", pageWidth / 2, yPos, { align: "center" });
                yPos += 15;

                if (arquivoAdendo.type.startsWith('image/')) {
                    try {
                        const dataUrl = await new Promise(r => {
                            const rd = new FileReader();
                            rd.onload = () => r(rd.result);
                            rd.readAsDataURL(arquivoAdendo);
                        });

                        const img = new Image();
                        await new Promise(r => { img.onload = r; img.src = dataUrl; });

                        let w = pageWidth - margin * 2;
                        let h = (img.height / img.width) * w;
                        const maxH = pageHeight - yPos - margin - 20;

                        if (h > maxH) {
                            h = maxH;
                            w = (img.width / img.height) * h;
                        }

                        doc.addImage(dataUrl, arquivoAdendo.type.split('/')[1].toUpperCase(), margin, yPos, w, h);
                        yPos += h + 12;

                        doc.setFontSize(10);
                        doc.setTextColor(90);
                        doc.text(`Arquivo: ${arquivoAdendo.name} (${(arquivoAdendo.size / 1024 / 1024).toFixed(2)} MB)`, pageWidth / 2, yPos, { align: 'center' });
                        doc.setTextColor(0);
                    } catch (e) {
                        console.error("Erro ao inserir imagem do adendo:", e);
                        doc.text("[Erro ao exibir imagem do adendo]", margin, yPos);
                        yPos += 12;
                    }
                } else if (arquivoAdendo.type === 'application/pdf') {
                    try {
                        const buf = await arquivoAdendo.arrayBuffer();
                        const pdf = await pdfjsLib.getDocument({ data: buf }).promise;

                        for (let num = 1; num <= pdf.numPages; num++) {
                            if (yPos > pageHeight - 90) {
                                yPos = newPage(true);
                                yPos += 25;
                            }

                            doc.setFontSize(10);
                            doc.setTextColor(90);
                            doc.text(`Página ${num}/${pdf.numPages} – ${arquivoAdendo.name}`, margin, yPos);
                            yPos += 8;

                            const pg = await pdf.getPage(num);
                            const scale = 1.9;
                            const vp = pg.getViewport({ scale });

                            const canvas = document.createElement('canvas');
                            canvas.width = vp.width;
                            canvas.height = vp.height;
                            await pg.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;

                            const imgData = canvas.toDataURL('image/jpeg', 0.89);

                            let w = pageWidth - margin * 2;
                            let h = (vp.height / vp.width) * w;
                            const maxH = pageHeight - yPos - margin - 15;

                            if (h > maxH) {
                                h = maxH;
                                w = (vp.width / vp.height) * h;
                            }

                            doc.addImage(imgData, 'JPEG', margin, yPos, w, h);
                            yPos += h + 15;

                            canvas.width = canvas.height = 0;
                        }
                    } catch (e) {
                        console.error("Erro ao renderizar PDF do adendo:", e);
                        doc.setTextColor(180, 0, 0);
                        doc.text("[Não foi possível exibir o conteúdo do PDF adicionado]", margin, yPos);
                        yPos += 15;
                    }
                } else if (arquivoAdendo.type.startsWith('video/') || arquivoAdendo.type.startsWith('audio/')) {
                    // Para MP4 e áudio no adendo
                    doc.setTextColor(180, 0, 0);
                    doc.text("[Arquivo de vídeo/áudio não pode ser embedado diretamente no PDF. Consulte o arquivo original para visualização.]", margin + 5, yPos);
                    yPos += 10;
                    doc.setTextColor(0);
                } else {
                    doc.setTextColor(180, 0, 0);
                    doc.text("[Tipo de arquivo não suportado para renderização no PDF. Consulte o arquivo original.]", margin + 5, yPos);
                    yPos += 10;
                    doc.setTextColor(0);
                }
            }
        }

        // ────────────────────────────────────────────────
        // FINALIZAÇÃO E DOWNLOAD DO ARQUIVO
        // ────────────────────────────────────────────────
        const nomeArquivo = `Atestado_Capacidade_Tecnica_${nomeEntidade.replace(/[^a-zA-Z0-9]/g, '_')}_${tipo}_${new Date().toISOString().slice(0,10)}.pdf`;

        doc.save(nomeArquivo);
        alert('PDF gerado com sucesso!\n\nArquivo salvo como:\n' + nomeArquivo);

    } catch (erro) {
        console.error("Erro crítico durante a geração do PDF:", erro);
        alert(
            'Ocorreu um erro ao tentar gerar o PDF.\n\n' +
            'Por favor, verifique o console do navegador (F12 → Console) para mais detalhes.\n' +
            'Se o problema persistir, tente reduzir a quantidade de imagens/PDFs anexados ou verifique os tipos de arquivos (MP4/áudio só exibem placeholders).'
        );
    } finally {
        document.getElementById('loadingOverlay').style.display = 'none';
    }
}
</script>
</body>
</html>