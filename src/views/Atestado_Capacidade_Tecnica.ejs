    function toggleParceriaFields(annexId) {
        const tipo = document.getElementById(`tipoParceriaAnterior-${annexId}`).value;
        const fields = document.getElementById(`parceriaFields-${annexId}`);
        const orgaoFields = document.getElementById(`orgaoFields-${annexId}`);
        if (tipo === 'nenhum') {
            fields.style.display = 'none';
            orgaoFields.style.display = 'none';
        } else {
            fields.style.display = 'block';
            orgaoFields.style.display = 'block';
        }
    }

    function removeAnnex(id, event) {
        event.stopPropagation();
        const annexToRemove = document.getElementById(`annex-accordion-${id}`);
        if (annexToRemove) {
            annexToRemove.remove();
            const index = annexOrder.indexOf(id);
            if (index > -1) {
                annexOrder.splice(index, 1);
            }
            delete fileCounters[id];
        }
    }

    async function getBase64ImageFromUrl(url) {
        try {
            const response = await fetch(url);
            if (!response.ok) throw new Error('Falha ao carregar imagem');
            const blob = await response.blob();
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onloadend = () => resolve(reader.result);
                reader.onerror = reject;
                reader.readAsDataURL(blob);
            });
        } catch (err) {
            console.error("Erro em getBase64ImageFromUrl:", err);
            return null;
        }
    }

    function validateLettersOnly(input) {
        input.value = input.value.replace(/[^a-zA-Z\sÀ-ú]/g, '');
    }

    function addMoreFiles(type, annexId) {
        const container = document.getElementById(`${type}-${annexId}-container`);
        const fileInputs = container.querySelectorAll('input[type="file"]');

        if (fileInputs.length >= 5) {
            alert('Limite de 5 campos de arquivo por seção atingido.');
            return;
        }

        const newIndex = fileInputs.length + 1;

        const inputWrapper = document.createElement('div');
        inputWrapper.classList.add('file-input-wrapper');
        inputWrapper.id = `wrapper-${type}-${annexId}-${newIndex}`;

        const newInput = document.createElement('input');
        newInput.type = 'file';
        newInput.id = `${type}-${annexId}-${newIndex}`;
        newInput.accept = 'image/png,image/jpeg,application/pdf';
        newInput.multiple = true;
        newInput.onchange = (e) => validateMixedFiles(e.target);

        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.classList.add('remove-btn');
        removeButton.textContent = 'Remover';
        removeButton.onclick = () => inputWrapper.remove();

        inputWrapper.appendChild(newInput);
        inputWrapper.appendChild(removeButton);

        const addButton = container.querySelector('.add-btn');
        container.insertBefore(inputWrapper, addButton);
    }

    function validateMixedFiles(input) {
        const files = input.files;
        if (files.length > 5) {
            alert('Você pode selecionar no máximo 5 arquivos de uma vez.');
            input.value = '';
            return;
        }
        const validImageTypes = ['image/png', 'image/jpeg'];
        const validPdfType = 'application/pdf';
        for (let file of files) {
            if (!validImageTypes.includes(file.type) && file.type !== validPdfType) {
                alert('Apenas arquivos PNG, JPEG e PDF são aceitos.');
                input.value = ''; return;
            }
            if (file.type.startsWith('image/') && file.size > 5 * 1024 * 1024) {
                alert(`O arquivo de imagem "${file.name}" excede 5MB.`);
                input.value = ''; return;
            }
            if (file.type === validPdfType && file.size > 10 * 1024 * 1024) {
                alert(`O arquivo PDF "${file.name}" excede 10MB.`);
                input.value = ''; return;
            }
        }
    }

    async function fetchEntityData() {
        const cnpj = document.getElementById('cnpj').value.replace(/\D/g, '');
        const nomeEntidadeInput = document.getElementById('nomeEntidade');
        if (cnpj.length !== 14) return;

        nomeEntidadeInput.value = 'Buscando dados...';
        try {
            const response = await fetch(`https://brasilapi.com.br/api/cnpj/v1/${cnpj}`);
            const data = await response.json();

            if (!response.ok || !data.razao_social) throw new Error(data.message || 'CNPJ inválido.');

            nomeEntidadeInput.value = data.razao_social || 'Não encontrado';
            document.getElementById('cep').value = data.cep || '';
            if (data.cep) fetchAddressData();

        } catch (err) {
            alert(`Erro ao consultar CNPJ: ${err.message}`);
            nomeEntidadeInput.value = '';
        }
    }

    async function fetchAddressData() {
        const cep = document.getElementById('cep').value.replace(/\D/g, '');
        const enderecoInput = document.getElementById('endereco');
        if (cep.length !== 8) {
            enderecoInput.value = '';
            return;
        }

        enderecoInput.value = 'Buscando endereço...';
        try {
            const response = await fetch(`https://brasilapi.com.br/api/cep/v1/${cep}`);
            if (!response.ok) throw new Error(`Erro na consulta (status ${response.status})`);
            const data = await response.json();
            enderecoInput.value = `${data.street || ''}, ${data.neighborhood || ''}, ${data.city || ''} - ${data.state || ''}`;
            document.getElementById('numero').focus();
        } catch (err) {
            alert(`Erro ao consultar CEP: ${err.message}`);
            enderecoInput.value = '';
        }
    }

    function formatDateToBrazilian(dateStr) {
        if (!dateStr) return '';
        const [year, month, day] = dateStr.split('-');
        return `${day.padStart(2, '0')}/${month.padStart(2, '0')}/${year}`;
    }

    function drawCheckbox(doc, x, y, checked) {
        doc.setDrawColor(0);
        doc.rect(x, y - 4, 5, 5);
        if (checked) {
            doc.setFontSize(10);
            doc.text('X', x + 1.5, y);
        }
    }

    async function generatePDF() {
        document.getElementById('loadingOverlay').style.display = 'flex';

        try {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });

            const watermarkImageUrl = 'https://i.ibb.co/Lz10svWs/Declara-es-page-0001.jpg';
            let watermarkBase64 = null;
            try {
                watermarkBase64 = await getBase64ImageFromUrl(watermarkImageUrl);
            } catch (e) {
                console.warn("Marca d'água não carregada");
            }

            const pageWidth = 210;
            const pageHeight = 297;
            const margin = 20;
            let yPos = margin;

            const addWatermarkToPage = () => {
                if (watermarkBase64) {
                    doc.addImage(watermarkBase64, 'JPEG', 0, 0, pageWidth, pageHeight, undefined, 'FAST', 0, 0.18);
                }
            };

            const addNewPdfPage = (addWatermark = true) => {
                doc.addPage();
                if (addWatermark) addWatermarkToPage();
                return margin;
            };

            const tipoAtestadoValue = document.getElementById('tipoAtestado').value;
            const tipoAtestadoText = document.getElementById('tipoAtestado').options[document.getElementById('tipoAtestado').selectedIndex].text || "Não informado";

            // =====================================
            // PÁGINA 1 – ATESTADO PRINCIPAL
            // =====================================
            addWatermarkToPage();

            doc.setFontSize(18);
            doc.setFont("helvetica", "bold");
            doc.setTextColor(0, 51, 102);
            doc.text("ATESTADO DE CAPACIDADE TÉCNICA", pageWidth / 2, yPos + 25, { align: "center" });

            yPos += 45;

            doc.setFontSize(12);
            doc.setFont("helvetica", "normal");
            doc.setTextColor(0);

            const nomeDirigente = document.getElementById('nomeDirigente').value.trim() || "________________________________";
            const cargoDirigente = document.getElementById('cargoDirigente').value.trim() || "________________________________";
            const nomeEntidade = document.getElementById('nomeEntidade').value.trim() || "_______________________________________________";
            const cnpj = document.getElementById('cnpj').value.trim() || "__.___.___/____-__";
            const endereco = document.getElementById('endereco').value.trim() || "";
            const numero = document.getElementById('numero').value.trim() || "";
            const complemento = document.getElementById('complemento').value.trim() || "";
            const cep = document.getElementById('cep').value.trim() || "";
            const enderecoCompleto = [endereco, numero, complemento].filter(Boolean).join(", ") + (cep ? `, CEP ${cep}` : "");
            const numeroProposta = document.getElementById('numeroProposta').value.trim() || "___________";

            // TEXTO ANTIGO RESTAURADO (com LDO 2025)
            const introText = `Eu, ${nomeDirigente}, ${cargoDirigente}, ATESTO, para fins de formalização de ${tipoAtestadoText} no âmbito do Ministério do Esporte - MESP, que a entidade ${nomeEntidade}, inscrita no CNPJ sob o nº ${cnpj}, situada no ${enderecoCompleto}, possui capacidade técnica e operacional para executar o objeto apresentado na Proposta nº ${numeroProposta}, em atendimento ao art. 33, inciso V, da Lei 13.019 de 2014 e art. 89, inciso XI, da Lei nº 15.080 de 30 de dezembro de 2024 (LDO 2025), considerando as experiências adquiridas na(s) execução de projeto(s)/ação(es) na(s) área(s) esportivo/educacional/social, devidamente especificada(s) no Histórico anexo.`;

            const introLines = doc.splitTextToSize(introText, pageWidth - margin * 2);
            doc.text(introLines, margin, yPos);
            yPos += introLines.length * 7 + 12;

            doc.text("Declaração emitida com base nas comprovações anexas.", margin, yPos);
            yPos += 25;

    
            // Assinatura na página 1 → SOMENTE PARA CONVÊNIO
            if (tipoAtestadoValue === 'convenio') {
