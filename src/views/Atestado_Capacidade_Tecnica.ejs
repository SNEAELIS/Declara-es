// Funções auxiliares (mantidas do código original)
// ================================================

async function getBase64ImageFromUrl(url) {
    try {
        const response = await fetch(url);
        if (!response.ok) throw new Error('Falha ao carregar imagem');
        const blob = await response.blob();
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onloadend = () => resolve(reader.result);
            reader.onerror = reject;
            reader.readAsDataURL(blob);
        });
    } catch (err) {
        console.error("Erro em getBase64ImageFromUrl:", err);
        return null;
    }
}

function validateLettersOnly(input) {
    input.value = input.value.replace(/[^a-zA-Z\sÀ-ú]/g, '');
}

function addMoreFiles(type, annexId) {
    const container = document.getElementById(`${type}-${annexId}-container`);
    const fileInputs = container.querySelectorAll('input[type="file"]');

    if (fileInputs.length >= 5) {
        alert('Limite de 5 campos de arquivo por seção atingido.');
        return;
    }

    const newIndex = fileInputs.length + 1;

    const inputWrapper = document.createElement('div');
    inputWrapper.classList.add('file-input-wrapper');
    inputWrapper.id = `wrapper-${type}-${annexId}-${newIndex}`;

    const newInput = document.createElement('input');
    newInput.type = 'file';
    newInput.id = `${type}-${annexId}-${newIndex}`;
    newInput.accept = 'image/png,image/jpeg,application/pdf';
    newInput.multiple = true;
    newInput.onchange = (e) => validateMixedFiles(e.target);

    const removeButton = document.createElement('button');
    removeButton.type = 'button';
    removeButton.classList.add('remove-btn');
    removeButton.textContent = 'Remover';
    removeButton.onclick = () => inputWrapper.remove();

    inputWrapper.appendChild(newInput);
    inputWrapper.appendChild(removeButton);

    const addButton = container.querySelector('.add-btn');
    container.insertBefore(inputWrapper, addButton);
}

function validateMixedFiles(input) {
    const files = input.files;
    if (files.length > 5) {
        alert('Você pode selecionar no máximo 5 arquivos de uma vez.');
        input.value = '';
        return;
    }
    const validImageTypes = ['image/png', 'image/jpeg'];
    const validPdfType = 'application/pdf';
    for (let file of files) {
        if (!validImageTypes.includes(file.type) && file.type !== validPdfType) {
            alert('Apenas arquivos PNG, JPEG e PDF são aceitos.');
            input.value = ''; return;
        }
        if (file.type.startsWith('image/') && file.size > 5 * 1024 * 1024) {
            alert(`O arquivo de imagem "${file.name}" excede 5MB.`);
            input.value = ''; return;
        }
        if (file.type === validPdfType && file.size > 10 * 1024 * 1024) {
            alert(`O arquivo PDF "${file.name}" excede 10MB.`);
            input.value = ''; return;
        }
    }
}

async function fetchEntityData() {
    const cnpj = document.getElementById('cnpj').value.replace(/\D/g, '');
    const nomeEntidadeInput = document.getElementById('nomeEntidade');
    if (cnpj.length !== 14) return;

    nomeEntidadeInput.value = 'Buscando dados...';
    try {
        const response = await fetch(`https://brasilapi.com.br/api/cnpj/v1/${cnpj}`);
        const data = await response.json();

        if (!response.ok || !data.razao_social) throw new Error(data.message || 'CNPJ inválido.');

        nomeEntidadeInput.value = data.razao_social || 'Não encontrado';
        document.getElementById('cep').value = data.cep || '';
        if (data.cep) fetchAddressData();

    } catch (err) {
        alert(`Erro ao consultar CNPJ: ${err.message}`);
        nomeEntidadeInput.value = '';
    }
}

async function fetchAddressData() {
    const cep = document.getElementById('cep').value.replace(/\D/g, '');
    const enderecoInput = document.getElementById('endereco');
    if (cep.length !== 8) {
        enderecoInput.value = '';
        return;
    }

    enderecoInput.value = 'Buscando endereço...';
    try {
        const response = await fetch(`https://brasilapi.com.br/api/cep/v1/${cep}`);
        if (!response.ok) throw new Error(`Erro na consulta (status ${response.status})`);
        const data = await response.json();
        enderecoInput.value = `${data.street || ''}, ${data.neighborhood || ''}, ${data.city || ''} - ${data.state || ''}`;
        document.getElementById('numero').focus();
    } catch (err) {
        alert(`Erro ao consultar CEP: ${err.message}`);
        enderecoInput.value = '';
    }
}

function formatDateToBrazilian(dateStr) {
    if (!dateStr) return '';
    const [year, month, day] = dateStr.split('-');
    return `${day.padStart(2, '0')}/${month.padStart(2, '0')}/${year}`;
}

function drawCheckbox(doc, x, y, checked) {
    doc.setDrawColor(0);
    doc.rect(x, y - 4, 5, 5);
    if (checked) {
        doc.setFontSize(10);
        doc.text('X', x + 1.5, y);
    }
}

// ================================================
// Geração do PDF - Função principal
// ================================================
async function generatePDF() {
    const tipo = document.getElementById('tipoAtestado').value;
    if (!tipo) {
        alert('Selecione o Tipo de Atestado primeiro.');
        return;
    }

    // Validações gerais obrigatórias
    if (!document.getElementById('nomeDirigente').value.trim()) {
        alert('Preencha o Nome do Dirigente / Prefeito.');
        return;
    }
    if (!document.getElementById('cnpj').value.trim()) {
        alert('Preencha o CNPJ.');
        return;
    }
    if (!document.getElementById('nomeEntidade').value.trim()) {
        alert('O nome da entidade não foi preenchido (verifique o CNPJ).');
        return;
    }
    if (!document.getElementById('cep').value.trim()) {
        alert('Preencha o CEP.');
        return;
    }
    if (!document.getElementById('endereco').value.trim()) {
        alert('Preencha o endereço.');
        return;
    }
    if (!document.getElementById('numero').value.trim()) {
        alert('Preencha o número do endereço.');
        return;
    }
    if (!document.getElementById('numeroProposta').value.trim()) {
        alert('Preencha o Número da Proposta Atual.');
        return;
    }

    // Validações específicas por tipo
    if (tipo === 'convenio') {
        if (!document.getElementById('matriculaFuncional').value.trim()) {
            alert('Preencha a Matrícula Funcional do Prefeito.');
            return;
        }
    }

    if (tipo === 'termoFomento') {
        if (!document.getElementById('cargoDirigente').value.trim()) {
            alert('Preencha o Cargo do Dirigente.');
            return;
        }
        if (annexOrder.length === 0) {
            alert('No Termo de Fomento é obrigatório adicionar pelo menos um bloco de anexo/histórico.');
            return;
        }
        if (!document.getElementById('capacidadeNaoConfunde').checked) {
            alert('Marque a declaração: "capacidade técnica já instalada não se confunde".');
            return;
        }
        if (!document.getElementById('declaracaoEspecificacoes').checked) {
            alert('Marque a declaração de cumprimento das 3 especificações.');
            return;
        }
        if (!document.querySelector('input[name="acoesNoEstado"]:checked')) {
            alert('Informe se a OSC já realizou ações no estado.');
            return;
        }
        if (!document.querySelector('input[name="abrangenciaNacional"]:checked')) {
            alert('Informe se a entidade possui abrangência nacional no estatuto.');
            return;
        }
        const elemCompChecked = document.querySelectorAll('input[name="elementosComplementares"]:checked').length;
        if (elemCompChecked === 0) {
            alert('Marque pelo menos um item em Elementos Complementares.');
            return;
        }
        const compChecked = document.querySelectorAll('input[name="comprovacaoTipo"]:checked').length;
        if (compChecked === 0) {
            alert('Marque pelo menos um item em Comprovação Institucional/Técnica/Operacional.');
            return;
        }
    }

    // =============================================
    // Início da geração do PDF
    // =============================================
    document.getElementById('loadingOverlay').style.display = 'flex';

    try {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });

        const watermarkImageUrl = 'https://i.ibb.co/Lz10svWs/Declara-es-page-0001.jpg';
        let watermarkBase64 = null;
        try {
            watermarkBase64 = await getBase64ImageFromUrl(watermarkImageUrl);
        } catch (e) {
            console.warn("Marca d'água não carregada");
        }

        const pageWidth = 210;
        const pageHeight = 297;
        const margin = 20;
        let yPos = margin;

        const addWatermarkToPage = () => {
            if (watermarkBase64) {
                doc.addImage(watermarkBase64, 'JPEG', 0, 0, pageWidth, pageHeight, undefined, 'FAST', 0, 0.18);
            }
        };

        const addNewPdfPage = (addWatermark = true) => {
            doc.addPage();
            if (addWatermark) addWatermarkToPage();
            return margin;
        };

        addWatermarkToPage();

        // Cabeçalho principal
        doc.setFontSize(18);
        doc.setFont("helvetica", "bold");
        doc.setTextColor(0, 51, 102);
        doc.text("ATESTADO DE CAPACIDADE TÉCNICA", pageWidth / 2, yPos + 25, { align: "center" });

        yPos += 45;

        doc.setFontSize(12);
        doc.setFont("helvetica", "normal");
        doc.setTextColor(0);

        const nomeDirigente   = document.getElementById('nomeDirigente').value.trim() || "________________________________";
        const cargoDirigente  = tipo === 'termoFomento' ? (document.getElementById('cargoDirigente').value.trim() || "________________________________") : "Prefeito";
        const matrícula       = tipo === 'convenio' ? (document.getElementById('matriculaFuncional').value.trim() || "Não informada") : "";
        const nomeEntidade    = document.getElementById('nomeEntidade').value.trim() || "_______________________________________________";
        const cnpj            = document.getElementById('cnpj').value.trim() || "__.___.___/____-__";
        const endereco        = document.getElementById('endereco').value.trim() || "";
        const numero          = document.getElementById('numero').value.trim() || "";
        const complemento     = document.getElementById('complemento').value.trim() || "";
        const cep             = document.getElementById('cep').value.trim() || "";
        const enderecoCompleto = [endereco, numero, complemento].filter(Boolean).join(", ") + (cep ? `, CEP ${cep}` : "");
        const numeroProposta  = document.getElementById('numeroProposta').value.trim() || "___________";

        let signatario = nomeDirigente;
        if (tipo === 'termoFomento' && cargoDirigente) signatario += `, ${cargoDirigente}`;
        if (tipo === 'convenio' && matrícula) signatario += ` (Matrícula funcional: ${matrícula})`;

        const introText = `Eu, ${signatario}, ATESTO, para fins de formalização de ${document.getElementById('tipoAtestado').options[document.getElementById('tipoAtestado').selectedIndex].text} no âmbito do Ministério do Esporte - MESP, que a entidade ${nomeEntidade}, inscrita no CNPJ sob o nº ${cnpj}, situada no ${enderecoCompleto}, possui capacidade técnica e operacional para executar o objeto apresentado na Proposta nº ${numeroProposta}, em atendimento ao art. 33, inciso V, da Lei 13.019 de 2014 e art. 89, inciso XI, da Lei nº 15.080 de 30 de dezembro de 2024 (LDO 2025), considerando as experiências adquiridas na(s) execução de projeto(s)/ação(es) na(s) área(s) esportivo/educacional/social, devidamente especificada(s) no Histórico anexo ou adendo.`;

        const introLines = doc.splitTextToSize(introText, pageWidth - margin * 2);
        doc.text(introLines, margin, yPos);
        yPos += introLines.length * 7 + 12;

        doc.text("Declaração emitida com base nas comprovações anexas.", margin, yPos);
        yPos += 25;

        // Assinatura na página 1 → SOMENTE PARA CONVÊNIO
        if (tipo === 'convenio') {
            const sigX = (pageWidth - 100) / 2;
            doc.line(sigX, yPos, sigX + 100, yPos);
            yPos += 8;

            doc.setFontSize(12);
            doc.text(nomeDirigente, pageWidth / 2, yPos, { align: "center" });
            yPos += 7;
            doc.text(cargoDirigente, pageWidth / 2, yPos, { align: "center" });
            yPos += 7;
            doc.text(`Matrícula funcional: ${matrícula}`, pageWidth / 2, yPos, { align: "center" });
            yPos += 15;

            doc.setFontSize(10);
            doc.text("Assinatura pelo gov.br do Dirigente responsável", pageWidth / 2, yPos, { align: "center" });
        }

        // =============================================
        // PÁGINA 2 – DECLARAÇÕES OBRIGATÓRIAS (somente Termo de Fomento)
        // =============================================
        if (tipo === 'termoFomento') {
            yPos = addNewPdfPage();
            yPos += 10;

            doc.setFontSize(16);
            doc.setFont("helvetica", "bold");
            doc.setTextColor(0, 51, 102);
            doc.text("DECLARAÇÕES OBRIGATÓRIAS", pageWidth / 2, yPos, { align: "center" });
            yPos += 15;

            doc.setFontSize(11);
            doc.setFont("helvetica", "normal");
            doc.setTextColor(0);

            doc.text("Declaro, para os devidos fins, cumprir integralmente as 3 especificações abaixo:", margin, yPos);
            yPos += 10;

            doc.text("1. Em atendimento à ADPF nº 854/2024 do STF, a OSC comprova que desenvolve efetivamente atividades nas suas instalações físicas (sede social e, conforme o caso, os estabelecimentos em que exerça suas ações), isto é, não se trata meramente de um endereço fiscal ou de um local onde funciona apenas o setor administrativo.", margin + 5, yPos, { maxWidth: pageWidth - margin * 2 - 5 });
            yPos += 18;

            doc.text("2. A OSC possui corpo técnico mínimo, com experiência, seja ele voluntário ou contratado, com comprovada atuação em ações compatíveis com o objeto da parceria.", margin + 5, yPos, { maxWidth: pageWidth - margin * 2 - 5 });
            yPos += 12;

            doc.text("3. É vedada a contratação integral do corpo técnico mediante terceirização das ações.", margin + 5, yPos, { maxWidth: pageWidth - margin * 2 - 5 });
            yPos += 12;

            doc.text("A OSC já realizou ações no estado alcançado pela emenda parlamentar? *", margin, yPos);
            yPos += 8;

            const acoesSimChecked = document.querySelector('input[name="acoesNoEstado"][value="sim"]').checked;
            drawCheckbox(doc, margin + 5, yPos, acoesSimChecked);
            doc.text("Sim", margin + 12, yPos);
            yPos += 6;

            const acoesNaoChecked = document.querySelector('input[name="acoesNoEstado"][value="nao"]').checked;
            drawCheckbox(doc, margin + 5, yPos, acoesNaoChecked);
            doc.text("Não", margin + 12, yPos);
            yPos += 10;

            if (acoesSimChecked) {
                const quais = document.getElementById('quaisAcoesEstado').value.trim() || "Não informado";
                doc.text("Se sim, quais? " + quais, margin + 5, yPos);
                yPos += 10;
            }

            yPos += 5;
            doc.text("A entidade declara que possui abrangência nacional em seu estatuto social? *", margin, yPos);
            yPos += 8;

            const abrangSimChecked = document.querySelector('input[name="abrangenciaNacional"][value="sim"]').checked;
            drawCheckbox(doc, margin + 5, yPos, abrangSimChecked);
            doc.text("Sim", margin + 12, yPos);
            yPos += 6;

            const abrangNaoChecked = document.querySelector('input[name="abrangenciaNacional"][value="nao"]').checked;
            drawCheckbox(doc, margin + 5, yPos, abrangNaoChecked);
            doc.text("Não", margin + 12, yPos);
            yPos += 10;

            yPos += 5;
            doc.setFont("helvetica", "bold");
            doc.text("Elementos Complementares de Comprovação da Capacidade Técnica *Obrigatório*", margin, yPos);
            yPos += 10;
            doc.setFont("helvetica", "normal");

            const elementos = document.querySelectorAll('input[name="elementosComplementares"]');
            const textosElementos = [
                "Relatórios de prestações de contas aprovadas por órgão(s) público(s)",
                "Publicações temáticas, pesquisas, materiais didáticos ou técnicos relacionados ao objeto",
                "Declarações de participação em conselhos, redes, fóruns ou articulações temáticas",
                "Certificados, premiações ou títulos recebidos pela OSC em sua área de atuação",
                "Relatórios anuais de atividades demonstrando atuação continuada no campo temático",
                "Não possuo nenhum dos elementos acima"
            ];

            elementos.forEach((el, idx) => {
                drawCheckbox(doc, margin + 5, yPos, el.checked);
                doc.text(textosElementos[idx], margin + 15, yPos);
                yPos += 8;
            });

            yPos += 10;
            doc.setFont("helvetica", "bold");
            doc.text("Comprovação Institucional, Técnica, Operacional e Material *Obrigatório*", margin, yPos);
            yPos += 10;
            doc.setFont("helvetica", "normal");

            doc.text("Para reforço da capacidade técnica e operacional, integram o presente atestado os seguintes anexos comprobatórios (marcar obrigatoriamente um):", margin, yPos, { maxWidth: pageWidth - margin * 2 });
            yPos += 12;

            const compTypes = document.querySelectorAll('input[name="comprovacaoTipo"]');
            const textosComp = [
                "Fotografias datadas das atividades/projetos executados",
                "Registros audiovisuais (links ou arquivos digitais)",
                "Listas de presença, relatórios de execução ou registros de monitoramento",
                "Outros documentos comprobatórios pertinentes (ex. currículos)"
            ];

            compTypes.forEach((el, idx) => {
                drawCheckbox(doc, margin + 5, yPos, el.checked);
                doc.text(textosComp[idx], margin + 15, yPos);
                yPos += 8;
            });
        }

        // =============================================
        // PÁGINA 3 – IDONEIDADE E RESPONSABILIDADE (somente Termo de Fomento)
        // =============================================
        if (tipo === 'termoFomento') {
            yPos = addNewPdfPage();
            yPos += 10;

            doc.setFontSize(16);
            doc.setFont("helvetica", "bold");
            doc.setTextColor(0, 51, 102);
            doc.text("DECLARAÇÃO DE IDONEIDADE E RESPONSABILIDADE", pageWidth / 2, yPos, { align: "center" });
            yPos += 15;

            doc.setFontSize(11);
            doc.setFont("helvetica", "normal");
            doc.setTextColor(0);

            const declarationText = [
                "Declaramos que as atividades descritas foram executadas com qualidade, regularidade e aderência ao objeto pactuado, não havendo, até a presente data, fatos que desabonem a conduta ou a capacidade técnica, operacional e institucional da OSC.",
                "",
                "A entidade emitente assume integral responsabilidade pela veracidade, completude e fidedignidade das informações prestadas, que são declaradas sob fé pública, estando ciente de que a omissão de informações relevantes, a prestação de informações falsas ou a apresentação de documentos inidôneos caracterizam infração administrativa grave, sujeitando-se o declarante e a entidade emitente às sanções administrativas, civis e penais cabíveis, inclusive aquelas previstas na legislação penal, na Lei nº 8.429/1992 (quando aplicável), na Lei nº 13.019/2014, Decreto nº 8.726/2016 e demais normas correlatas, sem prejuízo de outras medidas legais pertinentes.",
                "",
                "A constatação, a qualquer tempo, de omissão dolosa ou culposa, inexatidão relevante, falsidade ideológica ou material nas informações e documentos apresentados neste atestado ensejará, independentemente de outras cominações legais:",
                "I – a nulidade do atestado para todos os fins;",
                "II – a impugnação ou rescisão da parceria, se já celebrada;",
                "III – a comunicação aos órgãos de controle interno e externo competentes;",
                "IV – o encaminhamento para apuração de responsabilidade administrativa, civil e penal da autoridade signatária e da entidade emitente.",
                "",
                "Parágrafo único. A aplicação das medidas acima ocorrerá sem prejuízo da adoção de outras providências sancionatórias cabíveis, inclusive reparação de danos ao erário.",
                "",
                "Cientificamo-nos de que o órgão concedente poderá, a qualquer tempo, diligenciar para verificar a autenticidade e a veracidade das informações e documentos apresentados."
            ];

            declarationText.forEach(paragraph => {
                if (paragraph.trim() === "") {
                    yPos += 6;
                    return;
                }
                const lines = doc.splitTextToSize(paragraph, pageWidth - margin * 2);
                if (yPos + (lines.length * 6) > pageHeight - margin - 40) {
                    yPos = addNewPdfPage();
                    yPos += 20;
                }
                doc.text(lines, margin, yPos);
                yPos += lines.length * 6 + 2;
            });

            yPos += 30;
            const sigX = (pageWidth - 100) / 2;
            doc.line(sigX, yPos, sigX + 100, yPos);
            yPos += 8;

            doc.setFontSize(12);
            doc.text(nomeDirigente, pageWidth / 2, yPos, { align: "center" });
            yPos += 7;
            doc.text(cargoDirigente, pageWidth / 2, yPos, { align: "center" });
            yPos += 15;

            doc.setFontSize(10);
            doc.text("Assinatura pelo gov.br do Dirigente responsável", pageWidth / 2, yPos, { align: "center" });
        }

        // =============================================
        // ANEXOS / HISTÓRICO (Termo de Fomento) - Extendida com dados completos
        // =============================================
        if (tipo === 'termoFomento') {
            for (const i of annexOrder) {
                yPos = addNewPdfPage(true);
                yPos += 30;
                doc.setFontSize(18);
                doc.setTextColor(0, 0, 255);
                doc.text('ANEXO ' + i, pageWidth / 2, yPos, { align: 'center' });
                doc.setTextColor(0, 0, 0);
                yPos += 15;
                doc.setFontSize(14);
                doc.text('HISTÓRICO DO PROJETO/AÇÃO', margin, yPos);
                yPos += 10;
                doc.setFontSize(12);

                const nomeProjeto = document.getElementById(`nomeProjeto-${i}`)?.value || 'Não informado';
                const entidadesParceiras = document.getElementById(`entidadesParceiras-${i}`)?.value || 'Não informado';
                const numeroBeneficiados = document.getElementById(`numeroBeneficiados-${i}`)?.value || 'Não informado';
                const atividadesDesenvolvidas = document.getElementById(`atividadesDesenvolvidas-${i}`)?.value || 'Não informado';
                const dataInicio = formatDateToBrazilian(document.getElementById(`dataInicio-${i}`)?.value);
                const dataTermino = formatDateToBrazilian(document.getElementById(`dataTermino-${i}`)?.value);

                const addTextSection = (label, value) => {
                    if (!value || value.trim() === '') return;
                    const labelHeight = 6;
                    const valueLines = doc.splitTextToSize(value, pageWidth - margin * 2 - 5);
                    const valueHeight = valueLines.length * 5;

                    if (yPos + labelHeight + valueHeight > pageHeight - margin) {
                        yPos = addNewPdfPage(true);
                        yPos += 30;
                        doc.setFontSize(14);
                        doc.text('HISTÓRICO (continuação)', margin, yPos);
                        yPos += 10;
                        doc.setFontSize(12);
                    }

                    doc.setFont('helvetica', 'bold');
                    doc.text(label, margin, yPos);
                    yPos += labelHeight;

                    doc.setFont('helvetica', 'normal');
                    doc.text(valueLines, margin + 5, yPos);
                    yPos += valueHeight + 5;
                };

                addTextSection('Nome do Projeto/Ação:', nomeProjeto);
                addTextSection('Entidades Parceiras:', entidadesParceiras);
                addTextSection('Número de Beneficiados:', numeroBeneficiados);
                addTextSection('Data de Início:', dataInicio);
                addTextSection('Data de Término:', dataTermino);
                addTextSection('Ações/Atividades Desenvolvidas:', atividadesDesenvolvidas);

                if (tipo === 'termoFomento') {
                    const tipoParceriaAnteriorSelect = document.getElementById(`tipoParceriaAnterior-${i}`);
                    const tipoParceriaAnteriorText = tipoParceriaAnteriorSelect ? tipoParceriaAnteriorSelect.options[tipoParceriaAnteriorSelect.selectedIndex].text : 'Não informado';

                    addTextSection('Tipo de Parceria Anterior:', tipoParceriaAnteriorText);

                    addTextSection('Nº / Ano (Anterior):', document.getElementById(`nrAnoAnterior-${i}`)?.value || 'Não informado');
                    addTextSection('Órgão/Entidade Parceira Anterior:', document.getElementById(`orgaoAnterior-${i}`)?.value || 'Não informado');

                    const estruturasFisicas = document.getElementById(`estruturasFisicas-${i}`)?.value || 'Não informado';
                    const qualificacaoPessoal = document.getElementById(`qualificacaoPessoal-${i}`)?.value || 'Não informado';

                    addTextSection('Estruturas Físicas:', estruturasFisicas);
                    addTextSection('Qualificação Profissional:', qualificacaoPessoal);
                }

                // Arquivos comprobatórios - Extendida com dados completos
                yPos = addNewPdfPage(true);
                yPos += 30;
                doc.setFontSize(12);
                doc.text('Documentos Comprobatórios do Anexo ' + i + ':', margin, yPos);
                yPos += 10;

                let filesToRenderInPDF = [];
                const evidenceTypes = ['fotos', 'materiais', 'midia', 'instrumentos'];
                for (const type of evidenceTypes) {
                    const inputs = document.querySelectorAll(`input[id^="${type}-${i}-"]`);
                    inputs.forEach(input => {
                        if (input.files && input.files.length > 0) {
                            Array.from(input.files).forEach(file => filesToRenderInPDF.push({ file, type }));
                        }
                    });
                }

                if (filesToRenderInPDF.length === 0) {
                    doc.text('Nenhum arquivo anexado neste bloco.', margin + 5, yPos);
                    yPos += 10;
                } else {
                    for (const { file } of filesToRenderInPDF) {
                        if (file.type.startsWith('image/')) {
                            const reader = new FileReader();
                            const imgData = await new Promise((resolve) => {
                                reader.onload = () => resolve(reader.result);
                                reader.readAsDataURL(file);
                            });
                            const img = new Image();
                            img.src = imgData;
                            await new Promise((resolve) => { img.onload = resolve; });

                            const maxWidth = pageWidth - 2 * margin;
                            const maxHeight = pageHeight - (margin * 2) - 40;
                            const ratio = Math.min(maxWidth / img.width, maxHeight / img.height);
                            const finalHeight = img.height * ratio;
                            const finalWidth = img.width * ratio;
                            const captionHeight = 15;

                            if (yPos + finalHeight + captionHeight > pageHeight - margin) {
                                yPos = addNewPdfPage(true);
                                yPos += 30;
                                doc.setFontSize(12);
                                doc.text('Documentos Comprobatórios (continuação):', margin, yPos);
                                yPos += 10;
                            }

                            doc.addImage(imgData, file.type.split('/')[1].toUpperCase(), (pageWidth - finalWidth) / 2, yPos, finalWidth, finalHeight);
                            yPos += finalHeight + 5;
                            doc.setFontSize(9);
                            doc.setTextColor(100, 100, 100);
                            doc.text(`Arquivo: ${file.name} (${file.type})`, pageWidth / 2, yPos, { align: 'center' });
                            doc.setTextColor(0, 0, 0);
                            yPos += 10;
                            doc.setFontSize(12);

                        } else if (file.type === 'application/pdf') {
                            const pdfBytes = await file.arrayBuffer();
                            const pdf = await pdfjsLib.getDocument({ data: pdfBytes }).promise;

                            for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
                                yPos = addNewPdfPage(true);
                                yPos += 25;

                                doc.setFontSize(10);
                                doc.setTextColor(100, 100, 100);
                                doc.text(`Documento Anexo: ${file.name} (Página ${pageNum}/${pdf.numPages})`, margin, yPos);
                                yPos += 5;

                                const page = await pdf.getPage(pageNum);
                                const highResScale = 2.0;
                                const viewport = page.getViewport({ scale: highResScale });

                                const canvas = document.createElement('canvas');
                                canvas.height = viewport.height;
                                canvas.width = viewport.width;
                                const context = canvas.getContext('2d');

                                await page.render({ canvasContext: context, viewport }).promise;

                                const imgData = canvas.toDataURL('image/jpeg', 0.9);

                                const maxWidth = pageWidth - (2 * margin);
                                const maxHeight = pageHeight - yPos - margin;
                                const scaleRatio = Math.min(maxWidth / viewport.width, maxHeight / viewport.height);

                                const finalWidth = viewport.width * scaleRatio;
                                const finalHeight = viewport.height * scaleRatio;
                                const xCentered = (pageWidth - finalWidth) / 2;

                                doc.addImage(imgData, 'JPEG', xCentered, yPos, finalWidth, finalHeight, undefined, 'FAST');

                                canvas.width = 0;
                                canvas.height = 0;
                                yPos += finalHeight + 10;
                            }
                        }
                    }
                }
            }
        }

        // =============================================
        // OBSERVAÇÕES + ADENDO (Convênio)
        // =============================================
        if (tipo === 'convenio') {
            const obs = document.getElementById('observacoesConvenio').value.trim() || "Nenhuma observação informada.";
            const adendoFile = document.getElementById('adendoConvenio').files[0];

            yPos = addNewPdfPage(true);
            yPos += 30;
            doc.setFontSize(18);
            doc.setTextColor(0, 0, 255);
            doc.text('OBSERVAÇÕES / ADENDO', pageWidth / 2, yPos, { align: 'center' });
            doc.setTextColor(0, 0, 0);
            yPos += 15;

            doc.setFontSize(12);
            const obsLines = doc.splitTextToSize(obs, pageWidth - margin * 2);
            doc.text(obsLines, margin, yPos);
            yPos += obsLines.length * 7 + 15;

            // Se houver arquivo adendo
            if (adendoFile) {
                doc.setFontSize(14);
                doc.text("ADENDO / DOCUMENTO COMPROBATÓRIO ADICIONAL", pageWidth / 2, yPos, { align: "center" });
                yPos += 15;

                if (adendoFile.type.startsWith('image/')) {
                    const reader = new FileReader();
                    const imgData = await new Promise(resolve => {
                        reader.onload = () => resolve(reader.result);
                        reader.readAsDataURL(adendoFile);
                    });
                    const img = new Image();
                    img.src = imgData;
                    await new Promise(resolve => { img.onload = resolve; });

                    const maxWidth = pageWidth - 2 * margin;
                    const maxHeight = pageHeight - yPos - margin;
                    const ratio = Math.min(maxWidth / img.width, maxHeight / img.height);
                    const finalWidth = img.width * ratio;
                    const finalHeight = img.height * ratio;

                    doc.addImage(imgData, adendoFile.type.split('/')[1].toUpperCase(), (pageWidth - finalWidth)/2, yPos, finalWidth, finalHeight);
                    yPos += finalHeight + 10;

                    doc.setFontSize(10);
                    doc.setTextColor(100);
                    doc.text(`Arquivo: ${adendoFile.name} (${adendoFile.type})`, pageWidth / 2, yPos, { align: 'center' });
                    doc.setTextColor(0);
                } 
                else if (adendoFile.type === 'application/pdf') {
                    const pdfBytes = await adendoFile.arrayBuffer();
                    const pdf = await pdfjsLib.getDocument({ data: pdfBytes }).promise;

                    for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
                        if (yPos > pageHeight - 60) {
                            yPos = addNewPdfPage(true);
                            yPos += 20;
                        }

                        doc.setFontSize(10);
                        doc.setTextColor(100);
                        doc.text(`Adendo: ${adendoFile.name} - Página ${pageNum}/${pdf.numPages}`, margin, yPos);
                        yPos += 8;

                        const page = await pdf.getPage(pageNum);
                        const scale = 2.0;
                        const viewport = page.getViewport({ scale });

                        const canvas = document.createElement('canvas');
                        canvas.height = viewport.height;
                        canvas.width = viewport.width;
                        const context = canvas.getContext('2d');

                        await page.render({ canvasContext: context, viewport }).promise;

                        const imgData = canvas.toDataURL('image/jpeg', 0.92);

                        const maxW = pageWidth - 2 * margin;
                        const maxH = pageHeight - yPos - margin;
                        const ratio = Math.min(maxW / viewport.width, maxH / viewport.height);
                        const w = viewport.width * ratio;
                        const h = viewport.height * ratio;

                        doc.addImage(imgData, 'JPEG', (pageWidth - w)/2, yPos, w, h);

                        yPos += h + 15;

                        canvas.width = canvas.height = 0; // libera memória
                    }
                }
            }
        }

        // Nome do arquivo PDF
        const pdfName = `Atestado_Capacidade_Tecnica_${nomeEntidade.replace(/\s+/g, '_')}_${tipo}_${new Date().toISOString().slice(0,10)}.pdf`;
        doc.save(pdfName);
        alert('PDF gerado com sucesso!');

    } catch (error) {
        console.error("Erro na geração do PDF:", error);
        alert('Erro ao gerar o PDF. Verifique o console para detalhes.');
    } finally {
        document.getElementById('loadingOverlay').style.display = 'none';
    }
}
</script>
</body>
</html>