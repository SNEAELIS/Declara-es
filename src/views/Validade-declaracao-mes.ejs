const createDeclarationContent = (declaracao, dados, { withSignature = false } = {}) => {
    const contentStack = [
        { text: dados.nomeEntidade || 'Entidade não informada', style: 'entityName' },
        { text: `${dados.endereco || 'Endereço não informado'} - ${dados.cidadeUF || 'Município/UF não informado'} - CEP: ${dados.cep || 'CEP não informado'}`, style: 'entityAddress' },
        { canvas: [{ type: 'line', x1: 0, y1: 5, x2: 515, y2: 5, lineWidth: 0.5, lineColor: '#cccccc' }], margin: [0, 0, 0, 10] },
        { text: declaracao.title, style: 'header', alignment: 'center', margin: [0, 15, 0, 20] },
        { text: declaracao.content, alignment: 'justify', fontSize: 12, lineHeight: 1.15, margin: [0, 0, 0, 30] }
    ];

    if (withSignature) {
        contentStack.push({
            stack: [
                { text: `${dados.cidadeUF.split('/')[0].toUpperCase()}, 06 de agosto de 2025.`, alignment: 'center', fontSize: 11, margin: [0, 20, 0, 10] },
                { text: '__________________________________________', alignment: 'center', fontSize: 11, margin: [0, 10, 0, 5] },
                { text: dados.nome, alignment: 'center', bold: true, fontSize: 11 },
                { text: dados.cargo, alignment: 'center', italic: true, fontSize: 11 }
            ],
            unbreakable: true
        });
    }
    return { stack: contentStack };
};

const createLastPageContent = (declaracoes, dados) => {
    return {
        pageBreak: 'before',
        stack: [
            { text: dados.nomeEntidade || 'Entidade não informada', style: 'entityName' },
            { text: `${dados.endereco || 'Endereço não informado'} - ${dados.cidadeUF || 'Município/UF não informado'} - CEP: ${dados.cep || 'CEP não informado'}`, style: 'entityAddress' },
            { canvas: [{ type: 'line', x1: 0, y1: 5, x2: 515, y2: 5, lineWidth: 0.5, lineColor: '#cccccc' }], margin: [0, 0, 0, 10] },
            { text: 'DECLARAÇÕES REFERENCIAIS', style: 'header', alignment: 'center', margin: [0, 15, 0, 15] },
            { text: 'Relação das declarações contidas neste documento, assinadas eletronicamente na presente página.', style: 'subheader', margin: [0, 5, 0, 10] },
            {
                table: {
                    headerRows: 1,
                    widths: [40, '*'],
                    body: [
                        [{ text: 'Página', style: 'tableHeader' }, { text: 'Descrição', style: 'tableHeader' }],
                        ...declaracoes.map((decl, idx) => [
                            { text: `${idx + 1}`, alignment: 'center', fontSize: 9 },
                            { text: decl.title, linkToPage: idx + 1, decoration: 'underline', color: '#003087', fontSize: 9 }
                        ])
                    ]
                },
                layout: {
                    hLineWidth: (i, node) => (i === 0 || i === node.table.body.length) ? 1.5 : 0.5,
                    vLineWidth: () => 1, hLineColor: () => '#003087', vLineColor: () => '#003087',
                    paddingLeft: () => 5, paddingRight: () => 5, paddingTop: () => 2, paddingBottom: () => 2
                },
                margin: [0, 10, 0, 20]
            },
            { text: `Por ser verdade, firmo o teor das ${numToWords(declaracoes.length)} (${declaracoes.length}) declarações que compõem este arquivo:`, alignment: 'justify', fontSize: 11, margin: [0, 20, 0, 10] },
            {
                stack: [
                    { text: `${dados.cidadeUF.split('/')[0].toUpperCase()}, 06 de agosto de 2025.`, alignment: 'center', fontSize: 11, margin: [0, 20, 0, 10] },
                    { text: '__________________________________________', alignment: 'center', fontSize: 11, margin: [0, 10, 0, 5] },
                    { text: dados.nome, alignment: 'center', bold: true, fontSize: 11 },
                    { text: dados.cargo, alignment: 'center', italic: true, fontSize: 11 }
                ],
                unbreakable: true
            }
        ]
    };
};

const gerarPDFPrincipal = (declaracoes, dados, watermarkImage) => {
    return new Promise((resolve, reject) => {
        try {
            const allPagesContent = [];
            const isMultiPage = declaracoes.length > 1;

            if (isMultiPage) {
                declaracoes.forEach((decl, index) => {
                    const pageContent = createDeclarationContent(decl, dados, { withSignature: false });
                    if (index > 0) pageContent.pageBreak = 'before';
                    allPagesContent.push(pageContent);
                });
                allPagesContent.push(createLastPageContent(declaracoes, dados));
            } else {
                allPagesContent.push(createDeclarationContent(declaracoes[0], dados, { withSignature: true }));
            }

            const docDefinition = {
                pageSize: 'A4',
                pageMargins: [40, 80, 40, 80],
                background: () => watermarkImage ? { image: watermarkImage, width: 595.28, height: 841.89, absolutePosition: { x: 0, y: 0 } } : null,
                footer: (currentPage, pageCount) => {
                    let footerText = '';
                    if (pageCount > 1) {
                        footerText = (currentPage < pageCount)
                            ? declaracoes[currentPage - 1]?.footer
                            : `Documento composto por ${pageCount - 1} (${numToWords(pageCount - 1)}) declarações, assinado eletronicamente nesta página`;
                    } else {
                        footerText = declaracoes[0]?.footer;
                    }
                    if (!footerText) return null;
                    const isLongText = footerText.includes('RGF');
                    const mainTextAlign = isLongText ? 'justify' : 'left';
                    return {
                        margin: [40, 10, 40, 0],
                        stack: [
                            { canvas: [{ type: 'line', x1: 0, y1: 5, x2: 515, y2: 5, lineWidth: 0.5, lineColor: '#AAAAAA' }], margin: [0, 0, 0, 5] },
                            {
                                columns: [
                                    { text: footerText, alignment: mainTextAlign, fontSize: 8, color: '#555' },
                                    { text: `Página ${currentPage} de ${pageCount}`, alignment: 'right', fontSize: 8, color: '#555', width: 'auto' }
                                ]
                            }
                        ]
                    };
                },
                content: allPagesContent,
                styles: {
                    header: { fontSize: 12, bold: true, color: '#003087' },
                    subheader: { fontSize: 10, italic: true, color: '#333333' },
                    entityName: { bold: true, alignment: 'center', fontSize: 14, margin: [0, 0, 0, 2] },
                    entityAddress: { fontSize: 9, alignment: 'center', margin: [0, 0, 0, 5] },
                    tableHeader: { fontSize: 10, bold: true, color: '#FFFFFF', fillColor: '#003087', alignment: 'center' }
                },
                defaultStyle: { font: 'Roboto', alignment: 'justify' }
            };

            let fileName = '';
            if (isMultiPage) {
                fileName = `Declarações_COM_Envio_ao_TCE_${dados.nome.replace(/\s+/g, '_')}.pdf`;
            } else {
                const singleDeclId = declaracoes[0].id;
                if (singleDeclId === 'area_gestora_existe_taxa' || singleDeclId === 'area_gestora_inexiste_taxa') {
                    fileName = `Declaração_de_Área_Gestora_e_Inexistência_de_Legislação_${dados.nome.replace(/\s+/g, '_')}.pdf`;
                } else {
                    fileName = `Declaração_${dados.nome.replace(/\s+/g, '_')}.pdf`;
                }
            }

            pdfMake.createPdf(docDefinition).download(fileName, () => resolve());
        } catch (error) {
            reject(error);
        }
    });
};

const gerarPDFDeclaracaoSeparada = (declaracao, dados, watermarkImage) => {
    return new Promise((resolve, reject) => {
        gerarPDFPrincipal([declaracao], dados, watermarkImage).then(resolve).catch(reject);
    });
};

const processarGeracaoPDFs = async () => {
    toggleLoading(true, 'Gerando documento(s)...');
    try {
        const dados = {
            nome: document.getElementById('nomeResponsavel')?.value.trim() || '',
            cargo: document.getElementById('cargo')?.value || '',
            cnpj: document.getElementById('cnpj')?.value.trim() || '',
            cep: document.getElementById('cep')?.value.trim() || '',
            endereco: document.getElementById('endereco')?.value.trim() || '',
            complemento: document.getElementById('complemento')?.value.trim() || '',
            cidadeUF: document.getElementById('cidadeUF')?.value.trim() || '',
            nomeEstadoMunicipio: document.getElementById('nomeEstadoMunicipio')?.value.trim() || '',
            nomeEntidade: nomeEntidadeGlobal || document.getElementById('nomeEstadoMunicipio')?.value.trim() || ''
        };

        const configuracoes = {
            possuiAreaGestora: document.getElementById('possuiAreaGestora')?.checked || false,
            apresentaraCertidoes: document.getElementById('apresentaraCertidoes')?.checked || false,
            ate65milHabitantes: document.getElementById('ate65milHabitantes')?.checked || false,
            regularPrecatorios: document.getElementById('regularPrecatorios')?.checked || false
        };

        const declaracaoTipos = Array.from(document.querySelectorAll('input[name="declaracaoTipo"]:checked')).map(cb => cb.value);

        if (declaracaoTipos.length === 0) {
            throw new Error('Nenhum tipo de declaração foi selecionado na Aba 2.');
        }

        let todasDeclaracoesRequeridas = [];
        declaracaoTipos.forEach(opcao => {
            todasDeclaracoesRequeridas.push(...getDeclaracoes(opcao, dados, configuracoes));
        });

        todasDeclaracoesRequeridas = [...new Map(todasDeclaracoesRequeridas.map(item => [item.id, item])).values()];

        const declaracoesParaArquivoPrincipal = [];
        const declaracoesParaArquivoSeparado = [];

        todasDeclaracoesRequeridas.forEach(decl => {
            if (decl.id === 'area_gestora_inexiste_taxa' || decl.id === 'area_gestora_existe_taxa') {
                declaracoesParaArquivoSeparado.push(decl);
            } else {
                declaracoesParaArquivoPrincipal.push(decl);
            }
        });

        const watermarkImage = await getBase64ImageFromUrl('https://i.ibb.co/Lz10svWs/Declara-es-page-0001.jpg');
        let pdfsGerados = 0;

        if (declaracoesParaArquivoPrincipal.length > 0) {
            await gerarPDFPrincipal(declaracoesParaArquivoPrincipal, dados, watermarkImage);
            pdfsGerados++;
        }
        if (declaracoesParaArquivoSeparado.length > 0) {
            for (const decl of declaracoesParaArquivoSeparado) {
                await gerarPDFDeclaracaoSeparada(decl, dados, watermarkImage);
                pdfsGerados++;
            }
        }

        if (pdfsGerados > 0) {
            showPopup();
        } else {
            throw new Error('Nenhuma declaração foi gerada. Verifique suas seleções e os dados inseridos.');
        }

    } catch (error) {
        console.error('Erro ao gerar PDF(s):', error);
        alert(error.message || 'Ocorreu um erro ao gerar o(s) documento(s). Tente novamente.');
    } finally {
        toggleLoading(false);
    }
};

form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (validateTab(tabs[tabs.length - 1])) {
        await processarGeracaoPDFs();
    }
});

