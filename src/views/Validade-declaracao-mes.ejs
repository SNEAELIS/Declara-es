<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#1351b4">
    <meta name="description" content="Gerador de Declarações para Entidades Públicas — Ministério do Esporte. Padronizado conforme o Design System do Governo Federal (gov.br).">
    <title>Gerador de Declarações — Ministério do Esporte | gov.br</title>

    <!-- Fonte oficial gov.br: Rawline (com fallback Raleway) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdngovbr-ds.estaleiro.serpro.gov.br/design-system/fonts/rawline/css/rawline.css">
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">

    <style>
        /* ============================================================
           TOKENS — Design System do Governo Federal (gov.br / DSGov)
           Paleta Blue Warm Vivid, cinzas e cores de feedback oficiais.
           Conformidade de contraste mínima AA (WCAG 2.1).
           ============================================================ */
        :root {
            /* Marca / interativo */
            --blue-90: #051d41;
            --blue-80: #0c326f;
            --blue-70: #1351b4;   /* cor primária da identidade do Governo Federal */
            --blue-60: #155bcb;
            --blue-50: #2670e8;
            --blue-20: #c5d4eb;
            --blue-10: #e8eefa;
            --gold:    #ffcd07;    /* amarelo de destaque/foco gov.br */

            /* Feedback */
            --success: #168821;
            --danger:  #e52207;
            --warning: #c05600;
            --info:    #155bcb;

            /* Superfície e leitura */
            --pure-0:   #ffffff;
            --gray-2:   #f8f8f8;
            --gray-5:   #f0f0f0;
            --gray-10:  #e6e6e6;
            --gray-20:  #cccccc;
            --gray-40:  #9e9e9e;
            --gray-60:  #666666;
            --gray-80:  #333333;   /* texto sobre fundo claro */

            /* Semânticos da aplicação */
            --bg:            var(--gray-2);
            --surface:       var(--pure-0);
            --text:          var(--gray-80);
            --text-muted:    var(--gray-60);
            --border:        var(--gray-20);
            --accent:        var(--blue-70);
            --accent-hover:  var(--blue-80);
            --header-bg:     var(--pure-0);
            --footer-bg:     var(--blue-90);

            --radius:   8px;
            --shadow-1: 0 1px 3px rgba(0,0,0,.10);
            --shadow-2: 0 3px 6px rgba(0,0,0,.16);
            --focus:    0 0 0 4px var(--gold);
            --font-base: 'Rawline', 'Raleway', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        [data-theme="dark"] {
            --bg:           #0c1a2b;
            --surface:      #102845;
            --text:         #e9eef5;
            --text-muted:   #aebfd4;
            --border:       #244268;
            --accent:       #5a8bdd;
            --accent-hover: #7aa4e8;
            --header-bg:    #0a1626;
            --footer-bg:    #0a1626;
            --gray-2:       #0c1a2b;
            --gray-5:       #13294a;
            --pure-0:       #102845;
            --shadow-1: 0 1px 3px rgba(0,0,0,.5);
            --shadow-2: 0 3px 8px rgba(0,0,0,.6);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html { font-size: 100%; }
        body {
            font-family: var(--font-base);
            font-size: 1rem;
            background-color: var(--bg);
            color: var(--text);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            transition: background-color .3s ease, color .3s ease;
        }

        a { color: var(--accent); }

        /* Foco visível e padronizado (acessibilidade / eMAG) */
        a:focus-visible,
        button:focus-visible,
        input:focus-visible,
        select:focus-visible,
        .stepper-item:focus-visible {
            outline: none;
            box-shadow: var(--focus);
            border-radius: 4px;
        }

        /* Pular para o conteúdo */
        .skip-link {
            position: absolute; left: -999px; top: 0; z-index: 2000;
            background: var(--accent); color: #fff; padding: 10px 16px;
            border-radius: 0 0 var(--radius) 0; font-weight: 600;
        }
        .skip-link:focus { left: 0; }

        .container-lg { width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 24px; }

        /* ===================== CABEÇALHO gov.br ===================== */
        header.br-header {
            background: var(--header-bg);
            border-bottom: 1px solid var(--border);
            box-shadow: var(--shadow-1);
            position: sticky; top: 0; z-index: 1000;
        }
        .header-top {
            display: flex; align-items: center; justify-content: space-between;
            padding: 14px 0; gap: 16px;
        }
        .header-brand { display: flex; align-items: center; gap: 14px; min-width: 0; }
        .govbr-logo {
            font-family: var(--font-base);
            font-weight: 800; font-size: 1.7rem; letter-spacing: -.5px;
            color: var(--blue-80); text-decoration: none; line-height: 1; white-space: nowrap;
        }
        [data-theme="dark"] .govbr-logo { color: #cfe0ff; }
        .govbr-logo .dot { color: var(--blue-70); }
        .header-divider { width: 1px; height: 34px; background: var(--border); flex: 0 0 auto; }
        .header-sign {
            font-weight: 700; font-size: 1.05rem; color: var(--text);
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }
        .header-actions { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; }
        .header-btn {
            background: transparent; border: none; color: var(--accent);
            width: 44px; height: 44px; border-radius: 50%; cursor: pointer;
            font-size: 1.15rem; display: inline-flex; align-items: center; justify-content: center;
            transition: background .2s ease;
        }
        .header-btn:hover { background: var(--blue-10); }
        [data-theme="dark"] .header-btn:hover { background: rgba(255,255,255,.08); }

        .header-bottom { padding: 0 0 16px; }
        .header-title { font-weight: 700; font-size: 1.25rem; color: var(--text); }
        .header-subtitle { font-size: .9rem; color: var(--text-muted); margin-top: 2px; }

        /* ===================== BREADCRUMB ===================== */
        nav.br-breadcrumb { padding: 14px 0 0; }
        .br-breadcrumb ol { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: .85rem; }
        .br-breadcrumb li { display: inline-flex; align-items: center; gap: 6px; color: var(--text-muted); }
        .br-breadcrumb a { color: var(--accent); text-decoration: none; }
        .br-breadcrumb a:hover { text-decoration: underline; }
        .br-breadcrumb .sep { color: var(--gray-40); font-size: .7rem; }
        .br-breadcrumb [aria-current="page"] { color: var(--text); font-weight: 600; }

        /* ===================== CARTÃO PRINCIPAL ===================== */
        main { padding: 8px 0 56px; }
        .br-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow-1);
            padding: 32px 36px;
            margin-top: 18px;
        }
        .card-head { border-bottom: 2px solid var(--accent); padding-bottom: 16px; margin-bottom: 28px; }
        .card-head h1 { font-size: 1.6rem; font-weight: 700; color: var(--text); }
        .card-head .tag {
            display: inline-block; margin-top: 8px; font-size: .8rem; font-weight: 600;
            color: var(--accent); background: var(--blue-10); border: 1px solid var(--blue-20);
            padding: 3px 12px; border-radius: 100px;
        }
        [data-theme="dark"] .card-head .tag { background: rgba(90,139,221,.18); border-color: transparent; }

        /* ===================== STEPPER (passo a passo) ===================== */
        .stepper-nav { margin-bottom: 36px; }
        .stepper-wrapper { display: flex; justify-content: space-between; position: relative; }
        .stepper-wrapper::before {
            content: ''; position: absolute; top: 22px; left: 6%; right: 6%; height: 3px;
            background: var(--border); z-index: 0;
        }
        .stepper-progress {
            content: ''; position: absolute; top: 22px; left: 6%; height: 3px;
            background: var(--accent); z-index: 1; width: 0; transition: width .5s ease;
        }
        .stepper-item {
            display: flex; flex-direction: column; align-items: center; text-align: center;
            width: 33.33%; position: relative; z-index: 2; background: transparent; border: none;
        }
        .step-counter {
            width: 46px; height: 46px; border-radius: 50%;
            background: var(--surface); border: 3px solid var(--border); color: var(--gray-40);
            display: flex; justify-content: center; align-items: center;
            font-size: 1.1rem; font-weight: 700; transition: all .35s ease;
        }
        .step-name { font-size: .85rem; font-weight: 600; color: var(--text-muted); margin-top: 10px; }
        .stepper-item.active .step-counter {
            border-color: var(--accent); color: var(--accent); background: var(--surface); transform: scale(1.08);
        }
        .stepper-item.active .step-name { color: var(--text); }
        .stepper-item.completed .step-counter { background: var(--accent); border-color: var(--accent); color: #fff; }
        .stepper-item.completed { cursor: pointer; }
        .stepper-item.completed:hover .step-counter { box-shadow: 0 0 0 4px var(--blue-10); }

        /* ===================== ABAS / SEÇÕES ===================== */
        .tab { display: none; animation: fadeIn .35s ease; }
        .tab.active { display: block; }
        .section { margin-bottom: 22px; }
        .section h2 { font-size: 1.2rem; font-weight: 700; color: var(--text); margin-bottom: 6px; }
        .section h2::after {
            content: ''; display: block; width: 44px; height: 3px; background: var(--accent);
            border-radius: 2px; margin-top: 8px;
        }
        .section .helper { color: var(--text-muted); font-size: .92rem; margin-bottom: 18px; }

        .form-row { display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 6px; }
        .form-group { flex: 1; min-width: 240px; margin-bottom: 14px; }
        .full-width { flex-basis: 100%; }

        /* Campo de texto / select padrão gov.br */
        label {
            display: block; font-size: .9rem; font-weight: 600; color: var(--text); margin-bottom: 8px;
        }
        label .req { color: var(--danger); margin-left: 2px; }
        input[type="text"], select {
            width: 100%; height: 44px; padding: 0 14px;
            background: var(--surface); color: var(--text);
            border: 1px solid var(--gray-40); border-radius: var(--radius);
            font-family: var(--font-base); font-size: 1rem; transition: border-color .2s, box-shadow .2s;
        }
        input::placeholder { color: var(--gray-40); }
        input[readonly] { background: var(--gray-5); cursor: not-allowed; color: var(--text-muted); }
        input:focus, select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }

        select {
            -webkit-appearance: none; -moz-appearance: none; appearance: none;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%231351b4' stroke-width='3'><path d='M6 9l6 6 6-6'/></svg>");
            background-repeat: no-repeat; background-position: right 14px center; padding-right: 40px;
        }

        .error-message { display: none; color: var(--danger); font-size: .85rem; margin-top: 6px; }
        .error-message::before { content: '\f06a'; font-family: 'Font Awesome 6 Free'; font-weight: 900; margin-right: 6px; }
        .form-group.invalid input,
        .form-group.invalid select { border-color: var(--danger); box-shadow: 0 0 0 1px var(--danger); }
        .form-group.invalid .error-message { display: block; animation: shake .3s ease; }

        /* Checkbox padrão gov.br */
        .checkbox-group { display: flex; flex-direction: column; gap: 12px; }
        .checkbox-item {
            display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px;
            border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
            transition: border-color .2s, background .2s;
        }
        .checkbox-item:hover { border-color: var(--accent); background: var(--blue-10); }
        [data-theme="dark"] .checkbox-item:hover { background: rgba(90,139,221,.12); }
        .checkbox-item input[type="checkbox"] {
            width: 22px; height: 22px; margin-top: 1px; accent-color: var(--accent); cursor: pointer; flex: 0 0 auto;
        }
        .checkbox-item label { margin: 0; font-weight: 500; font-size: .95rem; cursor: pointer; }

        /* Botões padrão gov.br */
        .button-bar {
            display: flex; justify-content: space-between; gap: 14px;
            margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--border);
        }
        .br-button {
            display: inline-flex; align-items: center; justify-content: center; gap: 8px;
            height: 44px; padding: 0 24px; border: 2px solid transparent; border-radius: 100px;
            font-family: var(--font-base); font-size: .95rem; font-weight: 600; letter-spacing: .2px;
            cursor: pointer; transition: all .2s ease; white-space: nowrap;
        }
        .br-button.primary { background: var(--accent); color: #fff; }
        .br-button.primary:hover:not(:disabled) { background: var(--accent-hover); transform: translateY(-1px); box-shadow: var(--shadow-2); }
        .br-button.secondary { background: transparent; color: var(--accent); border-color: var(--accent); }
        .br-button.secondary:hover:not(:disabled) { background: var(--blue-10); }
        [data-theme="dark"] .br-button.secondary:hover:not(:disabled) { background: rgba(90,139,221,.14); }
        .br-button:disabled { background: var(--gray-20); color: var(--gray-60); border-color: transparent; cursor: not-allowed; opacity: .8; }

        /* ===================== OVERLAYS / MODAIS ===================== */
        .loading-overlay, .overlay {
            position: fixed; inset: 0; background: rgba(5,29,65,.55); z-index: 1001;
            display: flex; justify-content: center; align-items: center;
            opacity: 0; visibility: hidden; transition: opacity .3s, visibility .3s;
        }
        .loading-overlay p { color: #fff; font-size: 1.1rem; font-weight: 600; display: flex; align-items: center; gap: 12px; }
        .spinner {
            width: 26px; height: 26px; border: 3px solid rgba(255,255,255,.35);
            border-top-color: #fff; border-radius: 50%; animation: spin 1s linear infinite;
        }
        .popup {
            position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%) scale(.95);
            background: var(--surface); color: var(--text); border-radius: var(--radius);
            box-shadow: var(--shadow-2); border-top: 4px solid var(--accent);
            padding: 28px 36px; text-align: center; z-index: 1002; max-width: 92vw; width: 460px;
            opacity: 0; visibility: hidden; transition: opacity .3s, transform .3s, visibility .3s;
        }
        .popup.show, .overlay.show, .loading-overlay.show { opacity: 1; visibility: visible; }
        .popup.show { transform: translate(-50%,-50%) scale(1); }
        .popup h3 { font-size: 1.3rem; font-weight: 700; color: var(--accent); margin-bottom: 12px; }
        .popup p { font-size: 1rem; margin-bottom: 20px; }
        .popup .btn-row { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
        #fileList { list-style: none; padding: 0; margin: 16px 0; text-align: left; }
        #fileList li {
            font-size: .92rem; padding: 10px 12px 10px 36px; position: relative;
            background: var(--gray-5); border-radius: 6px; margin-bottom: 8px; word-break: break-all;
        }
        #fileList li::before {
            content: '\f1c1'; font-family: 'Font Awesome 6 Free'; font-weight: 900;
            position: absolute; left: 12px; top: 10px; color: var(--accent);
        }

        /* ===================== RODAPÉ gov.br ===================== */
        footer.br-footer { background: var(--footer-bg); color: #fff; }
        .footer-top { padding: 28px 0; border-bottom: 1px solid rgba(255,255,255,.15); }
        .footer-top .govbr-logo { color: #fff; }
        .footer-top .govbr-logo .dot { color: var(--gold); }
        .footer-sign { font-size: .95rem; color: rgba(255,255,255,.85); margin-top: 6px; }
        .footer-bottom { padding: 18px 0; font-size: .85rem; color: rgba(255,255,255,.8); display: flex; flex-wrap: wrap; gap: 6px 18px; justify-content: space-between; align-items: center; }
        .footer-bottom a { color: #fff; text-decoration: underline; font-weight: 600; }
        .footer-bottom a:hover { color: var(--gold); }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }
        @keyframes spin { to { transform: rotate(360deg); } }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: .001ms !important; transition-duration: .001ms !important; }
        }

        @media (max-width: 768px) {
            .container-lg { padding: 0 16px; }
            .br-card { padding: 22px 18px; }
            .card-head h1 { font-size: 1.3rem; }
            .header-sign { font-size: .9rem; }
            .form-row { flex-direction: column; gap: 0; }
            .button-bar { flex-direction: column-reverse; }
            .button-bar .br-button { width: 100%; }
            .step-name { font-size: .72rem; }
            .step-counter { width: 38px; height: 38px; font-size: .95rem; }
            .stepper-wrapper::before, .stepper-progress { top: 18px; }
        }
    </style>
</head>

<body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

    <!-- ===================== CABEÇALHO ===================== -->
    <header class="br-header">
        <div class="container-lg">
            <div class="header-top">
                <div class="header-brand">
                    <a class="govbr-logo" href="https://www.gov.br" target="_blank" rel="noopener" aria-label="Portal gov.br">gov<span class="dot">.</span>br</a>
                    <span class="header-divider" aria-hidden="true"></span>
                    <span class="header-sign">Ministério do Esporte</span>
                </div>
                <div class="header-actions">
                    <button class="header-btn" id="themeToggle" type="button" aria-label="Alternar tema claro/escuro" title="Alternar tema">
                        <i class="fas fa-adjust" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <div class="header-bottom">
                <div class="header-title">Gerador de Declarações</div>
                <div class="header-subtitle">Secretaria Executiva — Declarações de Entidades Públicas</div>
            </div>
        </div>
    </header>

    <!-- ===================== BREADCRUMB ===================== -->
    <div class="container-lg">
        <nav class="br-breadcrumb" aria-label="Você está em:">
            <ol>
                <li><a href="https://www.gov.br/esporte" target="_blank" rel="noopener">Início</a></li>
                <li><span class="sep" aria-hidden="true">›</span> Serviços</li>
                <li><span class="sep" aria-hidden="true">›</span> <span aria-current="page">Declaração de Entidade Pública</span></li>
            </ol>
        </nav>
    </div>

    <!-- ===================== CONTEÚDO ===================== -->
    <main id="conteudo" class="container-lg">
        <div class="br-card">
            <div class="card-head">
                <h1>Declaração de Entidade Pública</h1>
                <span class="tag"><i class="fas fa-file-signature" aria-hidden="true"></i>&nbsp; Emissão de documento</span>
            </div>

            <nav class="stepper-nav" aria-label="Etapas do preenchimento">
                <div class="stepper-wrapper">
                    <div class="stepper-progress" aria-hidden="true"></div>
                    <button type="button" class="stepper-item active" data-tab="aba1" aria-label="Etapa 1: Responsável">
                        <span class="step-counter"><i class="fa-solid fa-user" aria-hidden="true"></i></span>
                        <span class="step-name">Responsável</span>
                    </button>
                    <button type="button" class="stepper-item" data-tab="aba2" aria-label="Etapa 2: Entidade">
                        <span class="step-counter"><i class="fa-solid fa-building" aria-hidden="true"></i></span>
                        <span class="step-name">Entidade</span>
                    </button>
                    <button type="button" class="stepper-item" data-tab="aba3" aria-label="Etapa 3: Finalizar">
                        <span class="step-counter"><i class="fa-solid fa-file-pdf" aria-hidden="true"></i></span>
                        <span class="step-name">Finalizar</span>
                    </button>
                </div>
            </nav>

            <form id="declaracoesForm" novalidate>
                <!-- ETAPA 1 -->
                <div id="aba1" class="tab active">
                    <section class="section">
                        <h2>Dados do responsável</h2>
                        <p class="helper">Informe quem assinará as declarações.</p>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="nomeResponsavel">Nome do responsável <span class="req" aria-hidden="true">*</span></label>
                                <input type="text" id="nomeResponsavel" required autocomplete="name" placeholder="Nome completo">
                                <span class="error-message" aria-live="polite">Por favor, digite o nome completo.</span>
                            </div>
                            <div class="form-group">
                                <label for="cargo">Cargo <span class="req" aria-hidden="true">*</span></label>
                                <select id="cargo" required>
                                    <option value="Governador(a)">Governador(a)</option>
                                    <option value="Secretário(a) de Estado">Secretário(a) de Estado</option>
                                    <option value="Subsecretário(a) de Esporte">Subsecretário(a) de Esporte</option>
                                    <option value="Secretário(a) de Esporte">Secretário(a) de Esporte</option>
                                    <option value="Prefeito(a) do Município">Prefeito(a) do Município</option>
                                    <option value="Secretário(a) de Finanças">Secretário(a) de Finanças</option>
                                    <option value="Secretário(a) Municipal">Secretário(a) Municipal</option>
                                    <option value="Presidente">Presidente</option>
                                    <option value="Comandante-Geral">Comandante-Geral</option>
                                </select>
                                <span class="error-message" aria-live="polite">Por favor, selecione um cargo.</span>
                            </div>
                        </div>
                    </section>
                    <div class="button-bar" style="justify-content: flex-end;">
                        <button type="button" class="br-button primary nav-button" data-next-tab="aba2" disabled>Avançar <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                    </div>
                </div>

                <!-- ETAPA 2 -->
                <div id="aba2" class="tab">
                    <section class="section">
                        <h2>Dados da entidade</h2>
                        <p class="helper">Digite o CNPJ para preenchermos automaticamente o endereço.</p>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="cnpj">CNPJ <span class="req" aria-hidden="true">*</span></label>
                                <input type="text" id="cnpj" maxlength="18" inputmode="numeric" placeholder="00.000.000/0000-00" required>
                                <span class="error-message" aria-live="polite">Por favor, digite um CNPJ válido.</span>
                            </div>
                            <div class="form-group">
                                <label for="cep">CEP</label>
                                <input type="text" id="cep" maxlength="9" placeholder="Preenchido pelo CNPJ" readonly required>
                                <span class="error-message" aria-live="polite">CEP não encontrado.</span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group full-width">
                                <label for="endereco">Endereço (rua, número, bairro)</label>
                                <input type="text" id="endereco" placeholder="Preenchido pelo CNPJ" readonly required>
                                <span class="error-message" aria-live="polite">Endereço não encontrado.</span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="complemento">Complemento</label>
                                <input type="text" id="complemento" autocomplete="address-line2" placeholder="Ex.: Bloco A, Sala 101">
                            </div>
                            <div class="form-group">
                                <label for="cidadeUF">Cidade/UF</label>
                                <input type="text" id="cidadeUF" placeholder="Preenchido pelo CNPJ" readonly required>
                                <span class="error-message" aria-live="polite">Cidade/UF não encontrada.</span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group full-width">
                                <label for="nomeEstadoMunicipio">Nome do estado ou município</label>
                                <input type="text" id="nomeEstadoMunicipio" placeholder="Preenchido pelo CNPJ" readonly required>
                                <span class="error-message" aria-live="polite">Nome não encontrado.</span>
                            </div>
                        </div>
                    </section>

                    <section class="section">
                        <h2>Origem do recurso</h2>
                        <p class="helper">Selecione a classificação aplicável.</p>
                        <div class="checkbox-group" id="declaracaoTipoGroup">
                            <div class="checkbox-item">
                                <input type="checkbox" id="emenda" name="declaracaoTipo" value="20JP_00SL_emenda">
                                <label for="emenda">20JP - 00SL — Emenda Individual e Bancada</label>
                            </div>
                            <div class="checkbox-item">
                                <input type="checkbox" id="comissao" name="declaracaoTipo" value="20JP_00SL_comissao">
                                <label for="comissao">20JP - 00SL — Discricionário e Comissão</label>
                            </div>
                        </div>
                    </section>

                    <div class="button-bar">
                        <button type="button" class="br-button secondary nav-button" data-prev-tab="aba1"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Voltar</button>
                        <button type="button" class="br-button primary nav-button" data-next-tab="aba3" disabled>Avançar <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                    </div>
                </div>

                <!-- ETAPA 3 -->
                <div id="aba3" class="tab">
                    <section class="section">
                        <h2>Configuração das declarações</h2>
                        <p class="helper">Marque as opções que correspondem à realidade do seu município.</p>
                        <div class="checkbox-group" id="configuracoesGroup">
                            <!-- Preenchido dinamicamente conforme a origem do recurso -->
                        </div>
                    </section>
                    <div class="button-bar">
                        <button type="button" class="br-button secondary nav-button" data-prev-tab="aba2"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Voltar</button>
                        <button type="submit" class="br-button primary" id="gerarPDFBtn"><i class="fa-solid fa-check" aria-hidden="true"></i> Gerar PDF</button>
                    </div>
                </div>
            </form>

            <div id="loadingMessage" class="loading-overlay" aria-hidden="true" role="status">
                <p>Aguarde... <span class="spinner" aria-hidden="true"></span></p>
            </div>
        </div>
    </main>

    <!-- ===================== POPUPS ===================== -->
    <div id="successPopup" class="popup" role="alert" aria-hidden="true">
        <h3><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Tudo certo</h3>
        <p>Documento(s) baixado(s) com sucesso!</p>
        <div class="btn-row"><button class="br-button primary" id="closePopupBtn" type="button">Fechar</button></div>
    </div>

    <div id="overlay" class="overlay" aria-hidden="true"></div>

    <div id="confirmationPopup" class="popup" role="alertdialog" aria-modal="true" aria-labelledby="confTitle" aria-hidden="true">
        <h3 id="confTitle">Arquivos a serem baixados</h3>
        <p>Os seguintes documentos serão gerados:</p>
        <ul id="fileList"></ul>
        <div class="btn-row">
            <button class="br-button secondary" id="cancelPopupBtn" type="button">Cancelar</button>
            <button class="br-button primary" id="confirmDownloadBtn" type="button"><i class="fa-solid fa-check" aria-hidden="true"></i> Ciente</button>
        </div>
    </div>

    <!-- ===================== RODAPÉ ===================== -->
    <footer class="br-footer">
        <div class="container-lg">
            <div class="footer-top">
                <a class="govbr-logo" href="https://www.gov.br" target="_blank" rel="noopener" aria-label="Portal gov.br">gov<span class="dot">.</span>br</a>
                <div class="footer-sign">Ministério do Esporte — Secretaria Executiva</div>
            </div>
            <div class="footer-bottom">
                <span>© 2026 Ministério do Esporte. Todos os direitos reservados.</span>
                <span><a href="https://www.esporte.gov.br" target="_blank" rel="noopener noreferrer">Acesse o portal do Ministério do Esporte</a></span>
            </div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // --- UI and Form Handling ---
        const form = document.getElementById('declaracoesForm');
        const themeToggle = document.getElementById('themeToggle');
        const cnpjInput = document.getElementById('cnpj');
        const navButtons = document.querySelectorAll('.nav-button');
        const stepperItems = document.querySelectorAll('.stepper-item');
        const progress = document.querySelector('.stepper-progress');
        const successPopup = document.getElementById('successPopup');
        const closePopupBtn = document.getElementById('closePopupBtn');
        const overlay = document.getElementById('overlay');
        const loadingMessage = document.getElementById('loadingMessage');
        const tabs = ['aba1', 'aba2', 'aba3'];
        let nomeEntidadeGlobal = '';

        const applyTheme = (theme) => {
            document.body.dataset.theme = theme;
            themeToggle.setAttribute('aria-label', `Mudar para tema ${theme === 'light' ? 'escuro' : 'claro'}`);
        };

        themeToggle.addEventListener('click', () => {
            const currentTheme = document.body.dataset.theme === 'light' ? 'dark' : 'light';
            localStorage.setItem('theme', currentTheme);
            applyTheme(currentTheme);
        });

        applyTheme(localStorage.getItem('theme') || 'light');

        const updateStepper = (currentTabIndex) => {
            stepperItems.forEach((item, index) => {
                const counter = item.querySelector('.step-counter');
                item.classList.remove('active', 'completed');
                const icons = ['<i class="fa-solid fa-user" aria-hidden="true"></i>', '<i class="fa-solid fa-building" aria-hidden="true"></i>', '<i class="fa-solid fa-file-pdf" aria-hidden="true"></i>'];
                if (index < currentTabIndex) {
                    item.classList.add('completed');
                    counter.innerHTML = '<i class="fa-solid fa-check" aria-hidden="true"></i>';
                } else if (index === currentTabIndex) {
                    item.classList.add('active');
                    counter.innerHTML = icons[index];
                } else {
                    counter.innerHTML = icons[index];
                }
            });
            const progressWidth = (currentTabIndex / (stepperItems.length - 1)) * 88;
            progress.style.width = `${progressWidth}%`;
        };

        const showTab = (tabId) => {
            document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
            document.getElementById(tabId)?.classList.add('active');
            const currentTabIndex = tabs.indexOf(tabId);
            updateStepper(currentTabIndex);
            if (tabId === 'aba3') {
                updateConfiguracoesCheckboxes();
            }
        };

        stepperItems.forEach(item => {
            item.addEventListener('click', () => {
                if (item.classList.contains('completed')) {
                    showTab(item.dataset.tab);
                }
            });
        });

        navButtons.forEach(button => {
            button.addEventListener('click', () => {
                const targetTabId = button.dataset.nextTab || button.dataset.prevTab;
                if (button.dataset.nextTab && !validateTab(button.closest('.tab').id)) {
                    return;
                }
                showTab(targetTabId);
            });
        });

        const validateInput = (input) => {
            const formGroup = input.closest('.form-group');
            let isValid = input.checkValidity() && input.value.trim() !== '';
            if (input.id === 'nomeResponsavel') {
                const nameValue = input.value.trim();
                if (nameValue.split(' ').length < 2) {
                    isValid = false;
                    const errorMessage = formGroup.querySelector('.error-message');
                    if (errorMessage) errorMessage.textContent = 'Por favor, digite o nome completo (nome e sobrenome).';
                } else {
                    const errorMessage = formGroup.querySelector('.error-message');
                    if (errorMessage) errorMessage.textContent = '';
                }
            }
            if (!isValid) {
                formGroup.classList.add('invalid');
                return false;
            }
            formGroup.classList.remove('invalid');
            return true;
        };

        const validateTab = (tabId) => {
            const tab = document.getElementById(tabId);
            if (!tab) return false;
            let isTabValid = true;
            if (tabId === 'aba1' || tabId === 'aba2') {
                const inputs = tab.querySelectorAll('input[required], select[required]');
                inputs.forEach(input => {
                    if (!validateInput(input)) isTabValid = false;
                });
            }
            const nextButton = tab.querySelector('.nav-button[data-next-tab]');
            if (nextButton) nextButton.disabled = !isTabValid;
            return isTabValid;
        };

        form.addEventListener('input', (e) => {
            if (e.target.hasAttribute('required')) {
                validateTab(e.target.closest('.tab').id);
            }
        });

        cnpjInput.addEventListener('input', (e) => {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length > 14) value = value.substring(0, 14);
            value = value.replace(/^(\d{2})(\d)/, '$1.$2');
            value = value.replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3');
            value = value.replace(/\.(\d{3})(\d)/, '.$1/$2');
            value = value.replace(/(\d{4})(\d)/, '$1-$2');
            e.target.value = value;
            if (value.length === 18) fetchCNPJData(value.replace(/\D/g, ''));
        });

        const fetchCNPJData = async (cnpj) => {
            toggleLoading(true, 'Buscando dados do CNPJ...');
            const errorSpan = cnpjInput.nextElementSibling;
            try {
                const response = await fetch(`https://brasilapi.com.br/api/cnpj/v1/${cnpj}`);
                if (!response.ok) throw new Error('CNPJ não encontrado ou inválido.');
                const data = await response.json();
                nomeEntidadeGlobal = data.razao_social || data.municipio || '';
                document.getElementById('cep').value = data.cep?.replace(/(\d{5})(\d{3})/, '$1-$2') || '';
                document.getElementById('endereco').value = `${data.logradouro || ''}, ${data.numero || ''}, ${data.bairro || ''}`.trim().replace(/^,|,$/g, '');
                document.getElementById('cidadeUF').value = `${data.municipio || ''}/${data.uf || ''}`;
                document.getElementById('nomeEstadoMunicipio').value = data.razao_social || data.municipio || '';
            } catch (error) {
                console.error('Erro ao buscar CNPJ:', error);
                nomeEntidadeGlobal = '';
                const formGroup = cnpjInput.closest('.form-group');
                formGroup.classList.add('invalid');
                errorSpan.textContent = error.message;
                ['cep', 'endereco', 'cidadeUF', 'nomeEstadoMunicipio'].forEach(id => document.getElementById(id).value = '');
            } finally {
                toggleLoading(false);
                validateTab('aba2');
            }
        };

        const toggleLoading = (show, text = 'Aguarde um momento...') => {
            const p = loadingMessage.querySelector('p');
            if (p) p.firstChild.textContent = text;
            loadingMessage.classList.toggle('show', show);
        };

        const showPopup = () => {
            successPopup.classList.add('show');
            overlay.classList.add('show');
        };

        const closePopup = () => {
            successPopup.classList.remove('show');
            overlay.classList.remove('show');
        };

        closePopupBtn.addEventListener('click', closePopup);
        overlay.addEventListener('click', closePopup);

        const updateConfiguracoesCheckboxes = () => {
            const configuracoesGroup = document.getElementById('configuracoesGroup');
            if (!configuracoesGroup) return;
            configuracoesGroup.innerHTML = '';
            const emendaChecked = document.getElementById('emenda')?.checked || false;
            const comissaoChecked = document.getElementById('comissao')?.checked || false;

            const checkboxes = [
                { id: 'possuiAreaGestora', label: 'O município possui área gestora dos recursos recebidos por transferência voluntária da União?', show: emendaChecked || comissaoChecked },
                { id: 'apresentaraCertidoes', label: 'O Município apresentará as Certidões emitidas pelo Tribunal de Justiça (TJ), Tribunal Regional do Trabalho (TRT) e Tribunal Regional Federal (TRF)?', show: comissaoChecked },
                { id: 'ate65milHabitantes', label: 'O município possui até 65 mil habitantes?', show: comissaoChecked },
                { id: 'regularPrecatorios', label: 'O município está regular quanto à destinação dos precatórios correspondentes ao rateio dos percentuais destinados aos profissionais do magistério e aos demais profissionais da educação básica?', show: comissaoChecked }
            ];

            checkboxes.forEach(cb => {
                if (cb.show) {
                    const div = document.createElement('div');
                    div.className = 'checkbox-item';
                    div.innerHTML = `
                        <input type="checkbox" id="${cb.id}" name="configuracoes">
                        <label for="${cb.id}">${cb.label}</label>
                    `;
                    configuracoesGroup.appendChild(div);
                }
            });
        };

        document.querySelectorAll('input[name="declaracaoTipo"]').forEach(checkbox => {
            checkbox.addEventListener('change', () => {
                validateTab('aba2');
                if (document.getElementById('aba3').classList.contains('active')) {
                    updateConfiguracoesCheckboxes();
                }
            });
        });

        // --- PDF Generation Logic ---

        const getBase64ImageFromUrl = (url) => new Promise((resolve) => {
            const img = new Image();
            img.crossOrigin = 'Anonymous';
            img.onload = () => {
                const canvas = document.createElement('canvas');
                canvas.width = img.width;
                canvas.height = img.height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0);
                resolve(canvas.toDataURL('image/jpeg'));
            };
            img.onerror = () => resolve(null);
            img.src = url;
        });

        function numToWords(num) {
            const units = ['', 'uma', 'duas', 'três', 'quatro', 'cinco', 'seis', 'sete', 'oito', 'nove', 'dez', 'onze', 'doze'];
            if (num >= 0 && num < units.length) return units[num];
            return String(num);
        }

const getDeclaracoes = (opcao, dados, configuracoes) => {
            const { nome, cargo, nomeEstadoMunicipio, cnpj, endereco, complemento, cep, cidadeUF } = dados;
            const fullAddress = `${endereco}${complemento ? `, ${complemento}` : ''}`;
            const uf = cidadeUF.split('/')[1] || 'UF';
            const novoTextoRodapeLongo = 'Declaração válida até a data limite de publicação do Relatório de Gestão Fiscal-RGF (ou Relatório Resumido da Execução Orçamentária – RREO subsequente - 30 dias após o encerramento do quadrimestre, juntamente com o comprovante de remessa da Declaração ao Tribunal de Contas)';
            const representanteText = cargo === 'Comandante-Geral' ? 'Representante' : `Representante do ${nomeEstadoMunicipio}`;
            const entityText = cargo === 'Comandante-Geral' ? '' : `${nomeEstadoMunicipio}/${uf}`;
            const addressText = cargo === 'Comandante-Geral' ? '' : `, endereço ${fullAddress}, CEP ${cep}, ${cidadeUF}`;

            const declaracoesBase = {
                area_gestora_existe_taxa: {
                    id: 'area_gestora_existe_taxa',
                    title: 'DECLARAÇÃO DE EXISTÊNCIA DE ÁREA GESTORA DOS RECURSOS RECEBIDOS POR TRANSFERÊNCIA VOLUNTÁRIA DA UNIÃO E INEXISTÊNCIA DE LEGISLAÇÃO DO PROPONENTE, NA LOCALIDADE DE EXECUÇÃO DO OBJETO, QUE ESTABELEÇA A COBRANÇA DE TAXA DE ADMINISTRAÇÃO DE CONTRATO\nINCISOS VII E XXXIV DO ART. 29 DA PC 33, DE 2023',
                    content: `Eu, ${nome}, na condição de ${representanteText}, CNPJ nº ${cnpj}, declaro para os devidos fins de celebração de Convênio no âmbito do Ministério do Esporte - MESP, em cumprimento aos incisos VII e XXXIV do art. 29 da Portaria Conjunta MGI/MF/CGU Nº 33, de 30 de agosto de 2023, sob as penas da lei, que${entityText ? ` o Município de ${entityText}${addressText}` : ''}:\na) possui área gestora dos recursos recebidos por transferência voluntária da União, com atribuições definidas para gestão, celebração, execução e prestação de contas, com lotação de, no mínimo, um servidor ou empregado público efetivo; e\nb) inexiste legislação do proponente, na localidade de execução do objeto, que estabeleça a cobrança de taxa de administração de contrato, em consonância com a vedação do art. 21, parágrafo único, inciso I, da Portaria Conjunta nº 33/2023.`,
                    footer: 'Declaração válida somente no mês da assinatura'
                },
                area_gestora_inexiste_taxa: {
                    id: 'area_gestora_inexiste_taxa',
                    title: 'DECLARAÇÃO DE INEXISTÊNCIA DE ÁREA GESTORA DOS RECURSOS RECEBIDOS POR TRANSFERÊNCIA VOLUNTÁRIA DA UNIÃO E INEXISTÊNCIA DE LEGISLAÇÃO DO PROPONENTE, NA LOCALIDADE DE EXECUÇÃO DO OBJETO, QUE ESTABELEÇA A COBRANÇA DE TAXA DE ADMINISTRAÇÃO DE CONTRATO\n§ 17 E INCISO XXXIV DO ART. 29 DA PC 33, DE 2023',
                    content: `Eu, ${nome}, na condição de ${representanteText}, CNPJ nº ${cnpj}, declaro para os devidos fins de celebração de Convênio no âmbito do Ministério do Esporte - MESP, em cumprimento ao § 17 e inciso XXXIV do art. 29 da Portaria Conjunta MGI/MF/CGU Nº 33, de 30 de agosto de 2023, sob as penas da lei, que${entityText ? ` o Município de ${entityText}${addressText}` : ''}:\na) não possui área gestora dos recursos recebidos por transferência voluntária da União, com atribuições definidas para gestão, celebração, execução e prestação de contas, assim, atribuirá a competência pela gestão dos recursos recebidos por transferência voluntária da União a outro setor que possua, no mínimo, um servidor ou empregado público efetivo; e\nb) inexiste legislação do proponente, na localidade de execução do objeto, que estabeleça a cobrança de taxa de administração de contrato, em consonância com a vedação do art. 21, parágrafo único, inciso I, da Portaria Conjunta nº 33/2023.`,
                    footer: 'Declaração válida somente no mês da assinatura'
                },
                precatorios_judiciais: {
                    id: 'precatorios_judiciais',
                    title: 'DECLARAÇÃO DE REGULARIDADE NO PAGAMENTO DE PRECATÓRIOS JUDICIAIS\nINCISO II c/c § 6º DO ART. 29 DA PC 33, DE 2023',
                    content: `Eu, ${nome}, na condição de ${representanteText}, CNPJ nº ${cnpj}, declaro para os devidos fins de celebração de Convênio no âmbito do Ministério do Esporte - MESP, em cumprimento ao disposto no inciso II c/c §6º do art. 29 da Portaria Conjunta MGI/MF/CGU Nº 33, de 30 de agosto de 2023, sob as penas da lei, que${entityText ? ` o Município de ${entityText}${addressText}` : ''} está regular quanto ao pagamento de precatórios judiciais, nos termos do art. 104, do Ato das Disposições Constitucionais Transitórias.`,
                    footer: 'Declaração válida somente no mês da assinatura, juntamente com o comprovante de remessa da Declaração ao Tribunal de Contas'
                },
                empresas_publicas: {
                    id: 'empresas_publicas',
                    title: 'DECLARAÇÃO DE REGULARIDADE NO FORNECIMENTO DA RELAÇÃO DAS EMPRESAS PÚBLICAS E DAS SOCIEDADES DE ECONOMIA MISTA AO REGISTRO PÚBLICO DE EMPRESAS MERCANTIS E ATIVIDADES AFINS E REGULARIDADE NA CONTRATAÇÃO DE OPERAÇÃO DE CRÉDITO COM INSTITUIÇÃO FINANCEIRA\nINCISOS XX E XXXII DO ART. 29 DA PC 33, DE 2023',
                    content: `Eu, ${nome}, na condição de ${representanteText}, CNPJ nº ${cnpj}, declaro para os devidos fins de celebração de Convênio no âmbito do Ministério do Esporte - MESP, em cumprimento aos incisos XX e XXXII do art. 29 da Portaria Conjunta MGI/MF/CGU Nº 33, de 30 de agosto de 2023, sob as penas da lei, que${entityText ? ` o Município de ${entityText}${addressText}` : ''} encontra-se:\na) regular no fornecimento da relação das empresas públicas e das sociedades de economia mista junto ao Registro Público de Empresas Mercantis e Atividades Afins, nos termos do art. 92 da Lei nº 13.303, de 30 de junho de 2016; e\nb) regular na contratação de operação de crédito com instituição financeira, nos termos do art. 33 da Lei Complementar nº 101, de 4 de maio de 2000.`,
                    footer: 'Declaração válida somente no mês da assinatura, juntamente com o comprovante de remessa da Declaração ao Tribunal de Contas'
                },
                limites_cumprimento: {
                    id: 'limites_cumprimento',
                    title: (configuracoes.ate65milHabitantes)
                        ? 'DECLARAÇÃO DE REGULARIDADE NO CUMPRIMENTO DE LIMITES\nINCISO XXXI DO ART 29 DA PC 33, DE 2023'
                        : 'DECLARAÇÃO DE REGULARIDADE NO CUMPRIMENTO DE LIMITES\nINCISOS XXIX, XXX e XXXI DO ART 29 DA PC 33, DE 2023',
                    content: (configuracoes.ate65milHabitantes)
                        ? `Eu, ${nome}, na condição de ${representanteText}, CNPJ nº ${cnpj}, declaro para os devidos fins de celebração de Convênio no âmbito do Ministério do Esporte - MESP, em cumprimento ao inciso XXXI, do art. 29 da Portaria Conjunta MGI/MF/CGU Nº 33, de 30 de agosto de 2023, sob as penas da lei, que${entityText ? ` o Município de ${entityText}${addressText}` : ''} encontra-se regular:\nI. no cumprimento do limite de despesa total com pessoal de todos os Poderes e órgãos listados no art. 20 da Lei Complementar nº 101, de 4 de maio de 2000, inclusive as Defensorias Públicas, nos termos do art. 169, § 2º, da Constituição Federal, e do art. 25, § 1º, inciso IV, alínea "c", da Lei Complementar nº 101, de 4 de maio de 2000.`
                        : `Eu, ${nome}, na condição de ${representanteText}, CNPJ nº ${cnpj}, declaro para os devidos fins de celebração de Convênio no âmbito do Ministério do Esporte - MESP, em cumprimento aos incisos XXIX, XXX e XXXI, do art. 29 da Portaria Conjunta MGI/MF/CGU Nº 33, de 30 de agosto de 2023, sob as penas da lei, que${entityText ? ` o Município de ${entityText}${addressText}` : ''} encontra-se regular:\nI. no cumprimento do limite das dívidas consolidada e mobiliária, nos termos do art. 25, § 1º, inciso IV, alínea "c", da Lei Complementar nº 101, de 4 de maio de 2000;\nII. no cumprimento do limite de inscrição em restos a pagar, nos termos do art. 25, § 1º, inciso IV, alínea "c", da Lei Complementar nº 101, de 4 de maio de 2000; e\nIII. no cumprimento do limite de despesa total com pessoal de todos os Poderes e órgãos listados no art. 20 da Lei Complementar nº 101, de 4 de maio de 2000, inclusive as Defensorias Públicas, nos termos do art. 169, § 2º, da Constituição Federal, e do art. 25, § 1º, inciso IV, alínea "c", da Lei Complementar nº 101, de 4 de maio de 2000.`,
                    footer: novoTextoRodapeLongo
                },
                precatorios_educacao_regular: {
                    id: 'precatorios_educacao_regular',
                    title: 'DECLARAÇÃO DE REGULARIDADE NA DESTINAÇÃO DOS PRECATÓRIOS CORRESPONDENTES AO RATEIO DOS PERCENTUAIS DESTINADOS AOS PROFISSIONAIS DO MAGISTÉRIO E AOS DEMAIS PROFISSIONAIS DA EDUCAÇÃO BÁSICA\nINCISO XXXIII DO ART. 29 DA PC 33, DE 2023',
                    content: `Eu, ${nome}, na condição de ${representanteText}, CNPJ: ${cnpj}, declaro, sob as penas da lei, que${entityText ? ` o Município de ${entityText}` : ''} encontra-se regular quanto à destinação dos precatórios correspondentes ao rateio dos percentuais destinados aos profissionais do magistério e aos demais profissionais da educação básica, estabelecido no art. 47-A, §§ 1º e 2º, da Lei nº 14.113, de 25 de dezembro de 2020, e no art. 3º da Lei nº 14.325, de 12 de abril de 2022.`,
                    footer: 'Declaração válida somente no mês da assinatura, juntamente com o comprovante de remessa da Declaração ao Tribunal de Contas'
                },
                precatorios_educacao_ausencia: {
                    id: 'precatorios_educacao_ausencia',
                    title: 'DECLARAÇÃO DE AUSÊNCIA DE PRECATÓRIOS CORRESPONDENTES AO RATEIO DOS PERCENTUAIS DESTINADOS AOS PROFISSIONAIS DO MAGISTÉRIO E AOS DEMAIS PROFISSIONAIS DA EDUCAÇÃO BÁSICA\n§ 16 DO ART. 29 DA PC 33, DE 2023',
                    content: `Eu, ${nome}, na condição de ${representanteText}, CNPJ nº ${cnpj}, declaro para os devidos fins de celebração de Convênio no âmbito do Ministério do Esporte - MESP, em cumprimento ao § 16 do art. 29 da Portaria Conjunta MGI/MF/CGU Nº 33, de 30 de agosto de 2023, sob as penas da lei, que${entityText ? ` o Município de ${entityText}${addressText}` : ''} encontra-se inexistente da obrigação referente aos precatórios correspondentes ao rateio dos percentuais destinados aos profissionais do magistério e aos demais profissionais da educação básica, estabelecido no art. 47-A, §§ 1º e 2º, da Lei nº 14.113, de 2020, e no art. 3º da Lei nº 14.325, de 2022.`,
                    footer: 'Declaração válida somente no mês da assinatura, juntamente com o comprovante de remessa da Declaração ao Tribunal de Contas'
                }
            };

        let declaracoesSelecionadas = [];

            if (opcao === '20JP_00SL_emenda') {
                if (configuracoes.possuiAreaGestora) {
                    declaracoesSelecionadas.push(declaracoesBase.area_gestora_existe_taxa);
                } else {
                    declaracoesSelecionadas.push(declaracoesBase.area_gestora_inexiste_taxa);
                }
            } else if (opcao === '20JP_00SL_comissao') {
                if (!configuracoes.apresentaraCertidoes) {
                    declaracoesSelecionadas.push(declaracoesBase.precatorios_judiciais);
                }
                declaracoesSelecionadas.push(declaracoesBase.empresas_publicas);
                declaracoesSelecionadas.push(declaracoesBase.limites_cumprimento);
                if (configuracoes.regularPrecatorios) {
                    declaracoesSelecionadas.push(declaracoesBase.precatorios_educacao_regular);
                } else {
                    declaracoesSelecionadas.push(declaracoesBase.precatorios_educacao_ausencia);
                }
                if (configuracoes.possuiAreaGestora) {
                    declaracoesSelecionadas.push(declaracoesBase.area_gestora_existe_taxa);
                } else {
                    declaracoesSelecionadas.push(declaracoesBase.area_gestora_inexiste_taxa);
                }
            }
            return declaracoesSelecionadas.filter(d => d);
        };

const createDeclarationContent = (declaracao, dados, { withSignature = false } = {}) => {
    const contentStack = [
        { text: dados.nomeEntidade || 'Entidade não informada', style: 'entityName' },
        { text: `${dados.endereco || 'Endereço não informado'} - ${dados.cidadeUF || 'Município/UF não informado'} - CEP: ${dados.cep || 'CEP não informado'}`, style: 'entityAddress' },
        { canvas: [{ type: 'line', x1: 0, y1: 5, x2: 515, y2: 5, lineWidth: 0.5, lineColor: '#cccccc' }], margin: [0, 0, 0, 10] },
        { text: declaracao.title, style: 'header', alignment: 'center', margin: [0, 15, 0, 20] },
        { text: declaracao.content, alignment: 'justify', fontSize: 12, lineHeight: 1.15, margin: [0, 0, 0, 30] }
    ];

if (withSignature) {
    const meses = [
        'janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho',
        'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'
    ];

    const hoje = new Date();
    const dia = String(hoje.getDate()).padStart(2, '0');
    const mes = meses[hoje.getMonth()];
    const ano = hoje.getFullYear();

    contentStack.push({
        stack: [
            {
                text: `${dados.cidadeUF.split('/')[0].toUpperCase()}, na data da assinatura eletrônica.`,
                alignment: 'center',
                fontSize: 11,
                margin: [0, 20, 0, 10]
            },
            { text: '__________________________________________', alignment: 'center', fontSize: 11, margin: [0, 10, 0, 5] },
            { text: dados.nome, alignment: 'center', bold: true, fontSize: 11 },
            { text: dados.cargo, alignment: 'center', italic: true, fontSize: 11 }
        ],
        unbreakable: true
    });
}
    return { stack: contentStack };
};

const createLastPageContent = (declaracoes, dados) => {
    function formatarDataAtual() {
    const meses = [
        'janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho',
        'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'
    ];
    const hoje = new Date();
    const dia = String(hoje.getDate()).padStart(2, '0');
    const mes = meses[hoje.getMonth()];
    const ano = hoje.getFullYear();
    return `${dia} de ${mes} de ${ano}`;
}
return {
    pageBreak: 'before',
    stack: [
        { text: dados.nomeEntidade || 'Entidade não informada', style: 'entityName' },
        { text: `${dados.endereco || 'Endereço não informado'} - ${dados.cidadeUF || 'Município/UF não informado'} - CEP: ${dados.cep || 'CEP não informado'}`, style: 'entityAddress' },
        { canvas: [{ type: 'line', x1: 0, y1: 5, x2: 515, y2: 5, lineWidth: 0.5, lineColor: '#cccccc' }], margin: [0, 0, 0, 10] },
        { text: 'DECLARAÇÕES REFERENCIAIS', style: 'header', alignment: 'center', margin: [0, 15, 0, 15] },
        { text: 'Relação das declarações contidas neste documento, assinadas eletronicamente na presente página.', style: 'subheader', margin: [0, 5, 0, 10] },
        {
            table: {
                headerRows: 1,
                widths: [40, '*'],
                body: [
                    [{ text: 'Página', style: 'tableHeader' }, { text: 'Descrição', style: 'tableHeader' }],
                    ...declaracoes.map((decl, idx) => [
                        { text: `${idx + 1}`, alignment: 'center', fontSize: 9 },
                        { text: decl.title, linkToPage: idx + 1, decoration: 'underline', color: '#1351b4', fontSize: 9 }
                    ])
                ]
            },
            layout: {
                hLineWidth: (i, node) => (i === 0 || i === node.table.body.length) ? 1.5 : 0.5,
                vLineWidth: () => 1,
                hLineColor: () => '#1351b4',
                vLineColor: () => '#1351b4',
                paddingLeft: () => 5,
                paddingRight: () => 5,
                paddingTop: () => 2,
                paddingBottom: () => 2
            },
            margin: [0, 10, 0, 20]
        },
        { text: `Por ser verdade, firmo o teor das ${numToWords(declaracoes.length)} (${declaracoes.length}) declarações que compõem este arquivo:`, alignment: 'justify', fontSize: 11, margin: [0, 20, 0, 10] },
        {
            stack: [
                { text: `${dados.cidadeUF.split('/')[0].toUpperCase()}, na data da assinatura eletrônica.`, alignment: 'center', fontSize: 11, margin: [0, 20, 0, 10] },
                { text: '__________________________________________', alignment: 'center', fontSize: 11, margin: [0, 10, 0, 5] },
                { text: dados.nome, alignment: 'center', bold: true, fontSize: 11 },
                { text: dados.cargo, alignment: 'center', italic: true, fontSize: 11 }
            ],
            unbreakable: true
        }
    ]
};
};

const gerarPDFPrincipal = (declaracoes, dados, watermarkImage) => {
    return new Promise((resolve, reject) => {
        try {
            const allPagesContent = [];
            const isMultiPage = declaracoes.length > 1;

            if (isMultiPage) {
                declaracoes.forEach((decl, index) => {
                    const pageContent = createDeclarationContent(decl, dados, { withSignature: false });
                    if (index > 0) pageContent.pageBreak = 'before';
                    allPagesContent.push(pageContent);
                });
                allPagesContent.push(createLastPageContent(declaracoes, dados));
            } else {
                allPagesContent.push(createDeclarationContent(declaracoes[0], dados, { withSignature: true }));
            }

            const docDefinition = {
                pageSize: 'A4',
                pageMargins: [40, 80, 40, 80],
                background: () => watermarkImage ? { image: watermarkImage, width: 595.28, height: 841.89, absolutePosition: { x: 0, y: 0 } } : null,
                footer: (currentPage, pageCount) => {
                    let footerText = '';
                    if (pageCount > 1) {
                        footerText = (currentPage < pageCount)
                            ? declaracoes[currentPage - 1]?.footer
                            : `Documento composto por ${pageCount - 1} (${numToWords(pageCount - 1)}) declarações, assinado eletronicamente nesta página`;
                    } else {
                        footerText = declaracoes[0]?.footer;
                    }
                    if (!footerText) return null;
                    const isLongText = footerText.includes('RGF');
                    const mainTextAlign = isLongText ? 'justify' : 'left';
                    return {
                        margin: [40, 10, 40, 0],
                        stack: [
                            { canvas: [{ type: 'line', x1: 0, y1: 5, x2: 515, y2: 5, lineWidth: 0.5, lineColor: '#AAAAAA' }], margin: [0, 0, 0, 5] },
                            {
                                columns: [
                                    { text: footerText, alignment: mainTextAlign, fontSize: 8, color: '#555' },
                                    { text: `Página ${currentPage} de ${pageCount}`, alignment: 'right', fontSize: 8, color: '#555', width: 'auto' }
                                ]
                            }
                        ]
                    };
                },
                content: allPagesContent,
                styles: {
                    header: { fontSize: 12, bold: true, color: '#0c326f' },
                    subheader: { fontSize: 10, italic: true, color: '#333333' },
                    entityName: { bold: true, alignment: 'center', fontSize: 14, margin: [0, 0, 0, 2] },
                    entityAddress: { fontSize: 9, alignment: 'center', margin: [0, 0, 0, 5] },
                    tableHeader: { fontSize: 10, bold: true, color: '#FFFFFF', fillColor: '#1351b4', alignment: 'center' }
                },
                defaultStyle: { font: 'Roboto', alignment: 'justify' }
            };

            let fileName = '';
            if (isMultiPage) {
                fileName = `Declarações_COM_Envio_ao_TCE_${dados.nome.replace(/\s+/g, '_')}.pdf`;
            } else {
                const singleDeclId = declaracoes[0].id;
                if (singleDeclId === 'area_gestora_existe_taxa' || singleDeclId === 'area_gestora_inexiste_taxa') {
                    fileName = `Declaração_de_Área_Gestora_e_Inexistência_de_Legislação_${dados.nome.replace(/\s+/g, '_')}.pdf`;
                } else {
                    fileName = `Declaração_${dados.nome.replace(/\s+/g, '_')}.pdf`;
                }
            }

            pdfMake.createPdf(docDefinition).download(fileName, () => resolve());
        } catch (error) {
            reject(error);
        }
    });
};

const gerarPDFDeclaracaoSeparada = (declaracao, dados, watermarkImage) => {
    return new Promise((resolve, reject) => {
        gerarPDFPrincipal([declaracao], dados, watermarkImage).then(resolve).catch(reject);
    });
};

const processarGeracaoPDFs = async () => {
    try {
        const dados = {
            nome: document.getElementById('nomeResponsavel')?.value.trim() || '',
            cargo: document.getElementById('cargo')?.value || '',
            cnpj: document.getElementById('cnpj')?.value.trim() || '',
            cep: document.getElementById('cep')?.value.trim() || '',
            endereco: document.getElementById('endereco')?.value.trim() || '',
            complemento: document.getElementById('complemento')?.value.trim() || '',
            cidadeUF: document.getElementById('cidadeUF')?.value.trim() || '',
            nomeEstadoMunicipio: document.getElementById('nomeEstadoMunicipio')?.value.trim() || '',
            nomeEntidade: nomeEntidadeGlobal || document.getElementById('nomeEstadoMunicipio')?.value.trim() || ''
        };

        const configuracoes = {
            possuiAreaGestora: document.getElementById('possuiAreaGestora')?.checked || false,
            apresentaraCertidoes: document.getElementById('apresentaraCertidoes')?.checked || false,
            ate65milHabitantes: document.getElementById('ate65milHabitantes')?.checked || false,
            regularPrecatorios: document.getElementById('regularPrecatorios')?.checked || false
        };

        const declaracaoTipos = Array.from(document.querySelectorAll('input[name="declaracaoTipo"]:checked')).map(cb => cb.value);

        if (declaracaoTipos.length === 0) {
            throw new Error('Nenhum tipo de declaração foi selecionado na etapa "Entidade".');
        }

        let todasDeclaracoesRequeridas = [];
        declaracaoTipos.forEach(opcao => {
            todasDeclaracoesRequeridas.push(...getDeclaracoes(opcao, dados, configuracoes));
        });

        todasDeclaracoesRequeridas = [...new Map(todasDeclaracoesRequeridas.map(item => [item.id, item])).values()];

        const declaracoesParaArquivoPrincipal = [];
        const declaracoesParaArquivoSeparado = [];

        todasDeclaracoesRequeridas.forEach(decl => {
            if (decl.id === 'area_gestora_inexiste_taxa' || decl.id === 'area_gestora_existe_taxa') {
                declaracoesParaArquivoSeparado.push(decl);
            } else {
                declaracoesParaArquivoPrincipal.push(decl);
            }
        });

        const fileNames = [];
        if (declaracoesParaArquivoPrincipal.length > 0) {
            fileNames.push(`Declarações_COM_Envio_ao_TCE_${dados.nome.replace(/\s+/g, '_')}.pdf`);
        }
        if (declaracoesParaArquivoSeparado.length > 0) {
            fileNames.push(`Declaração_de_Área_Gestora_e_Inexistência_de_Legislação_${dados.nome.replace(/\s+/g, '_')}.pdf`);
        }

        const confirmationPopup = document.getElementById('confirmationPopup');
        const fileList = document.getElementById('fileList');
        const confirmDownloadBtn = document.getElementById('confirmDownloadBtn');
        const cancelPopupBtn = document.getElementById('cancelPopupBtn');

        fileList.innerHTML = fileNames.map(name => `<li>${name}</li>`).join('');
        confirmationPopup.classList.add('show');
        overlay.classList.add('show');

        const closeConfirmationPopup = () => {
            confirmationPopup.classList.remove('show');
            overlay.classList.remove('show');
        };

        await new Promise((resolve, reject) => {
            const onConfirm = () => {
                closeConfirmationPopup();
                cleanup();
                resolve();
            };

            const onCancel = () => {
                closeConfirmationPopup();
                cleanup();
                reject(new Error('Geração de PDFs cancelada pelo usuário.'));
            };

            const cleanup = () => {
                confirmDownloadBtn.removeEventListener('click', onConfirm);
                cancelPopupBtn.removeEventListener('click', onCancel);
            };

            confirmDownloadBtn.addEventListener('click', onConfirm, { once: true });
            cancelPopupBtn.addEventListener('click', onCancel, { once: true });
        });

        toggleLoading(true, 'Gerando documento(s)...');
        const watermarkImage = await getBase64ImageFromUrl('https://i.ibb.co/Q7tqVPBb/Folha-Limpa.jpg');
        let pdfsGerados = 0;

        if (declaracoesParaArquivoPrincipal.length > 0) {
            await gerarPDFPrincipal(declaracoesParaArquivoPrincipal, dados, watermarkImage);
            pdfsGerados++;
        }

        if (declaracoesParaArquivoSeparado.length > 0) {
            for (const decl of declaracoesParaArquivoSeparado) {
                await gerarPDFDeclaracaoSeparada(decl, dados, watermarkImage);
                pdfsGerados++;
            }
        }

        if (pdfsGerados > 0) {
            showPopup();
        } else {
            throw new Error('Nenhuma declaração foi gerada. Verifique suas seleções e os dados inseridos.');
        }

    } catch (error) {
        console.error('Erro ao gerar PDF(s):', error);
        if (error.message !== 'Geração de PDFs cancelada pelo usuário.') {
            alert(error.message || 'Ocorreu um erro ao gerar o(s) documento(s). Tente novamente.');
        }
    } finally {
        toggleLoading(false);
    }
};
form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (validateTab(tabs[tabs.length - 1])) {
        await processarGeracaoPDFs();
    }
});

pdfMake.fonts = {
