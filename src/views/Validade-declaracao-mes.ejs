            ];

            checkboxes.forEach(cb => {
                if (cb.show) {
                    const div = document.createElement('div');
                    div.className = 'checkbox-item';
                    div.innerHTML = `
                        <input type="checkbox" id="${cb.id}" name="configuracoes">
