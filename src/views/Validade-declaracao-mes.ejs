                    `;
                    configuracoesGroup.appendChild(div);
                }
            });
        };

        document.querySelectorAll('input[name="declaracaoTipo"]').forEach(checkbox => {
            checkbox.addEventListener('change', () => {
                validateTab('aba2');
                if (document.getElementById('aba3').classList.contains('active')) {
                    updateConfiguracoesCheckboxes();
                }
            });
        });

        // --- PDF Generation Logic ---

        const getBase64ImageFromUrl = (url) => new Promise((resolve) => {
            const img = new Image();
            img.crossOrigin = 'Anonymous';
            img.onload = () => {
                const canvas = document.createElement('canvas');
                canvas.width = img.width;
                canvas.height = img.height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0);
                resolve(canvas.toDataURL('image/jpeg'));
            };
            img.onerror = () => resolve(null);
            img.src = url;
        });

        function numToWords(num) {
            const units = ['', 'uma', 'duas', 'três', 'quatro', 'cinco', 'seis', 'sete', 'oito', 'nove', 'dez', 'onze', 'doze'];
            if (num >= 0 && num < units.length) return units[num];
            return String(num);
        }

        const getDeclaracoes = (opcao, dados, configuracoes) => {
