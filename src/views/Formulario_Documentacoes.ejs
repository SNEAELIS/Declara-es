<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerador de Documentações</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-blue: #003087;
            --light-blue: #e6f0ff;
            --success-green: #198754;
            --danger-red: #dc3545;
            --background-color: #f4f4f9; /* Cinza de fundo para destacar os cards */
            --card-background: #ffffff;
            --text-primary: #212529;
            --text-secondary: #6c757d;
            --border-color: #dee2e6;
            --font-heading: 'Poppins', sans-serif;
            --font-body: 'Inter', sans-serif;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: var(--font-body); background-color: var(--background-color); color: var(--text-primary); line-height: 1.6; }
        
        header { background-color: var(--primary-blue); width: 100%; padding: 0 2rem; height: 70px; display: flex; align-items: center; box-shadow: var(--shadow); position: fixed; top: 0; z-index: 1000; }
        .header-content { width: 100%; max-width: 1200px; margin: 0 auto; display: flex; align-items: center; gap: 1.5rem; }
        .logo-header { max-height: 50px; width: auto; filter: brightness(0) invert(1); }
        header h1 { font-family: var(--font-heading); font-size: 1.25rem; color: white; font-weight: 600; }
        
        .container { max-width: 900px; margin: 100px auto 40px; padding: 2rem; }
        .container-header { margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem; }
        .container-header h2 { font-family: var(--font-heading); font-size: 1.75rem; color: var(--text-primary); }
        .container-header .status { font-size: 0.9rem; color: var(--text-secondary); background-color: #e9ecef; padding: 0.25rem 0.75rem; border-radius: 1rem; }
        
        .section { margin-bottom: 2.5rem; }
        .section h3 { font-family: var(--font-heading); font-size: 1.2rem; font-weight: 600; color: var(--primary-blue); margin-bottom: 1rem; }
        
        .form-card { background-color: var(--card-background); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.5rem; box-shadow: var(--shadow); }
        .form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 1rem; }
        .form-row:last-child { margin-bottom: 0; }
        
        .form-group { position: relative; display: flex; flex-direction: column; }
        .form-group.full-width { grid-column: 1 / -1; }
        
        label { font-size: 0.875rem; font-weight: 500; color: var(--text-secondary); margin-bottom: 0.5rem; }
        input[type="text"], input[type="file"] { width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 1rem; font-family: var(--font-body); background-color: #fff; transition: border-color 0.3s ease, box-shadow 0.3s ease; }
        input[readonly] { background-color: #f1f3f5; cursor: not-allowed; }
        input:focus { outline: none; border-color: var(--primary-blue); box-shadow: 0 0 0 3px var(--light-blue); }
        
        .error-message { color: var(--danger-red); font-size: 0.8rem; margin-top: 0.25rem; display: none; }
        input.error { border-color: var(--danger-red) !important; }
        input.success { border-color: var(--success-green) !important; }

        .checkbox-wrapper { display: flex; align-items: center; background-color: #f8f9fa; padding: 1rem; border-radius: 6px; }
        .checkbox-wrapper label { margin: 0 0 0 0.75rem; font-weight: 500; color: var(--text-primary); cursor: pointer; }
        input[type="checkbox"] { appearance: none; min-width: 1.25rem; width: 1.25rem; height: 1.25rem; border: 2px solid var(--border-color); border-radius: 4px; cursor: pointer; position: relative; }
        input[type="checkbox"]:checked { background-color: var(--primary-blue); border-color: var(--primary-blue); }
        input[type="checkbox"]:checked::before { content: '✔'; font-size: 0.8rem; color: white; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); }
        
        .upload-container { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px dashed var(--border-color); }
        
        .button-container { display: flex; justify-content: flex-end; margin-top: 2rem; }
        #botaoGerarPDF { font-family: var(--font-heading); font-weight: 600; font-size: 1rem; background-color: var(--primary-blue); color: white; border: none; padding: 0.8rem 2rem; border-radius: 6px; cursor: pointer; transition: transform 0.2s ease, background-color 0.3s ease; }
        #botaoGerarPDF:hover { background-color: #00276a; transform: translateY(-2px); }

        .spinner-inline {
            display: none;
            position: absolute;
            right: 1rem;
            top: 70%;
            transform: translateY(-50%);
            width: 20px;
            height: 20px;
            border: 3px solid var(--light-blue);
            border-top-color: var(--primary-blue);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        .loading-message { display: none; justify-content: center; align-items: center; gap: 1rem; margin-top: 1.5rem; font-weight: 500; color: var(--primary-blue); }
        .loading-message .spinner { width: 24px; height: 24px; border: 3px solid var(--light-blue); border-top-color: var(--primary-blue); border-radius: 50%; }
        
        @keyframes spin { to { transform: rotate(360deg); } }
        
        footer { text-align: center; padding: 1.5rem; background-color: var(--primary-blue); color: #f8f9fa; font-size: 0.875rem; margin-top: 3rem; }
        
        @media (max-width: 768px) {
            .container { padding: 1rem; margin-top: 80px; }
            header h1 { display: none; }
            .form-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <header>
        <div class="header-content">
            <img src="https://homologacao.itech.ifsertaope.edu.br/forms/declaracoes/public/images/ASSINATURAS-ESPORTE-FUNDO-PRETO-2-HORIZONTAL.png" class="logo-header" alt="Logo Ministério do Esporte">
            <h1>Gerador de Declarações</h1>
        </div>
    </header>

    <main class="container">
        <div class="container-header">
            <h2>Painel do Técnico</h2>
            <span class="status">Emissão de Documentos</span>
        </div>

        <form id="declaracoesForm" onsubmit="return false;">
            <section class="section">
                <h3>Dados do Dirigente da Entidade</h3>
                <div class="form-card">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="dirigente">Nome Completo</label>
                            <input type="text" id="dirigente" name="Nome do Dirigente" placeholder="Ex: João da Silva" required>
                            <div class="error-message"></div>
                        </div>
                        <div class="form-group">
                            <label for="cargoDirigente">Cargo</label>
                            <input type="text" id="cargoDirigente" name="Cargo do Dirigente" placeholder="Ex: Presidente" required>
                            <div class="error-message"></div>
                        </div>
                    </div>
                </div>
            </section>
            
            <section class="section">
                <h3>Dados da Entidade</h3>
                <div class="form-card">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="cnpj">CNPJ</label>
                            <input type="text" id="cnpj" placeholder="00.000.000/0000-00" required>
                            <div class="spinner-inline" id="cnpj-spinner"></div>
                            <div class="error-message"></div>
                        </div>
                        <div class="form-group">
                            <label for="entidade">Nome da Entidade (preenchido automaticamente)</label>
                            <input type="text" id="entidade" readonly>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group full-width">
                            <label for="endereco">Endereço Completo</label>
                            <input type="text" id="endereco" readonly>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="municipio">Município</label>
                            <input type="text" id="municipio" readonly>
                        </div>
                        <div class="form-group">
                            <label for="uf">UF</label>
                            <input type="text" id="uf" readonly>
                        </div>
                    </div>
                </div>
            </section>
            <section class="section">
                <h3>Dados da Proposta</h3>
                <div class="form-card">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="proposta">Nº da Proposta</label>
                            <input type="text" id="proposta" placeholder="000000/2025" required>
                            <div class="error-message"></div>
                        </div>
                    </div>
                </div>
            </section>
            
            <section class="section">
                <h3>Opções de Layout</h3>
                <div class="form-card">
                    <div class="checkbox-wrapper">
                        <input type="checkbox" id="useLetterhead">
                        <label for="useLetterhead">Usar Papel Timbrado personalizado</label>
                    </div>
                    <div id="letterheadUploadContainer" class="upload-container" style="display: none;">
                        <label for="letterheadFile">Carregar Papel Timbrado (PDF, JPEG, PNG)</label>
                        <input type="file" id="letterheadFile" name="letterheadFile" accept=".pdf,.jpeg,.jpg,.png">
                    </div>
                </div>
            </section>
        </form>

        <div class="button-container">
            <button id="botaoGerarPDF">Gerar Declarações</button>
        </div>
        
        <div id="loadingMessage" class="loading-message">
            <div class="spinner"></div>
            Processando PDF...
        </div>
    </main>

    <footer>
        <p>© 2025 Ministério do Esporte. Todos os direitos reservados.</p>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    
    <script>
        // SCRIPT DE CONEXÃO E INTERAÇÃO DO FRONT-END
        document.addEventListener('DOMContentLoaded', () => {
            if (window.pdfjsLib) {
                pdfjsLib.GlobalWorkerOptions.workerSrc = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js`;
            }

            const dirigenteInput = document.getElementById('dirigente');
            const cargoInput = document.getElementById('cargoDirigente');
            const cnpjInput = document.getElementById('cnpj');
            const propostaInput = document.getElementById('proposta');
            const useLetterheadCheckbox = document.getElementById('useLetterhead');

            // Conecta os campos às suas funções de validação/formatação
            dirigenteInput.addEventListener('input', () => validarCampo(dirigenteInput, /[^A-Za-zÀ-ÿ\s]/g));
            cargoInput.addEventListener('input', () => validarCampo(cargoInput, /[^A-Za-zÀ-ÿ\s]/g));
            cnpjInput.addEventListener('input', () => formatarEBuscarCNPJ(cnpjInput));
            propostaInput.addEventListener('input', () => formatarProposta(propostaInput));
            
            // Ativa a funcionalidade do checkbox de papel timbrado
            if(useLetterheadCheckbox) {
                useLetterheadCheckbox.addEventListener('change', (event) => {
                    document.getElementById('letterheadUploadContainer').style.display = event.target.checked ? 'block' : 'none';
                });
            }
            
            // O gatilho principal do botão 'Gerar PDF' será adicionado pelo seu script externo
        });

        function toggleErro(input, showError, message = '') {
            const errorDiv = input.parentElement.querySelector('.error-message');
            input.classList.remove('error', 'success');
            if (showError) {
                input.classList.add('error');
                if (errorDiv) {
                    errorDiv.textContent = message || `Campo obrigatório`;
                    errorDiv.style.display = 'block';
                }
            } else {
                if (errorDiv) errorDiv.style.display = 'none';
            }
        }

        // --- FUNÇÕES DE FORMATAÇÃO E BUSCA (AGORA FUNCIONAIS) ---
        function validarCampo(input, regex) {
            input.value = input.value.replace(regex, '');
        }

        function formatarProposta(input) {
            let value = input.value
                .replace(/[^\d/]/g, '')
                .replace(/(\/.*)\//g, '$1'); 
            
            let parts = value.split('/');
            parts[0] = parts[0].slice(0, 6);
            
            if (parts[1] !== undefined) {
                parts[1] = parts[1].slice(0, 4);
                input.value = parts.join('/');
            } else {
                input.value = parts[0];
            }
        }

        let debounceTimer;
        function formatarEBuscarCNPJ(input) {
            let value = input.value.replace(/\D/g, '').slice(0, 14);
            value = value.replace(/(\d{2})(\d)/, '$1.$2')
                         .replace(/(\d{3})(\d)/, '$1.$2')
                         .replace(/(\d{3})(\d)/, '$1/$2')
                         .replace(/(\d{4})(\d{1,2})$/, '$1-$2');
            input.value = value;

            clearTimeout(debounceTimer);
            if (value.length === 18) {
                debounceTimer = setTimeout(() => fetchEmpresaNome(value), 500);
            } else {
                 input.classList.remove('success', 'error');
                 const errorDiv = input.parentElement.querySelector('.error-message');
                 if(errorDiv) errorDiv.style.display = 'none';
            }
        }

        async function fetchEmpresaNome(cnpj) {
            const cleanCnpj = cnpj.replace(/[^\d]/g, '');
            const spinner = document.getElementById('cnpj-spinner');
            const campos = {
                entidade: document.getElementById('entidade'),
                endereco: document.getElementById('endereco'),
                uf: document.getElementById('uf'),
                municipio: document.getElementById('municipio'),
                cnpj: document.getElementById('cnpj'),
            };

            spinner.style.display = 'inline-block';
            campos.cnpj.classList.remove('success', 'error');
            ['entidade', 'endereco', 'uf', 'municipio'].forEach(id => campos[id].value = 'Buscando...');

            try {
                const response = await fetch(`https://brasilapi.com.br/api/cnpj/v1/${cleanCnpj}`);
                if (!response.ok) throw new Error('CNPJ não encontrado na base de dados.');
                const data = await response.json();
                
                if(!data.razao_social) throw new Error('Dados da empresa incompletos.');

                campos.entidade.value = data.razao_social || '';
                campos.endereco.value = `${data.logradouro || ''}, ${data.numero || ''}, ${data.bairro || ''}`.trim().replace(/,$/, '');
                campos.uf.value = data.uf || '';
                campos.municipio.value = data.municipio || '';
                
                toggleErro(campos.cnpj, false);
                campos.cnpj.classList.add('success');

            } catch (error) {
                console.error('Erro ao buscar dados da empresa:', error);
                ['entidade', 'endereco', 'uf', 'municipio'].forEach(id => campos[id].value = '');
                toggleErro(campos.cnpj, true, error.message);
            } finally {
                spinner.style.display = 'none';
            }
        }
    </script>
    
    <script src="/forms/declaracoes/public/js/Script/script.js"></script>

</body>
</html>