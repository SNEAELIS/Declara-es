<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerador de Documentações</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-blue: #003087;
            --light-blue: #e6f0ff;
            --success-green: #198754;
            --danger-red: #dc3545;
            --background-color: #f4f4f9;
            --card-background: #ffffff;
            --text-primary: #212529;
            --text-secondary: #6c757d;
            --border-color: #dee2e6;
            --font-heading: 'Poppins', sans-serif;
            --font-body: 'Inter', sans-serif;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: var(--font-body); background-color: var(--background-color); color: var(--text-primary); line-height: 1.6; }
        
        header { background-color: var(--primary-blue); width: 100%; padding: 0 2rem; height: 70px; display: flex; align-items: center; box-shadow: var(--shadow); position: fixed; top: 0; z-index: 1000; }
        .header-content { width: 100%; max-width: 1200px; margin: 0 auto; display: flex; align-items: center; gap: 1.5rem; }
        .logo-header { max-height: 50px; width: auto; filter: brightness(0) invert(1); }
        header h1 { font-family: var(--font-heading); font-size: 1.25rem; color: white; font-weight: 600; }
        
        .container { max-width: 900px; margin: 100px auto 40px; padding: 2rem; }
        .container-header { margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem; }
        .container-header h2 { font-family: var(--font-heading); font-size: 1.75rem; color: var(--text-primary); }
        .container-header .status { font-size: 0.9rem; color: var(--text-secondary); background-color: #e9ecef; padding: 0.25rem 0.75rem; border-radius: 1rem; }
        
        .section { margin-bottom: 2.5rem; }
        .section h3 { font-family: var(--font-heading); font-size: 1.2rem; font-weight: 600; color: var(--primary-blue); margin-bottom: 1rem; }
        
        .form-card { background-color: var(--card-background); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.5rem; box-shadow: var(--shadow); }
        .form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 1rem; }
        .form-row:last-child { margin-bottom: 0; }
        
        .form-group { position: relative; display: flex; flex-direction: column; }
        .form-group.full-width { grid-column: 1 / -1; }
        
        label { font-size: 0.875rem; font-weight: 500; color: var(--text-secondary); margin-bottom: 0.5rem; }
        input[type="text"], input[type="file"], input[type="number"] { width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 1rem; font-family: var(--font-body); background-color: #fff; transition: border-color 0.3s ease, box-shadow 0.3s ease; }
        input[readonly] { background-color: #f1f3f5; cursor: not-allowed; }
        input:focus { outline: none; border-color: var(--primary-blue); box-shadow: 0 0 0 3px var(--light-blue); }
        
        .error-message { color: var(--danger-red); font-size: 0.8rem; margin-top: 0.25rem; display: none; }
        input.error { border-color: var(--danger-red) !important; }
        input.success { border-color: var(--success-green) !important; }

        .checkbox-wrapper { display: flex; align-items: center; background-color: #f8f9fa; padding: 1rem; border-radius: 6px; }
        .checkbox-wrapper label { margin: 0 0 0 0.75rem; font-weight: 500; color: var(--text-primary); cursor: pointer; }
        input[type="checkbox"] { appearance: none; min-width: 1.25rem; width: 1.25rem; height: 1.25rem; border: 2px solid var(--border-color); border-radius: 4px; cursor: pointer; position: relative; }
        input[type="checkbox"]:checked { background-color: var(--primary-blue); border-color: var(--primary-blue); }
        input[type="checkbox"]:checked::before { content: '✔'; font-size: 0.8rem; color: white; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); }
        
        .upload-container { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px dashed var(--border-color); }
        
        .button-container { display: flex; justify-content: flex-end; margin-top: 2rem; }
        #botaoGerarPDF { font-family: var(--font-heading); font-weight: 600; font-size: 1rem; background-color: var(--primary-blue); color: white; border: none; padding: 0.8rem 2rem; border-radius: 6px; cursor: pointer; transition: transform 0.2s ease, background-color 0.3s ease; }
        #botaoGerarPDF:hover { background-color: #00276a; transform: translateY(-2px); }

        .spinner-inline {
            display: none;
            position: absolute;
            right: 1rem;
            top: 70%;
            transform: translateY(-50%);
            width: 20px;
            height: 20px;
            border: 3px solid var(--light-blue);
            border-top-color: var(--primary-blue);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        .loading-message { display: none; justify-content: center; align-items: center; gap: 1rem; margin-top: 1.5rem; font-weight: 500; color: var(--primary-blue); }
        .loading-message .spinner { width: 24px; height: 24px; border: 3px solid var(--light-blue); border-top-color: var(--primary-blue); border-radius: 50%; }
        
        @keyframes spin { to { transform: rotate(360deg); } }
        
        /* --- ESTILOS DO MODAL PROFISSIONAL --- */
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.7);
            display: flex; justify-content: center; align-items: center;
            z-index: 2000; backdrop-filter: blur(5px);
        }
        .modal-content {
            background: var(--background-color); padding: 1.5rem; border-radius: 12px;
            box-shadow: var(--shadow-lg); width: 95%; max-width: 1100px;
            display: grid; grid-template-columns: 280px 1fr; gap: 1.5rem;
            max-height: 90vh;
        }
        .layout-controls { display: flex; flex-direction: column; gap: 1rem; }
        .control-panel { background: var(--card-background); padding: 1rem; border-radius: 8px; overflow-y: auto; }
        .control-panel h4 { font-family: var(--font-heading); color: var(--primary-blue); margin-bottom: 1rem; }
        .control-group { margin-bottom: 1rem; }
        .control-group label { font-weight: 600; font-size: 0.9rem; display: block; margin-bottom: 0.5rem; }
        .preview-area { display: flex; flex-direction: column; }
        #previewIframe { width: 100%; height: 100%; border: 1px solid var(--border-color); border-radius: 4px; box-shadow: var(--shadow); }
        .pagination-controls { display: flex; justify-content: center; align-items: center; gap: 1rem; padding-top: 1rem; }
        .pagination-controls button { background: none; border: 1px solid var(--border-color); padding: 0.3rem 0.8rem; border-radius: 4px; cursor: pointer; }
        .pagination-controls button:hover { background: #e9ecef; }
        .pagination-controls button:disabled { opacity: 0.5; cursor: not-allowed; }
        #pageIndicator { font-size: 0.9rem; font-weight: 500; }

        .modal-actions { margin-top: auto; display: flex; flex-direction: column; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--border-color); }
        .modal-actions button { width: 100%; font-family: var(--font-heading); font-weight: 600; font-size: 1rem; border: none; padding: 0.7rem 1.5rem; border-radius: 6px; cursor: pointer; transition: all 0.2s ease; }
        .btn-primary { background-color: var(--primary-blue); color: white; }
        .btn-primary:hover { background-color: #00276a; transform: translateY(-2px); }
        .btn-secondary { background-color: #e9ecef; color: var(--text-primary); }
        .btn-secondary:hover { background-color: #dee2e6; }
        
        footer { text-align: center; padding: 1.5rem; background-color: var(--primary-blue); color: #f8f9fa; font-size: 0.875rem; margin-top: 3rem; }
        
        /* Styles for draggable list */
        #declarationList {
            list-style: none;
            padding: 0;
            margin: 0;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            max-height: 250px;
            overflow-y: auto;
        }
        .declaration-item {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--border-color);
            background-color: var(--card-background);
            cursor: grab;
            display: flex;
            align-items: center;
            font-size: 0.9rem;
            color: var(--text-primary);
        }
        .declaration-item:last-child {
            border-bottom: none;
        }
        .declaration-item:hover {
            background-color: #f0f4f8;
        }
        .declaration-item.dragging {
            opacity: 0.5;
            border: 2px dashed var(--primary-blue);
        }
        .declaration-item span {
            flex-grow: 1;
        }
        .declaration-item::before {
            content: '☰'; /* Hamburger icon for drag handle */
            margin-right: 0.75rem;
            color: var(--text-secondary);
            font-size: 1rem;
        }

        @media (max-width: 1024px) {
            .modal-content { grid-template-columns: 1fr; max-height: 95vh; overflow-y: auto; }
            .preview-area { min-height: 500px; }
        }
        @media (max-width: 768px) {
            .container { padding: 1rem; margin-top: 80px; }
            header h1 { display: none; }
            .form-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <header>
        <div class="header-content">
            <img src="https://homologacao.itech.ifsertaope.edu.br/forms/declaracoes/public/images/ASSINATURAS-ESPORTE-FUNDO-PRETO-2-HORIZONTAL.png" class="logo-header" alt="Logo Ministério do Esporte">
            <h1>Gerador de Declarações</h1>
        </div>
    </header>

    <main class="container">
        <div class="container-header">
            <h2>Painel do Técnico</h2>
            <span class="status">Emissão de Documentos</span>
        </div>

        <form id="declaracoesForm" onsubmit="return false;">
            <section class="section">
                <h3>Dados do Dirigente da Entidade</h3>
                <div class="form-card">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="dirigente">Nome Completo</label>
                            <input type="text" id="dirigente" name="Nome do Dirigente" placeholder="Ex: João da Silva" required>
                            <div class="error-message"></div>
                        </div>
                        <div class="form-group">
                            <label for="cargoDirigente">Cargo</label>
                            <input type="text" id="cargoDirigente" name="Cargo do Dirigente" placeholder="Ex: Presidente" required>
                            <div class="error-message"></div>
                        </div>
                    </div>
                </div>
            </section>
            
            <section class="section">
                <h3>Dados da Entidade</h3>
                <div class="form-card">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="cnpj">CNPJ</label>
                            <input type="text" id="cnpj" placeholder="00.000.000/0000-00" required>
                            <div class="spinner-inline" id="cnpj-spinner"></div>
                            <div class="error-message"></div>
                        </div>
                        <div class="form-group">
                            <label for="entidade">Nome da Entidade (preenchido automaticamente)</label>
                            <input type="text" id="entidade" readonly>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group full-width">
                            <label for="endereco">Endereço Completo</label>
                            <input type="text" id="endereco" readonly>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="municipio">Município</label>
                            <input type="text" id="municipio" readonly>
                        </div>
                        <div class="form-group">
                            <label for="uf">UF</label>
                            <input type="text" id="uf" readonly>
                        </div>
                    </div>
                </div>
            </section>
            <section class="section">
                <h3>Dados da Proposta</h3>
                <div class="form-card">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="proposta">Nº da Proposta</label>
                            <input type="text" id="proposta" placeholder="000000/2025" required>
                            <div class="error-message"></div>
                        </div>
                    </div>
                </div>
            </section>
            
            <section class="section">
                <h3>Opções de Layout</h3>
                <div class="form-card">
                    <div class="checkbox-wrapper">
                        <input type="checkbox" id="useLetterhead">
                        <label for="useLetterhead">Usar Papel Timbrado personalizado</label>
                    </div>
                    <div id="letterheadUploadContainer" class="upload-container" style="display: none;">
                        <label for="letterheadFile">Carregar Papel Timbrado (PDF, JPEG, PNG)</label>
                        <input type="file" id="letterheadFile" name="letterheadFile" accept=".pdf,.jpeg,.jpg,.png">
                    </div>
                </div>
            </section>
        </form>

        <div class="button-container">
            <button id="botaoGerarPDF">Gerar Declarações</button>
        </div>
        
        <div id="loadingMessage" class="loading-message">
            <div class="spinner"></div>
            Processando PDF...
        </div>
    </main>

    <div id="layoutEditorModal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <div class="layout-controls">
                <div class="control-panel">
                    <h4>Pré-visualização e Ajuste Fino</h4>
                    <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.5rem;">Ajuste as margens para o seu papel timbrado. As alterações serão aplicadas em todas as páginas e refletidas na visualização ao lado. Limite: Margem Superior até 7 cm, Margem Inferior do Rodapé até 6,5 cm.</p>
                    
                    <div class="control-group">
                        <label for="marginTopCm">Margem Superior (cm)</label>
                        <input type="number" id="marginTopCm" value="4.5" step="0.1" min="0" max="7">
                    </div>

                    <div class="control-group">
                        <label for="footerMarginBottomCm">Margem Inferior do Rodapé (cm)</label>
                        <input type="number" id="footerMarginBottomCm" value="5.5" step="0.1" min="0" max="6.5">
                    </div>

                    <div class="control-group" style="margin-top: 2rem;">
                        <label>Ordem das Declarações</label>
                        <ul id="declarationList"></ul>
                        <p style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.5rem;">Arraste e solte para reordenar.</p>
                    </div>
                </div>

                <div class="modal-actions">
                    <button id="confirmAndGenerate" class="btn-primary">Salvar e Gerar PDF</button>
                    <button id="cancelLayout" class="btn-secondary">Cancelar</button>
                </div>
            </div>
            <div class="preview-area">
                <iframe id="previewIframe" title="Pré-visualização do PDF"></iframe>
                <div class="pagination-controls">
                    <button id="prevPageBtn">< Anterior</button>
                    <span id="pageIndicator">Página 1 / 12</span>
                    <button id="nextPageBtn">Próxima ></button>
                </div>
            </div>
        </div>
    </div>

    <footer>
        <p>© 2025 Ministério do Esporte. Todos os direitos reservados.</p>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    
    <script src="/forms/declaracoes/public/js/Script/script.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (window.pdfjsLib) {
                pdfjsLib.GlobalWorkerOptions.workerSrc = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js`;
            }

            const dirigenteInput = document.getElementById('dirigente');
            const cargoInput = document.getElementById('cargoDirigente');
            const cnpjInput = document.getElementById('cnpj');
            const entidadeInput = document.getElementById('entidade');
            const enderecoInput = document.getElementById('endereco');
            const ufInput = document.getElementById('uf');
            const municipioInput = document.getElementById('municipio');
            const propostaInput = document.getElementById('proposta');
            const useLetterheadCheckbox = document.getElementById('useLetterhead');
            const letterheadUploadContainer = document.getElementById('letterheadUploadContainer');
            const letterheadFileInput = document.getElementById('letterheadFile');
            const botaoGerarPDF = document.getElementById('botaoGerarPDF');
            const loadingMessage = document.getElementById('loadingMessage');
            const declarationForm = document.getElementById('declaracoesForm');

            const modal = document.getElementById('layoutEditorModal');
            const iframe = document.getElementById('previewIframe');
            const declarationListEl = document.getElementById('declarationList');
            const confirmAndGenerateBtn = document.getElementById('confirmAndGenerate');
            const cancelLayoutBtn = document.getElementById('cancelLayout');
            const prevPageBtn = document.getElementById('prevPageBtn');
            const nextPageBtn = document.getElementById('nextPageBtn');
            const pageIndicator = document.getElementById('pageIndicator');
            const marginTopCm = document.getElementById('marginTopCm');
            const footerMarginBottomCm = document.getElementById('footerMarginBottomCm');

            let currentPreviewPage = 1;
            let reorderedDeclarations = [];
            let letterheadBackground = null;
            let debounceTimer;
            let cnpjDebounceTimer;
            let fullPdfBlobUrl = null;

            function toggleErro(input, showError, message = '') {
                const errorDiv = input.parentElement.querySelector('.error-message');
                input.classList.remove('error', 'success');
                if (showError) {
                    input.classList.add('error');
                    if (errorDiv) {
                        errorDiv.textContent = message || `Campo obrigatório`;
                        errorDiv.style.display = 'block';
                    }
                } else {
                    input.classList.add('success');
                    if (errorDiv) errorDiv.style.display = 'none';
                }
            }

            function validarCampo(input, regex, errorMessage = 'Caracteres inválidos') {
                const initialValue = input.value;
                input.value = initialValue.replace(regex, '');
                if (input.value !== initialValue) {
                    toggleErro(input, true, errorMessage);
                } else {
                    toggleErro(input, false);
                }
            }

            function formatarProposta(input) {
                let value = input.value
                    .replace(/[^\d/]/g, '')
                    .replace(/(\/.*)\//g, '$1'); 
                let parts = value.split('/');
                parts[0] = parts[0].slice(0, 6);
                if (parts[1] !== undefined) {
                    parts[1] = parts[1].slice(0, 4);
                    input.value = parts.join('/');
                } else {
                    input.value = parts[0];
                }
                toggleErro(input, false);
            }

            function formatarEBuscarCNPJ(input) {
                let value = input.value.replace(/\D/g, '').slice(0, 14);
                value = value.replace(/(\d{2})(\d)/, '$1.$2')
                             .replace(/(\d{3})(\d)/, '$1.$2')
                             .replace(/(\d{3})(\d)/, '$1/$2')
                             .replace(/(\d{4})(\d{1,2})$/, '$1-$2');
                input.value = value;

                clearTimeout(cnpjDebounceTimer);
                if (value.length === 18) {
                    cnpjDebounceTimer = setTimeout(() => fetchEmpresaNome(value), 800);
                } else {
                    entidadeInput.value = '';
                    enderecoInput.value = '';
                    ufInput.value = '';
                    municipioInput.value = '';
                    toggleErro(input, false);
                }
            }

            async function fetchEmpresaNome(cnpj) {
                const cleanCnpj = cnpj.replace(/[^\d]/g, '');
                const spinner = document.getElementById('cnpj-spinner');

                spinner.style.display = 'inline-block';
                cnpjInput.classList.remove('success', 'error');
                entidadeInput.value = 'Buscando...';
                enderecoInput.value = 'Buscando...';
                ufInput.value = 'Buscando...';
                municipioInput.value = 'Buscando...';

                try {
                    const response = await fetch(`https://brasilapi.com.br/api/cnpj/v1/${cleanCnpj}`);
                    if (!response.ok) {
                        const errorData = await response.json();
                        throw new Error(errorData.message || 'CNPJ não encontrado ou inválido.');
                    }
                    const data = await response.json();
                    
                    if(!data.razao_social) throw new Error('Dados da empresa incompletos.');

                    entidadeInput.value = data.razao_social || '';
                    const logradouro = data.logradouro || '';
                    const numero = data.numero || '';
                    const bairro = data.bairro || '';
                    const complemento = data.complemento ? `, ${data.complemento}` : '';
                    enderecoInput.value = `${logradouro}, ${numero} - ${bairro}${complemento}`.trim().replace(/\s*,\s*$/g,'').replace(/,\s*,/g,',');
                    ufInput.value = data.uf || '';
                    municipioInput.value = data.municipio || '';
                    
                    toggleErro(cnpjInput, false);
                    cnpjInput.classList.add('success');

                } catch (error) {
                    console.error('Erro ao buscar dados da empresa:', error);
                    entidadeInput.value = '';
                    enderecoInput.value = '';
                    ufInput.value = '';
                    municipioInput.value = '';
                    toggleErro(cnpjInput, true, error.message);
                } finally {
                    spinner.style.display = 'none';
                }
            }

            const cmToPoints = (cm) => cm * 28.3465;
            const PAGE_HEIGHT_POINTS = 841.89; // Altura de uma página A4 em pontos
            
            const openModal = async () => {
                const file = letterheadFileInput.files[0];
                if (!file) {
                    alert("Por favor, selecione um arquivo de papel timbrado.");
                    return;
                }
                
                loadingMessage.style.display = 'flex';
                try {
                    if (file.type.startsWith('image/')) {
                        letterheadBackground = await getBase64FromFile(file);
                    } else if (file.type === 'application/pdf') {
                        letterheadBackground = await convertPdfPageToImage(file);
                    } else {
                        alert("Tipo de arquivo inválido! Por favor, selecione um JPEG, PNG ou PDF.");
                        return;
                    }
                    
                    if (reorderedDeclarations.length === 0 && typeof declarations !== 'undefined') {
                        reorderedDeclarations = [...declarations];
                    } else if (typeof declarations === 'undefined') {
                        console.error("Erro: A variável 'declarations' não foi encontrada. Verifique se o script.js foi carregado corretamente.");
                        alert("Erro interno: Declarações não carregadas.");
                        return;
                    }

                    populateDeclarationList(reorderedDeclarations);
                    modal.style.display = 'flex';
                    currentPreviewPage = 1;
                    await updatePreview();

                } catch (error) {
                    console.error("Erro ao processar papel timbrado:", error);
                    alert("Não foi possível carregar o arquivo de papel timbrado. Erro: " + error.message);
                } finally {
                    loadingMessage.style.display = 'none';
                }
            };
            
            const closeModal = () => {
                modal.style.display = 'none';
                iframe.src = 'about:blank';
                letterheadBackground = null;
                if (fullPdfBlobUrl) {
                    URL.revokeObjectURL(fullPdfBlobUrl);
                    fullPdfBlobUrl = null;
                }
            };

            const populateDeclarationList = (decls) => {
                declarationListEl.innerHTML = '';
                decls.forEach((title, index) => {
                    const li = document.createElement('li');
                    li.classList.add('declaration-item');
                    li.setAttribute('draggable', 'true');
                    li.dataset.index = index;
                    li.textContent = title;
                    declarationListEl.appendChild(li);
                });
                addDragDropListeners();
            };

            const addDragDropListeners = () => {
                let dragStartIndex;

                declarationListEl.querySelectorAll('.declaration-item').forEach(item => {
                    item.addEventListener('dragstart', (e) => {
                        dragStartIndex = parseInt(item.dataset.index);
                        e.dataTransfer.effectAllowed = 'move';
                        e.dataTransfer.setData('text/plain', dragStartIndex);
                        setTimeout(() => item.classList.add('dragging'), 0);
                    });

                    item.addEventListener('dragenter', (e) => {
                        e.preventDefault();
                        item.classList.add('drag-over');
                    });

                    item.addEventListener('dragover', (e) => {
                        e.preventDefault(); 
                        item.classList.add('drag-over');
                    });

                    item.addEventListener('dragleave', () => {
                        item.classList.remove('drag-over');
                    });

                    item.addEventListener('drop', (e) => {
                        e.preventDefault();
                        item.classList.remove('drag-over');

                        const dragEndIndex = Array.from(declarationListEl.children).indexOf(item); 
                        if (dragStartIndex !== dragEndIndex) {
                            const [draggedItem] = reorderedDeclarations.splice(dragStartIndex, 1);
                            reorderedDeclarations.splice(dragEndIndex, 0, draggedItem);
                            
                            populateDeclarationList(reorderedDeclarations);
                            
                            if (currentPreviewPage === dragStartIndex + 1) { 
                                currentPreviewPage = dragEndIndex + 1;
                            } else if (dragStartIndex < currentPreviewPage - 1 && dragEndIndex >= currentPreviewPage - 1) { 
                                currentPreviewPage--;
                            } else if (dragStartIndex > currentPreviewPage - 1 && dragEndIndex <= currentPreviewPage - 1) { 
                                currentPreviewPage++;
                            }
                            currentPreviewPage = Math.max(1, Math.min(reorderedDeclarations.length + 1, currentPreviewPage)); 

                            updatePreview();
                        }
                    });

                    item.addEventListener('dragend', (e) => {
                        item.classList.remove('dragging');
                        declarationListEl.querySelectorAll('.declaration-item').forEach(li => {
                            li.classList.remove('drag-over');
                        });
                    });
                });
            };

            const updatePreview = async () => {
                if (!modal || modal.style.display === 'none' || reorderedDeclarations.length === 0) return;

                const formData = {
                    dirigente: dirigenteInput.value,
                    cargoDirigente: cargoInput.value,
                    entidade: entidadeInput.value,
                    cnpj: cnpjInput.value,
                    endereco: enderecoInput.value,
                    uf: ufInput.value,
                    municipio: municipioInput.value,
                    proposta: propostaInput.value,
                    useLetterheadChecked: useLetterheadCheckbox.checked,
                    letterheadFile: letterheadFileInput.files[0]
                };

                const footerMarginBottomCmValue = parseFloat(footerMarginBottomCm.value);
                const footerPosition = PAGE_HEIGHT_POINTS - cmToPoints(footerMarginBottomCmValue); // Calcula a posição do rodapé a partir do pé

                const layoutOptions = {
                    isCustom: true,
                    topMargin: cmToPoints(parseFloat(marginTopCm.value)),
                    footerPosition: footerPosition
                };
                
                if (typeof generatePdfDocDefinition !== 'function') {
                    iframe.srcdoc = "<p style='padding: 20px; font-family: sans-serif; color: red;'>Erro: A função `generatePdfDocDefinition` não foi encontrada. Verifique se seu script externo foi carregado corretamente.</p>";
                    return;
                }

                const docDefinition = await generatePdfDocDefinition(reorderedDeclarations, letterheadBackground, layoutOptions, formData);

                const printer = pdfMake.createPdf(docDefinition);
                printer.getBlob((blob) => {
                    if (fullPdfBlobUrl) {
                        URL.revokeObjectURL(fullPdfBlobUrl);
                    }
                    fullPdfBlobUrl = URL.createObjectURL(blob);
                    renderPdfPageToIframe(fullPdfBlobUrl, currentPreviewPage);
                });

                const totalPages = reorderedDeclarations.length + 1;
                pageIndicator.textContent = `Página ${currentPreviewPage} / ${totalPages}`;
                prevPageBtn.disabled = currentPreviewPage === 1;
                nextPageBtn.disabled = currentPreviewPage >= totalPages;
            };

            async function renderPdfPageToIframe(pdfUrl, pageNum) {
                try {
                    const loadingTask = pdfjsLib.getDocument(pdfUrl);
                    const pdf = await loadingTask.promise;

                    if (pageNum > pdf.numPages || pageNum < 1) {
                        console.error("Página fora dos limites para pré-visualização:", pageNum, "de", pdf.numPages);
                        iframe.srcdoc = "<p style='padding: 20px; font-family: sans-serif; color: orange;'>Página não encontrada na visualização. Tente ajustar as margens ou a ordem das declarações.</p>";
                        return;
                    }

                    const page = await pdf.getPage(pageNum);
                    const scale = 1.5;
                    const viewport = page.getViewport({ scale: scale });

                    const canvas = document.createElement('canvas');
                    const context = canvas.getContext('2d');
                    canvas.height = viewport.height;
                    canvas.width = viewport.width;

                    const renderContext = {
                        canvasContext: context,
                        viewport: viewport,
                    };
                    
                    await page.render(renderContext).promise;
                    iframe.src = canvas.toDataURL('image/png');
                } catch (error) {
                    console.error("Erro ao renderizar página do PDF no iframe:", error);
                    iframe.srcdoc = "<p style='padding: 20px; font-family: sans-serif; color: red;'>Erro ao carregar a página para visualização. Verifique o console.</p>";
                }
            }

            dirigenteInput.addEventListener('input', () => validarCampo(dirigenteInput, /[^A-Za-zÀ-ÿ\s]/g, 'Apenas letras e espaços são permitidos.'));
            cargoInput.addEventListener('input', () => validarCampo(cargoInput, /[^A-Za-zÀ-ÿ\s]/g, 'Apenas letras e espaços são permitidos.'));
            cnpjInput.addEventListener('input', () => formatarEBuscarCNPJ(cnpjInput));
            propostaInput.addEventListener('input', () => formatarProposta(propostaInput));
            
            useLetterheadCheckbox.addEventListener('change', (event) => {
                letterheadUploadContainer.style.display = event.target.checked ? 'block' : 'none';
                if (!event.target.checked) {
                    letterheadFileInput.value = '';
                }
            });

            botaoGerarPDF.addEventListener('click', async (event) => {
                event.preventDefault(); 

                let formIsValid = true;
                const requiredInputs = declarationForm.querySelectorAll('[required]');
                requiredInputs.forEach(input => {
                    if (input.value.trim() === '') {
                        toggleErro(input, true, 'Campo obrigatório.');
                        formIsValid = false;
                    } else {
                        if (input.id === 'cnpj' && input.value.replace(/\D/g, '').length !== 14) { 
                            toggleErro(input, true, 'CNPJ inválido ou incompleto (14 dígitos).');
                            formIsValid = false;
                        } else if (input.id === 'proposta' && !(/^\d{6}\/\d{4}$/.test(input.value))) { 
                            toggleErro(input, true, 'Formato da proposta inválido (ex: 000000/AAAA).');
                            formIsValid = false;
                        } else {
                            toggleErro(input, false);
                        }
                    }
                });

                if (cnpjInput.classList.contains('success')) {
                    if (entidadeInput.value.trim() === '') {
                        toggleErro(entidadeInput, true, 'Nome da Entidade não preenchido. Verifique o CNPJ ou preencha manualmente.');
                        formIsValid = false;
                    }
                    if (enderecoInput.value.trim() === '') {
                        toggleErro(enderecoInput, true, 'Endereço não preenchido. Verifique o CNPJ ou preencha manualmente.');
                        formIsValid = false;
                    }
                    if (municipioInput.value.trim() === '') {
                        toggleErro(municipioInput, true, 'Município não preenchido. Verifique o CNPJ ou preencha manualmente.');
                        formIsValid = false;
                    }
                    if (ufInput.value.trim() === '') {
                        toggleErro(ufInput, true, 'UF não preenchida. Verifique o CNPJ ou preencha manualmente.');
                        formIsValid = false;
                    }
                } else if (cnpjInput.value.trim() !== '' && cnpjInput.value.replace(/\D/g, '').length === 14) {
                    if (!entidadeInput.classList.contains('success') || entidadeInput.value.trim() === '' || entidadeInput.value.includes('Buscando')) { 
                        toggleErro(entidadeInput, true, 'Dados da entidade não obtidos. Verifique o CNPJ ou conexão.');
                        formIsValid = false;
                    }
                }

                if (useLetterheadCheckbox.checked && !letterheadFileInput.files[0]) {
                    toggleErro(letterheadFileInput, true, 'Por favor, selecione um arquivo de papel timbrado.');
                    formIsValid = false;
                } else if (useLetterheadCheckbox.checked && letterheadFileInput.files[0]) {
                     toggleErro(letterheadFileInput, false);
                }

                if (!formIsValid) {
                    alert('Por favor, corrija os erros no formulário antes de gerar o PDF.');
                    return;
                }

                const formDataForPdf = {
                    dirigente: dirigenteInput.value,
                    cargoDirigente: cargoInput.value,
                    entidade: entidadeInput.value,
                    cnpj: cnpjInput.value,
                    endereco: enderecoInput.value,
                    uf: ufInput.value,
                    municipio: municipioInput.value,
                    proposta: propostaInput.value,
                    useLetterheadChecked: useLetterheadCheckbox.checked,
                    letterheadFile: letterheadFileInput.files[0]
                };

                if (useLetterheadCheckbox.checked && letterheadFileInput.files.length > 0) {
                    await openModal();
                } else {
                    if (typeof generateAllDeclarationsPDF === 'function') {
                        loadingMessage.style.display = 'flex';
                        await generateAllDeclarationsPDF(null, null, { isCustom: false }, formDataForPdf); 
                        loadingMessage.style.display = 'none';
                    } else {
                        alert("Erro: Função 'generateAllDeclarationsPDF' não encontrada. Verifique o arquivo script.js");
                    }
                }
            });

            confirmAndGenerateBtn.addEventListener('click', async () => {
                if (!footerMarginBottomCm || !marginTopCm) {
                    alert("Erro: Elementos de margem não encontrados. Recarregue a página.");
                    return;
                }

                const footerMarginBottomCmValue = parseFloat(footerMarginBottomCm.value);
                const footerPosition = PAGE_HEIGHT_POINTS - cmToPoints(footerMarginBottomCmValue);

                const layoutOptions = {
                    isCustom: true,
                    topMargin: cmToPoints(parseFloat(marginTopCm.value)),
                    footerPosition: footerPosition
                };
                
                const formDataForPdf = {
                    dirigente: dirigenteInput.value,
                    cargoDirigente: cargoInput.value,
                    entidade: entidadeInput.value,
                    cnpj: cnpjInput.value,
                    endereco: enderecoInput.value,
                    uf: ufInput.value,
                    municipio: municipioInput.value,
                    proposta: propostaInput.value,
                    useLetterheadChecked: useLetterheadCheckbox.checked,
                    letterheadFile: letterheadFileInput.files[0]
                };

                if (typeof generateAllDeclarationsPDF === 'function') {
                    closeModal();
                    loadingMessage.style.display = 'flex';
                    await generateAllDeclarationsPDF(reorderedDeclarations, letterheadBackground, layoutOptions, formDataForPdf);
                    loadingMessage.style.display = 'none';
                } else {
                    alert("Erro: Função 'generateAllDeclarationsPDF' não encontrada. Verifique o arquivo script.js");
                }
            });

            cancelLayoutBtn.addEventListener('click', closeModal);

            marginTopCm.addEventListener('input', () => {
                if (parseFloat(marginTopCm.value) > 7) {
                    marginTopCm.value = 7;
                    alert('Limite máximo de Margem Superior é 7 cm.');
                }
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(updatePreview, 300);
            });

            footerMarginBottomCm.addEventListener('input', () => {
                if (parseFloat(footerMarginBottomCm.value) > 6.5) {
                    footerMarginBottomCm.value = 6.5;
                    alert('Limite máximo de Margem Inferior do Rodapé é 6,5 cm.');
                }
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(updatePreview, 300);
            });
            
            nextPageBtn.addEventListener('click', () => {
                const totalPages = reorderedDeclarations.length + 1;
                if (currentPreviewPage < totalPages) {
                    currentPreviewPage++;
                    updatePreview();
                }
            });
            prevPageBtn.addEventListener('click', () => {
                if (currentPreviewPage > 1) {
                    currentPreviewPage--;
                    updatePreview();
                }
            });
        });
    </script>
</html>