<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerador de Declaração de Contrapartida</title>
    <style>
        :root {
            --primary-color: #003087;
            --primary-hover: #002766;
            --background-color: #f0f2f5;
            --container-bg: #ffffff;
            --text-color: #333;
            --input-border: #ddd;
            --input-focus-border: #003087;
            --header-footer-bg: #003087;
            --header-footer-text: #fff;
            --error-color: #d32f2f;
            --shadow-color: rgba(0, 0, 0, 0.1);
            --toggle-bg: #ccc;
            --toggle-ball: white;
        }

        .dark-mode {
            --primary-color: #5d8aff;
            --primary-hover: #4e75d1;
            --background-color: #1a1a1a;
            --container-bg: #2a2a2a;
            --text-color: #f0f0f0;
            --input-border: #555;
            --input-focus-border: #5d8aff;
            --header-footer-bg: #1e1e1e;
            --header-footer-text: #f0f0f0;
            --error-color: #ff6b6b;
            --shadow-color: rgba(0, 0, 0, 0.4);
            --toggle-bg: #5d8aff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background-color: var(--background-color);
            color: var(--text-color);
            line-height: 1.6;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px 0;
            transition: background-color 0.3s, color 0.3s;
        }

        header {
            background-color: var(--header-footer-bg);
            color: var(--header-footer-text);
            padding: 15px 40px;
            text-align: center;
            width: 100%;
            position: fixed;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 10px var(--shadow-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .theme-switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 28px;
        }
        .theme-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: var(--toggle-bg);
            transition: .4s;
            border-radius: 28px;
        }
        .slider:before {
            position: absolute;
            content: "";
            height: 20px;
            width: 20px;
            left: 4px;
            bottom: 4px;
            background-color: var(--toggle-ball);
            transition: .4s;
            border-radius: 50%;
        }
        input:checked + .slider {
            background-color: var(--primary-color);
        }
        .dark-mode input:checked + .slider {
            background-color: var(--primary-color);
        }
        input:focus + .slider {
            box-shadow: 0 0 1px var(--primary-color);
        }
        input:checked + .slider:before {
            transform: translateX(22px);
        }

        .container {
            background: var(--container-bg);
            padding: 30px 40px;
            border-radius: 10px;
            box-shadow: 0 4px 20px var(--shadow-color);
            max-width: 900px;
            width: 90%;
            text-align: left;
            margin-top: 100px;
            margin-bottom: 80px;
            transition: background-color 0.3s;
        }

        .container h2 {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--primary-color);
            margin-bottom: 25px;
            text-transform: uppercase;
            border-bottom: 2px solid var(--primary-color);
            padding-bottom: 10px;
            text-align: center;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px 25px;
        }

        .grid-full-width {
            grid-column: 1 / -1;
        }

        .input-container {
            display: flex;
            flex-direction: column;
        }

        label {
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
            color: var(--text-color);
            font-size: 1rem;
        }

        input[type="text"],
        input[type="number"],
        input[type="date"] {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid var(--input-border);
            border-radius: 6px;
            font-size: 1rem;
            background-color: var(--container-bg);
            color: var(--text-color);
            transition: border-color 0.3s, background-color 0.3s;
        }

        input[type="number"] {
            -moz-appearance: textfield;
        }
        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input:focus {
            border-color: var(--input-focus-border);
            outline: none;
            box-shadow: 0 0 5px rgba(0, 48, 135, 0.2);
        }

        input[readonly] {
            background-color: rgba(128, 128, 128, 0.1);
            cursor: not-allowed;
        }

        .error-message {
            color: var(--error-color);
            font-size: 0.9rem;
            margin-top: 5px;
            display: none;
        }

        button[type="submit"] {
            background-color: var(--primary-color);
            color: #fff;
            border: none;
            padding: 12px 25px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1.1rem;
            font-weight: 600;
            transition: background-color 0.3s, transform 0.2s;
            width: 100%;
            text-transform: uppercase;
            margin-top: 20px;
        }

        button[type="submit"]:hover {
            background-color: var(--primary-hover);
            transform: translateY(-2px);
        }

        footer {
            text-align: center;
            padding: 15px;
            background-color: var(--header-footer-bg);
            color: var(--header-footer-text);
            font-size: 0.9rem;
            width: 100%;
            position: fixed;
            bottom: 0;
            box-shadow: 0 -2px 8px var(--shadow-color);
        }

        @media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
</head>

<body>
    <header>
        <h1>Ministério do Esporte</h1>
        <label class="theme-switch">
            <input type="checkbox" id="theme-toggle-checkbox">
            <span class="slider"></span>
        </label>
    </header>

    <div class="container">
        <h2>Gerador de Declaração de Contrapartida</h2>
        <form id="declaracaoForm" onsubmit="event.preventDefault(); processarGeracaoPDFs();">
            <div class="form-grid">
                <div class="input-container">
                    <label for="nome">Nome do Representante <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="nome" placeholder="Ex.: Allison Adib Pinheiro" required>
                </div>
                <div class="input-container">
                    <label for="cargo">Cargo <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="cargo" placeholder="Ex.: Prefeito" required>
                </div>
                <div class="input-container">
                    <label for="matricula">Matrícula <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="matricula" placeholder="Ex.: 1241231" required>
                </div>
                <div class="input-container">
                    <label for="cnpj">CNPJ da Entidade <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="cnpj" placeholder="Ex.: 07.733.255/0001-57" maxlength="18" required oninput="formatCNPJ(this)">
                    <div id="cnpjError" class="error-message">Erro ao buscar. Verifique o CNPJ ou tente novamente.</div>
                </div>
                <div class="input-container grid-full-width">
                    <label for="entidade">Nome da Entidade <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="entidade" placeholder="Será preenchido automaticamente" readonly>
                    <input type="hidden" id="entidadeCidade">
                    <input type="hidden" id="entidadeUF">
                    <input type="hidden" id="entidadeEndereco">
                </div>
                <div class="input-container">
                    <label for="valorContrapartida">Valor da Contrapartida (R$) <span style="color: #d32f2f;">*</span></label>
                    <input type="number" id="valorContrapartida" placeholder="Ex.: 5000.00" step="0.01" required oninput="updateValorExtenso()">
                </div>
                <div class="input-container">
                    <label for="valorContrapartidaExtenso">Valor por Extenso <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="valorContrapartidaExtenso" placeholder="Será preenchido automaticamente" readonly>
                </div>
                <div class="input-container">
                    <label for="numeroProposta">Número da Proposta <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="numeroProposta" placeholder="Ex.: 112212/2024" maxlength="11" required oninput="formatProposta(this)">
                </div>
                <div class="input-container">
                    <label for="leiOrcamentaria">Lei Orçamentária nº <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="leiOrcamentaria" placeholder="Ex.: 114127/2024" required>
                </div>
                <div class="input-container">
                    <label for="dataLei">Data da Lei <span style="color: #d32f2f;">*</span></label>
                    <input type="date" id="dataLei" required>
                </div>
                <div class="input-container">
                    <label for="orgao">Órgão <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="orgao" placeholder="Ex.: Despesa Financeira de Esporte" required>
                </div>
                <div class="input-container">
                    <label for="unidade">Unidade <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="unidade" placeholder="Ex.: dawndawnda" required>
                </div>
                <div class="input-container">
                    <label for="funcao">Função <span style="color: #d32f2f;">*</span></label>
                    <input type="number" id="funcao" placeholder="Apenas números" required oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                </div>
                <div class="input-container">
                    <label for="subfuncao">Subfunção <span style="color: #d32f2f;">*</span></label>
                    <input type="number" id="subfuncao" placeholder="Apenas números" required oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                </div>
                <div class="input-container">
                    <label for="programa">Programa <span style="color: #d32f2f;">*</span></label>
                    <input type="number" id="programa" placeholder="Apenas números" required oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                </div>
                <div class="input-container">
                    <label for="atividade">Atividade <span style="color: #d32f2f;">*</span></label>
                    <input type="number" id="atividade" placeholder="Apenas números" required oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                </div>
                <div class="input-container">
                    <label for="naturezaDespesa">Natureza da Despesa <span style="color: #d32f2f;">*</span></label>
                    <input type="number" id="naturezaDespesa" placeholder="Apenas números" required oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                </div>
            </div>
            <div class="grid-full-width">
                <button type="submit">Gerar Declaração em PDF</button>
            </div>
        </form>
    </div>

    <footer>
        <p>&copy; <span id="currentYear"></span> Ministério do Esporte - Todos os direitos reservados</p>
    </footer>

    <script>
        document.getElementById('currentYear').textContent = new Date().getFullYear();

        const themeToggle = document.getElementById('theme-toggle-checkbox');
        const body = document.body;

        themeToggle.addEventListener('change', (event) => {
            if (event.target.checked) {
                body.classList.add('dark-mode');
                localStorage.setItem('theme', 'dark');
            } else {
                body.classList.remove('dark-mode');
                localStorage.setItem('theme', 'light');
            }
        });

        document.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('theme') || 'light';
            if (savedTheme === 'dark') {
                body.classList.add('dark-mode');
                themeToggle.checked = true;
            }
        });

        function formatCNPJ(input) {
            let value = input.value.replace(/\D/g, '');
            if (value.length > 14) value = value.slice(0, 14);
            if (value.length > 12) value = value.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})/, '$1.$2.$3/$4-$5');
            else if (value.length > 8) value = value.replace(/^(\d{2})(\d{3})(\d{3})(\d{1,4})/, '$1.$2.$3/$4');
            else if (value.length > 5) value = value.replace(/^(\d{2})(\d{3})(\d{1,3})/, '$1.$2.$3');
            else if (value.length > 2) value = value.replace(/^(\d{2})(\d{1,3})/, '$1.$2');
            input.value = value;

            if (input.value.length === 18) {
                fetchEntidade(value.replace(/\D/g, ''));
            } else {
                document.getElementById('entidade').value = '';
                document.getElementById('entidadeCidade').value = '';
                document.getElementById('entidadeUF').value = '';
                document.getElementById('entidadeEndereco').value = '';
                document.getElementById('cnpjError').style.display = 'none';
            }
        }

        async function fetchEntidade(cnpj) {
            try {
                const response = await fetch(`https://brasilapi.com.br/api/cnpj/v1/${cnpj}`);
                if (!response.ok) throw new Error(`Erro ${response.status}`);
                const data = await response.json();
                document.getElementById('entidade').value = data.razao_social || 'Entidade não encontrada';
                document.getElementById('entidadeCidade').value = data.municipio || '';
                document.getElementById('entidadeUF').value = data.uf || '';
                document.getElementById('entidadeEndereco').value = data.logradouro ? `${data.logradouro}, ${data.numero}, ${data.bairro}, ${data.cep}` : 'Endereço não informado';
                document.getElementById('cnpjError').style.display = 'none';
            } catch (error) {
                document.getElementById('entidade').value = 'Erro ao buscar entidade';
                document.getElementById('entidadeCidade').value = '';
                document.getElementById('entidadeUF').value = '';
                document.getElementById('entidadeEndereco').value = '';
                document.getElementById('cnpjError').style.display = 'block';
            }
        }

        function formatProposta(input) {
            let value = input.value.replace(/\D/g, '');
            if (value.length > 10) value = value.slice(0, 10);
            if (value.length > 6) value = value.replace(/^(\d{6})(\d{0,4})/, '$1/$2');
            input.value = value;
        }

        function updateValorExtenso() {
            const valor = parseFloat(document.getElementById('valorContrapartida').value) || 0;
            if (valor >= 0 && valor <= 9999.99) {
                const unidades = ['zero', 'um', 'dois', 'três', 'quatro', 'cinco', 'seis', 'sete', 'oito', 'nove'];
                const dezenas = ['dez', 'onze', 'doze', 'treze', 'quatorze', 'quinze', 'dezesseis', 'dezessete', 'dezoito', 'dezenove'];
                const dezenasMultiplas = ['', '', 'vinte', 'trinta', 'quarenta', 'cinquenta', 'sessenta', 'setenta', 'oitenta', 'noventa'];
                const centenas = ['', 'cento', 'duzentos', 'trezentos', 'quatrocentos', 'quinhentos', 'seiscentos', 'setecentos', 'oitocentos', 'novecentos'];

                const inteiro = Math.floor(valor);

                let extenso = '';
                if (inteiro === 0) {
                    extenso = 'zero';
                } else {
                    const milhar = Math.floor(inteiro / 1000);
                    const centena = Math.floor((inteiro % 1000) / 100);
                    const dezena = Math.floor((inteiro % 100) / 10);
                    const unidade = inteiro % 10;

                    if (milhar > 0) {
                        extenso += unidades[milhar] + ' mil ';
                    }
                    if (centena > 0) {
                        extenso += centenas[centena] + ' ';
                    }
                    if (dezena > 1) {
                        extenso += dezenasMultiplas[dezena] + ' ';
                        if (unidade > 0) extenso += 'e ' + unidades[unidade];
                    } else if (dezena === 1) {
                        extenso += dezenas[unidade];
                    } else if (unidade > 0) {
                        extenso += unidades[unidade];
                    }
                }

                extenso = extenso.charAt(0).toUpperCase() + extenso.slice(1) + ' reais';
                document.getElementById('valorContrapartidaExtenso').value = extenso;
            } else {
                document.getElementById('valorContrapartidaExtenso').value = 'Valor fora do intervalo suportado';
            }
        }

        async function getBase64ImageFromUrl(url) {
            try {
                const response = await fetch(url);
                if (!response.ok) throw new Error(`Erro ao buscar imagem: ${response.statusText}`);
                const blob = await response.blob();
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onloadend = () => resolve(reader.result);
                    reader.onerror = reject;
                    reader.readAsDataURL(blob);
                });
            } catch (err) {
                console.error("Não foi possível carregar a imagem de fundo.", err);
                alert("Atenção: A imagem de fundo não pôde ser carregada. O PDF será gerado sem ela.");
                return null;
            }
        }

        function createDeclarationContent(dados) {
            const {
                nome, cargo, matricula, entidade, endereco, cnpj, valorFormatado, valorExtenso,
                numeroProposta, leiOrcamentaria, diaLei, mesLei, anoLei, orgao, unidade,
                funcao, subfuncao, programa, atividade, naturezaDespesa, localAssinatura
            } = dados;

            return [
                { text: entidade, style: 'entityName', alignment: 'center', margin: [0, 0, 0, 20] },
                { text: endereco, style: 'entityAddress', alignment: 'center', margin: [0, 0, 0, 40] },
                { text: 'DECLARAÇÃO DE DISPONIBILIDADE DE CONTRAPARTIDA', style: 'header', alignment: 'center', margin: [0, 0, 0, 20] },
                {
                    text: `Eu, ${nome}, matrícula nº ${matricula}, na condição de ${cargo} do(a) ${entidade}, CNPJ Nº ${cnpj}, DECLARO, em conformidade com a Lei de Diretrizes Orçamentárias vigente, que a presente Entidade dispõe e se compromete com o montante financeiro de R$ ${valorFormatado} (${valorExtenso}), referente a contrapartida financeira destinada ao cumprimento do objeto constante da Proposta nº ${numeroProposta}, do Sistema Transferegov.`,
                    style: 'default', margin: [0, 0, 0, 10]
                },
                {
                    text: `Os recursos estão disponíveis na Lei Orçamentária Municipal/Estadual nº ${leiOrcamentaria}, de ${diaLei} de ${mesLei} de ${anoLei}, conforme rubrica orçamentária abaixo especificada, e cópia anexa:`,
                    style: 'default', margin: [0, 0, 0, 10]
                },
                {
                    text: `Órgão: ${orgao}\nUnidade: ${unidade}\nFunção: ${funcao}\nSubfunção: ${subfuncao}\nPrograma: ${programa}\nAtividade: ${atividade}\nNatureza da Despesa: ${naturezaDespesa}`,
                    style: 'default', margin: [0, 0, 0, 20]
                },
                { text: 'Por ser expressão da verdade, firmo a presente declaração.', style: 'default', margin: [0, 0, 0, 30] },
                { text: `${localAssinatura}, ${new Date().toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}`, style: 'default', alignment: 'center', margin: [0, 0, 0, 20] },
                {
                    canvas: [{ type: 'line', x1: 0, y1: 0, x2: 515, y2: 0, lineWidth: 1, lineColor: '#000000' }],
                    margin: [0, 0, 0, 10]
                },
                { text: nome.toUpperCase(), style: 'default', alignment: 'center', margin: [0, 0, 0, 5] },
                { text: cargo, style: 'default', alignment: 'center' }
            ];
        }

        async function processarGeracaoPDFs() {
            try {
                const dados = {
                    nome: document.getElementById('nome').value.trim(),
                    cargo: document.getElementById('cargo').value,
                    matricula: document.getElementById('matricula').value,
                    entidade: document.getElementById('entidade').value,
                    endereco: document.getElementById('entidadeEndereco').value,
                    cnpj: document.getElementById('cnpj').value,
                    valorFormatado: parseFloat(document.getElementById('valorContrapartida').value).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
                    valorExtenso: document.getElementById('valorContrapartidaExtenso').value,
                    numeroProposta: document.getElementById('numeroProposta').value,
                    leiOrcamentaria: document.getElementById('leiOrcamentaria').value,
                    diaLei: new Date(document.getElementById('dataLei').value).getDate(),
                    mesLei: new Date(document.getElementById('dataLei').value).toLocaleString('pt-BR', { month: 'long' }),
                    anoLei: new Date(document.getElementById('dataLei').value).getFullYear(),
                    orgao: document.getElementById('orgao').value,
                    unidade: document.getElementById('unidade').value,
                    funcao: document.getElementById('funcao').value,
                    subfuncao: document.getElementById('subfuncao').value,
                    programa: document.getElementById('programa').value,
                    atividade: document.getElementById('atividade').value,
                    naturezaDespesa: document.getElementById('naturezaDespesa').value,
                    localAssinatura: document.getElementById('entidadeCidade').value && document.getElementById('entidadeUF').value ? `${document.getElementById('entidadeCidade').value}/${document.getElementById('entidadeUF').value}` : 'Local não informado'
                };

                if (document.getElementById('entidade').value.includes('Erro')) {
                    alert('Por favor, corrija o erro no CNPJ antes de gerar o PDF.');
                    return;
                }

                const watermarkImage = await getBase64ImageFromUrl('https://i.ibb.co/Lz10svWs/Declara-es-page-0001.jpg');
                const docDefinition = {
                    pageSize: 'A4',
                    pageMargins: [40, 80, 40, 60],
                    background: () => watermarkImage ? { image: watermarkImage, width: 595.28, height: 841.89, absolutePosition: { x: 0, y: 0 } } : null,
                    content: createDeclarationContent(dados),
                    styles: {
                        header: { fontSize: 14, bold: true, color: '#003087' },
                        entityName: { bold: true, alignment: 'center', fontSize: 12 },
                        entityAddress: { fontSize: 10, alignment: 'center' }
                    },
                    defaultStyle: { font: 'Roboto', fontSize: 11, alignment: 'justify', color: '#000000' }
                };

                pdfMake.createPdf(docDefinition).download(`Declaração_${dados.nome.replace(/\s+/g, '_')}.pdf`);
                alert('Declaração gerada com sucesso!');
            } catch (error) {
                console.error('Erro ao gerar PDF:', error);
                alert('Ocorreu um erro ao gerar o PDF. Verifique os dados e o console de erros.');
            }
        }
    </script>
</body>

</html>