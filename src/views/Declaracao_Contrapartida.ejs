<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Declaração de Disponibilidade de Contrapartida - Ministério do Esporte</title>
    <style>
        /* Estilos Globais e Variáveis de Tema */
        :root {
            --primary-color: #003087;
            --primary-hover: #002766;
            --background-color: #f0f2f5;
            --container-bg: #ffffff;
            --text-color: #333;
            --input-border: #ddd;
            --input-focus-border: #003087;
            --header-footer-bg: #003087;
            --header-footer-text: #fff;
            --error-color: #d32f2f;
            --shadow-color: rgba(0, 0, 0, 0.1);
            --toggle-bg: #ccc;
            --toggle-ball: white;
        }

        .dark-mode {
            --primary-color: #5d8aff;
            --primary-hover: #4e75d1;
            --background-color: #1a1a1a;
            --container-bg: #2a2a2a;
            --text-color: #f0f0f0;
            --input-border: #555;
            --input-focus-border: #5d8aff;
            --header-footer-bg: #1e1e1e;
            --header-footer-text: #f0f0f0;
            --error-color: #ff6b6b;
            --shadow-color: rgba(0, 0, 0, 0.4);
            --toggle-bg: #5d8aff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background-color: var(--background-color);
            color: var(--text-color);
            line-height: 1.6;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px 0;
            transition: background-color 0.3s, color 0.3s;
        }

        header {
            background-color: var(--header-footer-bg);
            color: var(--header-footer-text);
            padding: 15px 40px;
            text-align: center;
            width: 100%;
            position: fixed;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 10px var(--shadow-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 1.5rem;
            font-weight: 700;
        }

        /* --- ESTILOS DO NOVO SELETOR DE TEMA (TOGGLE SWITCH) --- */
        .theme-switch {
            position: relative;
            display: inline-block;
            width: 50px; /* Largura do trilho */
            height: 28px; /* Altura do trilho */
        }
        .theme-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: var(--toggle-bg);
            transition: .4s;
            border-radius: 28px;
        }
        .slider:before {
            position: absolute;
            content: "";
            height: 20px; /* Tamanho da bolinha */
            width: 20px; /* Tamanho da bolinha */
            left: 4px;
            bottom: 4px;
            background-color: var(--toggle-ball);
            transition: .4s;
            border-radius: 50%;
        }
        input:checked + .slider {
            background-color: var(--primary-color);
        }
        .dark-mode input:checked + .slider {
             background-color: var(--primary-color);
        }
        input:focus + .slider {
            box-shadow: 0 0 1px var(--primary-color);
        }
        input:checked + .slider:before {
            transform: translateX(22px); /* Distância que a bolinha se move */
        }
        /* --- FIM DOS ESTILOS DO SELETOR --- */


        .container {
            background: var(--container-bg);
            padding: 30px 40px;
            border-radius: 10px;
            box-shadow: 0 4px 20px var(--shadow-color);
            max-width: 900px;
            width: 90%;
            text-align: left;
            margin-top: 100px;
            margin-bottom: 80px;
            transition: background-color 0.3s;
        }

        .container h2 {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--primary-color);
            margin-bottom: 25px;
            text-transform: uppercase;
            border-bottom: 2px solid var(--primary-color);
            padding-bottom: 10px;
            text-align: center;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px 25px;
        }
        
        .grid-full-width {
            grid-column: 1 / -1;
        }

        .input-container {
            display: flex;
            flex-direction: column;
        }

        label {
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
            color: var(--text-color);
            font-size: 1rem;
        }

        input[type="text"],
        input[type="number"],
        input[type="date"] {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid var(--input-border);
            border-radius: 6px;
            font-size: 1rem;
            background-color: var(--container-bg);
            color: var(--text-color);
            transition: border-color 0.3s, background-color 0.3s;
        }

        input:focus {
            border-color: var(--input-focus-border);
            outline: none;
            box-shadow: 0 0 5px rgba(0, 48, 135, 0.2);
        }
        
        input[readonly] {
            background-color: rgba(128, 128, 128, 0.1);
            cursor: not-allowed;
        }

        .error-message {
            color: var(--error-color);
            font-size: 0.9rem;
            margin-top: 5px;
            display: none;
        }

        button[type="submit"] {
            background-color: var(--primary-color);
            color: #fff;
            border: none;
            padding: 12px 25px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1.1rem;
            font-weight: 600;
            transition: background-color 0.3s, transform 0.2s;
            width: 100%;
            text-transform: uppercase;
            margin-top: 20px;
        }

        button[type="submit"]:hover {
            background-color: var(--primary-hover);
            transform: translateY(-2px);
        }

        footer {
            text-align: center;
            padding: 15px;
            background-color: var(--header-footer-bg);
            color: var(--header-footer-text);
            font-size: 0.9rem;
            width: 100%;
            position: fixed;
            bottom: 0;
            box-shadow: 0 -2px 8px var(--shadow-color);
        }
        
        @media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <header>
        <h1>Ministério do Esporte</h1>
        <label class="theme-switch">
            <input type="checkbox" id="theme-toggle-checkbox">
            <span class="slider"></span>
        </label>
    </header>

    <div class="container">
        <h2>Gerador de Declaração de Contrapartida</h2>
        <form id="declaracaoForm" onsubmit="event.preventDefault(); generatePDF();">
            <div class="form-grid">
                <div class="input-container">
                    <label for="nome">Nome do Representante <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="nome" placeholder="Ex.: Allison Adib Pinheiro" required>
                </div>
                <div class="input-container">
                    <label for="cargo">Cargo <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="cargo" placeholder="Ex.: Prefeito" required>
                </div>
                <div class="input-container">
                    <label for="matricula">Matrícula <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="matricula" placeholder="Ex.: 1241231" required>
                </div>
                 <div class="input-container">
                    <label for="cnpj">CNPJ da Entidade <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="cnpj" placeholder="Ex.: 27.119.091/0001-35" maxlength="18" required oninput="formatCNPJ(this)">
                    <div id="cnpjError" class="error-message">Erro ao buscar. Verifique o CNPJ ou tente novamente.</div>
                </div>
                <div class="input-container grid-full-width">
                    <label for="entidade">Nome da Entidade <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="entidade" placeholder="Será preenchido automaticamente" readonly>
                    <input type="hidden" id="entidadeCidade">
                    <input type="hidden" id="entidadeUF">
                </div>
                <div class="input-container">
                    <label for="valorContrapartida">Valor da Contrapartida (R$) <span style="color: #d32f2f;">*</span></label>
                    <input type="number" id="valorContrapartida" step="0.01" placeholder="Ex.: 5000.00" required oninput="convertToExtenso()">
                </div>
                <div class="input-container">
                    <label for="valorContrapartidaExtenso">Valor por Extenso <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="valorContrapartidaExtenso" placeholder="Será gerado automaticamente" readonly>
                </div>
                 <div class="input-container">
                    <label for="numeroProposta">Número da Proposta <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="numeroProposta" placeholder="Ex.: 004947/2024" required>
                </div>
                <div class="input-container">
                    <label for="leiOrcamentaria">Lei Orçamentária nº <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="leiOrcamentaria" placeholder="Ex.: 1412/2025" required>
                </div>
                <div class="input-container">
                    <label for="dataLei">Data da Lei <span style="color: #d32f2f;">*</span></label>
                    <input type="date" id="dataLei" required>
                </div>
                <div class="input-container">
                    <label for="orgao">Órgão <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="orgao" placeholder="Ex.: Secretaria Nacional de Esporte" required>
                </div>
                <div class="input-container">
                    <label for="unidade">Unidade <span style="color: #d32f2f;">*</span></label>
                    <input type="text" id="unidade" placeholder="Ex.: Fundo Municipal de Esportes" required>
                </div>
                <div class="input-container">
                    <label for="funcao">Função <span style="color: #d32f2f;">*</span></label>
                    <input type="number" id="funcao" placeholder="Apenas números" required>
                </div>
                 <div class="input-container">
                    <label for="subfuncao">Subfunção <span style="color: #d32f2f;">*</span></label>
                    <input type="number" id="subfuncao" placeholder="Apenas números" required>
                </div>
                <div class="input-container">
                    <label for="programa">Programa <span style="color: #d32f2f;">*</span></label>
                    <input type="number" id="programa" placeholder="Apenas números" required>
                </div>
                <div class="input-container">
                    <label for="atividade">Atividade <span style="color: #d32f2f;">*</span></label>
                    <input type="number" id="atividade" placeholder="Apenas números" required>
                </div>
                <div class="input-container">
                    <label for="naturezaDespesa">Natureza da Despesa <span style="color: #d32f2f;">*</span></label>
                    <input type="number" id="naturezaDespesa" placeholder="Apenas números" required>
                </div>
            </div>
            <div class="grid-full-width">
                <button type="submit">Gerar Declaração em PDF</button>
            </div>
        </form>
    </div>

    <footer>
        <p>&copy; <span id="currentYear"></span> Ministério do Esporte - Todos os direitos reservados</p>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        document.getElementById('currentYear').textContent = new Date().getFullYear();

        // --- LÓGICA ATUALIZADA DO SELETOR DE TEMA ---
        const themeToggle = document.getElementById('theme-toggle-checkbox');
        const body = document.body;

        themeToggle.addEventListener('change', (event) => {
            if (event.target.checked) {
                body.classList.add('dark-mode');
                localStorage.setItem('theme', 'dark');
            } else {
                body.classList.remove('dark-mode');
                localStorage.setItem('theme', 'light');
            }
        });

        document.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('theme') || 'light';
            if (savedTheme === 'dark') {
                body.classList.add('dark-mode');
                themeToggle.checked = true; // Sincroniza o estado visual do seletor
            }
        });
        
        function formatCNPJ(input) {
            let value = input.value.replace(/\D/g, '');
            if (value.length > 14) value = value.slice(0, 14);
            if (value.length > 12) value = value.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})/, '$1.$2.$3/$4-$5');
            else if (value.length > 8) value = value.replace(/^(\d{2})(\d{3})(\d{3})(\d{1,4})/, '$1.$2.$3/$4');
            else if (value.length > 5) value = value.replace(/^(\d{2})(\d{3})(\d{1,3})/, '$1.$2.$3');
            else if (value.length > 2) value = value.replace(/^(\d{2})(\d{1,3})/, '$1.$2');
            input.value = value;
            
            if (input.value.length === 18) {
                fetchEntidade(value.replace(/\D/g, ''));
            } else {
                document.getElementById('entidade').value = '';
                document.getElementById('entidadeCidade').value = '';
                document.getElementById('entidadeUF').value = '';
                document.getElementById('cnpjError').style.display = 'none';
            }
        }

        async function fetchEntidade(cnpj) {
            try {
                const response = await fetch(`https://brasilapi.com.br/api/cnpj/v1/${cnpj}`);
                if (!response.ok) throw new Error(`Erro ${response.status}`);
                const data = await response.json();
                document.getElementById('entidade').value = data.razao_social || 'Entidade não encontrada';
                document.getElementById('entidadeCidade').value = data.municipio || '';
                document.getElementById('entidadeUF').value = data.uf || '';
                document.getElementById('cnpjError').style.display = 'none';
            } catch (error) {
                document.getElementById('entidade').value = 'Erro ao buscar entidade';
                document.getElementById('entidadeCidade').value = '';
                document.getElementById('entidadeUF').value = '';
                document.getElementById('cnpjError').style.display = 'block';
            }
        }
        
        function convertToExtenso() {
             const valor = parseFloat(document.getElementById('valorContrapartida').value) || 0;
             if (valor <= 0) {
                 document.getElementById('valorContrapartidaExtenso').value = '';
                 return;
             }
             const unidades = ["", "um", "dois", "três", "quatro", "cinco", "seis", "sete", "oito", "nove"],
               dezenas = ["", "dez", "vinte", "trinta", "quarenta", "cinquenta", "sessenta", "setenta", "oitenta", "noventa"],
               centenas = ["", "cento", "duzentos", "trezentos", "quatrocentos", "quinhentos", "seiscentos", "setecentos", "oitocentos", "novecentos"],
               especiais = ["dez", "onze", "doze", "treze", "catorze", "quinze", "dezesseis", "dezessete", "dezoito", "dezenove"];

             function getExtenso(n) {
                 if (n === 0) return "";
                 if (n === 100) return "cem";
                 let str = "";
                 const c = Math.floor(n / 100),
                   d = Math.floor((n % 100) / 10),
                   u = n % 10;
                 if (c > 0) {
                     str += centenas[c];
                     if (n % 100 !== 0) str += " e ";
                 }
                 if (d > 0) {
                     if (d === 1) {
                         str += especiais[u];
                         return str;
                     }
                     str += dezenas[d];
                     if (u > 0) str += " e ";
                 }
                 if (u > 0 && d !== 1) str += unidades[u];
                 return str;
             }
             let inteiro = Math.floor(valor),
               centavos = Math.round((valor - inteiro) * 100),
               extenso = "";
             if (inteiro > 0) {
                 if (inteiro === 1) extenso += "um real";
                 else {
                     let partes = [],
                       milharCount = 0;
                     while (inteiro > 0) {
                         let parte = inteiro % 1000;
                         if (parte > 0) {
                             let parteExtenso = getExtenso(parte);
                             if (milharCount === 1) parteExtenso += " mil";
                             if (milharCount === 2) parteExtenso += (parte > 1 ? " milhões" : " milhão");
                             partes.unshift(parteExtenso);
                         }
                         inteiro = Math.floor(inteiro / 1000);
                         milharCount++;
                     }
                     extenso += partes.join(" e ").replace(/ e mil$/, " mil") + " reais";
                 }
             }
             if (centavos > 0) {
                 if (extenso !== "") extenso += " e ";
                 if (centavos === 1) extenso += "um centavo";
                 else extenso += getExtenso(centavos) + " centavos";
             }
             document.getElementById('valorContrapartidaExtenso').value = extenso.charAt(0).toUpperCase() + extenso.slice(1);
         }

        async function getBase64ImageFromUrl(url) {
            try {
                const response = await fetch(url);
                if (!response.ok) throw new Error(`Erro ao buscar imagem: ${response.statusText}`);
                const blob = await response.blob();
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onloadend = () => resolve(reader.result);
                    reader.onerror = reject;
                    reader.readAsDataURL(blob);
                });
            } catch (err) {
                console.error("Não foi possível carregar a imagem de fundo.", err);
                alert("Atenção: A imagem de fundo não pôde ser carregada. O PDF será gerado sem ela.");
                return null;
            }
        }

        async function generatePDF() {
            try {
                if (!window.jspdf) {
                    alert('Erro: Biblioteca jsPDF não foi carregada.');
                    return;
                }
                if (document.getElementById('entidade').value.includes('Erro')) {
                    alert('Por favor, corrija o erro no CNPJ antes de gerar o PDF.');
                    return;
                }

                const { jsPDF } = window.jspdf;
                const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
                
                const backgroundImgUrl = 'https://i.ibb.co/Lz10svWs/Declara-es-page-0001.jpg';
                const backgroundImgData = await getBase64ImageFromUrl(backgroundImgUrl);
                
                if (backgroundImgData) {
                    doc.addImage(backgroundImgData, 'JPEG', 0, 0, 210, 297);
                }

                const pageHeight = doc.internal.pageSize.getHeight();
                const pageWidth = doc.internal.pageSize.getWidth();
                const margin = 30;
                const maxWidth = pageWidth - margin * 2;
                let y = 60;

                doc.setFont('helvetica', 'bold');
                doc.setFontSize(14);
                doc.setTextColor(0, 0, 0);
                doc.text("DECLARAÇÃO DE DISPONIBILIDADE DE CONTRAPARTIDA", pageWidth / 2, y, { align: 'center' });
                y += 20;

                doc.setFont('helvetica', 'normal');
                doc.setFontSize(12);
                doc.setTextColor(0, 0, 0);

                const nome = document.getElementById('nome').value;
                const cargo = document.getElementById('cargo').value;
                const matricula = document.getElementById('matricula').value;
                const entidade = document.getElementById('entidade').value;
                const cidade = document.getElementById('entidadeCidade').value;
                const uf = document.getElementById('entidadeUF').value;
                const localAssinatura = (cidade && uf) ? `${cidade}/${uf}` : 'Local não informado';
                const cnpj = document.getElementById('cnpj').value;
                const valorFormatado = parseFloat(document.getElementById('valorContrapartida').value).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const valorExtenso = document.getElementById('valorContrapartidaExtenso').value;
                const numeroProposta = document.getElementById('numeroProposta').value;
                const leiOrcamentaria = document.getElementById('leiOrcamentaria').value;
                const dataLei = new Date(document.getElementById('dataLei').value + 'T00:00:00');
                const diaLei = dataLei.getDate();
                const mesLei = dataLei.toLocaleString('pt-BR', { month: 'long' });
                const anoLei = dataLei.getFullYear();
                const orgao = document.getElementById('orgao').value;
                const unidade = document.getElementById('unidade').value;
                const funcao = document.getElementById('funcao').value;
                const subfuncao = document.getElementById('subfuncao').value;
                const programa = document.getElementById('programa').value;
                const atividade = document.getElementById('atividade').value;
                const naturezaDespesa = document.getElementById('naturezaDespesa').value;

                const addTextRobust = (text, startY) => {
                    const lineSpacing = 7;
                    const lines = doc.splitTextToSize(text, maxWidth);
                    if (startY + (lines.length * lineSpacing) > pageHeight - margin) {
                        doc.addPage();
                        if (backgroundImgData) {
                            doc.addImage(backgroundImgData, 'JPEG', 0, 0, 210, 297);
                        }
                        startY = 40;
                    }
                    lines.forEach(line => {
                        doc.text(line, margin, startY, { align: 'left', lineHeightFactor: 1.5 });
                        startY += lineSpacing;
                    });
                    return startY;
                };
                
                const text1 = `Eu, ${nome}, matrícula nº ${matricula}, na condição de ${cargo} do(a) ${entidade}, CNPJ Nº ${cnpj}, DECLARO, em conformidade com a Lei de Diretrizes Orçamentárias vigente, que a presente Entidade dispõe e se compromete com o montante financeiro de R$ ${valorFormatado} (${valorExtenso}), referente a contrapartida financeira destinada ao cumprimento do objeto constante da Proposta n.º ${numeroProposta}, do Sistema Transferegov.`;
                y = addTextRobust(text1, y);
                y += 5;

                const text2 = `Os recursos estão disponíveis na Lei Orçamentária Municipal/Estadual nº ${leiOrcamentaria}, de ${diaLei} de ${mesLei} de ${anoLei}, conforme rubrica orçamentária abaixo especificada, e cópia anexa:`;
                y = addTextRobust(text2, y);
                y += 7;

                const rubricaText = `Órgão: ${orgao}\nUnidade: ${unidade}\nFunção: ${funcao}\nSubfunção: ${subfuncao}\nPrograma: ${programa}\nAtividade: ${atividade}\nNatureza da Despesa: ${naturezaDespesa}`;
                y = addTextRobust(rubricaText, y);
                y += 7;

                const text3 = `Por ser expressão da verdade, firmo a presente declaração.`;
                y = addTextRobust(text3, y);
                y += 20;
                
                const dataAtual = new Date().toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' });
                doc.text(`${localAssinatura}, ${dataAtual}`, pageWidth / 2, y, { align: 'center' });
                y += 25;
                
                const lineLength = 80;
                const lineX = (pageWidth - lineLength) / 2;
                doc.line(lineX, y, lineX + lineLength, y);
                y += 7;

                doc.setFont('helvetica', 'bold');
                doc.text(nome.toUpperCase(), pageWidth / 2, y, { align: 'center' });
                y += 7;
                doc.setFont('helvetica', 'normal');
                doc.text(cargo, pageWidth / 2, y, { align: 'center' });
                
                doc.save(`Declaracao_Contrapartida_${entidade.replace(/\s/g, '_')}.pdf`);
                alert('Declaração gerada com sucesso!');

            } catch (error) {
                console.error('Erro ao gerar PDF:', error);
                alert('Ocorreu um erro ao gerar o PDF. Verifique os dados e o console de erros.');
            }
        }
    </script>
</body>

</html>