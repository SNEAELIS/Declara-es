<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Gerador de Declarações - Convênio - Ministério do Esporte</title>

    <!-- Fontes oficiais GOV.BR -->
    <link rel="stylesheet" href="https://cdngovbr-ds.estaleiro.serpro.gov.br/design-system/fonts/rawline/css/rawline.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Raleway:300,400,500,600,700,800,900&display=swap">

    <!-- Design System GOV.BR -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@govbr-ds/core@3.3.2/dist/core.min.css">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Rawline', 'Raleway', sans-serif;
            background: #EDF2FF;
            color: #333;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding-bottom: 60px;
        }

        /* ── BARRA DO GOVERNO ── */
        #gov-bar {
            background: #071D41;
            padding: 5px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
        }

        .gov-bar-brand {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 700;
            color: #fff;
            letter-spacing: 0.5px;
        }

        .gov-bar-links {
            display: flex;
            gap: 16px;
            list-style: none;
            flex-wrap: wrap;
        }

        .gov-bar-links a {
            font-size: 11px;
            color: rgba(255,255,255,0.65);
            text-decoration: none;
            white-space: nowrap;
        }

        .gov-bar-links a:hover { color: #fff; text-decoration: underline; }

        /* ── HEADER ── */
        .ministry-header {
            background: #fff;
            border-bottom: 1px solid #D9D9D9;
            padding: 0 24px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        }

        .header-top-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            gap: 16px;
        }

        .header-logo-area {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .govbr-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 14px;
            font-weight: 700;
            color: #1351B4;
            text-decoration: none;
        }

        .divider-v {
            width: 1px;
            height: 32px;
            background: #D9D9D9;
        }

        .ministry-name {
            font-size: 15px;
            font-weight: 700;
            color: #071D41;
            line-height: 1.2;
        }

        .ministry-name small {
            display: block;
            font-size: 11px;
            font-weight: 400;
            color: #555;
        }

        .header-actions { display: flex; align-items: center; gap: 8px; }

        .icon-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid #D9D9D9;
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: #333;
            font-size: 14px;
            transition: background 0.15s;
        }

        .icon-btn:hover { background: #f0f0f0; }

        .header-bottom-row {
            padding: 7px 0;
            border-top: 1px solid #EFEFEF;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: #555;
            font-weight: 500;
        }

        /* ── BREADCRUMB ── */
        .breadcrumb-bar {
            background: #F8F8F8;
            border-bottom: 1px solid #E5E5E5;
            padding: 8px 24px;
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            flex-wrap: wrap;
        }

        .breadcrumb-bar a { color: #1351B4; text-decoration: none; }
        .breadcrumb-bar a:hover { text-decoration: underline; }
        .breadcrumb-bar .sep { color: #999; }
        .breadcrumb-bar .current { color: #333; font-weight: 600; }

        /* ── MAIN ── */
        #main-content {
            flex: 1;
            padding: 32px 24px;
            max-width: 960px;
            width: 100%;
            margin: 0 auto;
        }

        /* ── PAGE HEADER ── */
        .page-header {
            background: #fff;
            border-radius: 8px;
            border-top: 4px solid #1351B4;
            padding: 24px 28px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 8px rgba(19,81,180,0.07);
        }

        .page-header-left { display: flex; align-items: center; gap: 16px; }

        .page-header-icon {
            width: 48px;
            height: 48px;
            background: #EDF2FF;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #1351B4;
            font-size: 20px;
            flex-shrink: 0;
        }

        .page-header h2 {
            font-size: 18px;
            font-weight: 700;
            color: #071D41;
            font-family: 'Raleway', sans-serif;
        }

        .page-header p {
            font-size: 12px;
            color: #666;
            margin-top: 2px;
        }

        .status-badge {
            font-size: 11px;
            font-weight: 700;
            color: #1351B4;
            background: #EDF2FF;
            padding: 5px 14px;
            border-radius: 100px;
            border: 1px solid #C5D4FF;
            white-space: nowrap;
        }

        /* ── TAB STEPS ── */
        .steps-nav {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0;
            margin-bottom: 24px;
            background: #fff;
            border-radius: 8px;
            padding: 20px 24px;
            box-shadow: 0 2px 8px rgba(19,81,180,0.07);
            border: 1px solid #E5E5E5;
            overflow-x: auto;
        }

        .step-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            position: relative;
            flex: 1;
            min-width: 90px;
        }

        .step-item:not(:last-child)::after {
            content: '';
            position: absolute;
            top: 18px;
            left: calc(50% + 20px);
            right: calc(-50% + 20px);
            height: 2px;
            background: #D9D9D9;
            z-index: 0;
        }

        .step-item.done:not(:last-child)::after { background: #1351B4; }

        .step-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 2px solid #D9D9D9;
            background: #fff;
            color: #999;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            position: relative;
            z-index: 1;
            transition: all 0.2s;
        }

        .step-btn:disabled { cursor: not-allowed; }

        .step-item.active .step-btn {
            border-color: #1351B4;
            background: #1351B4;
            color: #fff;
        }

        .step-item.done .step-btn {
            border-color: #1351B4;
            background: #EDF2FF;
            color: #1351B4;
        }

        .step-label {
            font-size: 11px;
            color: #999;
            font-weight: 600;
            text-align: center;
            white-space: nowrap;
        }

        .step-item.active .step-label { color: #1351B4; }
        .step-item.done .step-label { color: #1351B4; }

        /* ── FORM CARD ── */
        .form-card {
            background: #fff;
            border-radius: 8px;
            padding: 28px;
            box-shadow: 0 2px 8px rgba(19,81,180,0.07);
            border: 1px solid #E5E5E5;
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 14px;
            font-weight: 700;
            color: #1351B4;
            border-bottom: 2px solid #1351B4;
            padding-bottom: 8px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 16px;
        }

        .half-width { flex: 1; min-width: 200px; }
        .third-width { flex: 1; min-width: 140px; }
        .full-width { flex: 1; min-width: 100%; }

        .field-label {
            font-size: 11px;
            font-weight: 700;
            color: #444;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 5px;
            display: block;
        }

        .govbr-input {
            width: 100%;
            padding: 10px 13px;
            border: 1px solid #888;
            border-radius: 4px;
            font-size: 14px;
            font-family: 'Rawline', 'Raleway', sans-serif;
            color: #333;
            background: #fff;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .govbr-input:focus {
            outline: none;
            border-color: #1351B4;
            box-shadow: 0 0 0 3px rgba(19,81,180,0.18);
        }

        .govbr-input[readonly] {
            background: #F5F5F5;
            color: #777;
            cursor: not-allowed;
            border-color: #CCC;
        }

        .govbr-input.error { border-color: #C92300; }

        .error-message {
            display: none;
            font-size: 11px;
            color: #C92300;
            margin-top: 4px;
        }

        .error-message.visible { display: block; }

        /* ── OPÇÕES DE GERAÇÃO ── */
        .option-group {
            border: 1px solid #D9D9D9;
            border-radius: 8px;
            margin-bottom: 16px;
            overflow: hidden;
            transition: border-color 0.2s;
        }

        .option-group.selected { border-color: #1351B4; }

        .option-group-header {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 20px;
            cursor: pointer;
            background: #FAFAFA;
            font-size: 14px;
            font-weight: 700;
            color: #333;
            transition: background 0.15s;
        }

        .option-group-header:hover { background: #EDF2FF; }

        .option-group.selected .option-group-header {
            background: #EDF2FF;
            color: #1351B4;
        }

        .option-group-header input[type="radio"] {
            accent-color: #1351B4;
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .sub-options {
            display: none;
            padding: 20px;
            border-top: 1px solid #E5E5E5;
            background: #fff;
        }

        .sub-options.open { display: block; }

        .sub-options p {
            font-size: 12px;
            font-weight: 700;
            color: #444;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
        }

        .radio-container {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .radio-option {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            border: 1px solid #D9D9D9;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.15s;
            font-size: 13px;
        }

        .radio-option:hover { border-color: #1351B4; background: #EDF2FF; }

        .radio-option input[type="radio"] {
            accent-color: #1351B4;
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        .radio-option.checked { border-color: #1351B4; background: #EDF2FF; color: #1351B4; font-weight: 600; }

        /* ── CHECKBOX ── */
        .checkbox-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #F8F8F8;
            padding: 12px 16px;
            border-radius: 6px;
            border: 1px solid #E5E5E5;
            cursor: pointer;
        }

        .checkbox-wrapper input[type="checkbox"] {
            appearance: none;
            width: 18px;
            height: 18px;
            min-width: 18px;
            border: 2px solid #888;
            border-radius: 3px;
            cursor: pointer;
            position: relative;
            background: #fff;
        }

        .checkbox-wrapper input[type="checkbox"]:checked {
            background: #1351B4;
            border-color: #1351B4;
        }

        .checkbox-wrapper input[type="checkbox"]:checked::before {
            content: '✔';
            font-size: 11px;
            color: #fff;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .checkbox-wrapper label {
            font-size: 13px;
            color: #333;
            cursor: pointer;
            font-weight: 500;
        }

        /* ── ESPAÇO FÍSICO ── */
        .espaco-fisico-container {
            margin-top: 20px;
            background: #F8F8F8;
            border-radius: 8px;
            padding: 20px;
            border: 1px dashed #C5D4FF;
        }

        .espaco-fisico-container h4 {
            font-size: 13px;
            font-weight: 700;
            color: #1351B4;
            margin-bottom: 16px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .remove-btn {
            background: #C92300;
            color: #fff;
            border: none;
            padding: 8px 14px;
            border-radius: 4px;
            font-size: 12px;
            cursor: pointer;
            align-self: center;
            white-space: nowrap;
            transition: opacity 0.15s;
        }

        .remove-btn:hover { opacity: 0.85; }

        /* ── BOTÕES ── */
        .btn-row {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #EFEFEF;
        }

        .btn-secondary {
            background: transparent;
            color: #1351B4;
            border: 1.5px solid #1351B4;
            padding: 11px 24px;
            border-radius: 100px;
            font-size: 14px;
            font-family: 'Raleway', sans-serif;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.15s;
        }

        .btn-secondary:hover { background: #EDF2FF; }

        .btn-primary {
            background: #1351B4;
            color: #fff;
            border: none;
            padding: 11px 24px;
            border-radius: 100px;
            font-size: 14px;
            font-family: 'Raleway', sans-serif;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: background 0.15s, transform 0.1s;
        }

        .btn-primary:hover { background: #0C3584; }
        .btn-primary:active { transform: scale(0.98); }
        .btn-primary:disabled { background: #B0BEC5; cursor: not-allowed; transform: none; }

        .btn-success {
            background: #168821;
            color: #fff;
            border: none;
            padding: 11px 24px;
            border-radius: 100px;
            font-size: 14px;
            font-family: 'Raleway', sans-serif;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: background 0.15s;
        }

        .btn-success:hover { background: #0C5218; }
        .btn-success:disabled { background: #B0BEC5; cursor: not-allowed; }

        .btn-sm {
            padding: 8px 16px;
            font-size: 12px;
        }

        /* ── LOADING ── */
        #loadingMessage {
            display: none;
            justify-content: center;
            align-items: center;
            gap: 12px;
            font-weight: 600;
            color: #1351B4;
            padding: 20px;
            font-size: 14px;
        }

        .spinner {
            width: 22px;
            height: 22px;
            border: 3px solid #C5D4FF;
            border-top-color: #1351B4;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        /* ── TOAST ── */
        .toast {
            visibility: hidden;
            min-width: 260px;
            background: #333;
            color: #fff;
            text-align: center;
            border-radius: 6px;
            padding: 14px 20px;
            position: fixed;
            z-index: 9999;
            left: 50%;
            bottom: 80px;
            transform: translateX(-50%);
            font-size: 13px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        }

        .toast.show {
            visibility: visible;
            animation: toastIn 0.4s, toastOut 0.4s 2.6s;
        }

        @keyframes toastIn { from { bottom: 60px; opacity: 0; } to { bottom: 80px; opacity: 1; } }
        @keyframes toastOut { from { bottom: 80px; opacity: 1; } to { bottom: 60px; opacity: 0; } }

        /* ── TAB PANELS ── */
        .tab { display: none; }
        .tab.active { display: block; animation: fadeIn 0.3s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

        /* ── FOOTER ── */
        .site-footer {
            background: #071D41;
            padding: 14px 24px;
            position: fixed;
            bottom: 0;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
            z-index: 50;
        }

        .footer-brand {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 700;
            color: #fff;
        }

        .footer-copy {
            font-size: 11px;
            color: rgba(255,255,255,0.55);
        }

        /* ── RESPONSIVE ── */
        @media (max-width: 640px) {
            #main-content { padding: 16px 12px; }
            .form-card { padding: 18px; }
            .steps-nav { gap: 8px; padding: 14px 10px; }
            .step-label { display: none; }
            .gov-bar-links { display: none; }
            .page-header { flex-direction: column; align-items: flex-start; gap: 10px; }
            .btn-row { flex-direction: column; }
            .btn-primary, .btn-secondary, .btn-success { width: 100%; justify-content: center; }
        }
    </style>
</head>
<body>

    <!-- BARRA DO GOVERNO FEDERAL -->
    <div id="gov-bar">
        <div class="gov-bar-brand">
            <i class="fas fa-globe" style="color:#fff;"></i>
            GOV.BR
        </div>
        <ul class="gov-bar-links">
            <li><a href="https://www.gov.br/pt-br/orgaos-do-governo">Órgãos do Governo</a></li>
            <li><a href="http://www.acessoainformacao.gov.br/">Acesso à Informação</a></li>
            <li><a href="http://www4.planalto.gov.br/legislacao">Legislação</a></li>
            <li><a href="https://www.gov.br/governodigital/pt-br/acessibilidade-digital">Acessibilidade</a></li>
        </ul>
    </div>

    <!-- HEADER -->
    <header class="ministry-header">
        <div class="header-top-row">
            <div class="header-logo-area">
                <a href="https://www.gov.br" class="govbr-badge" title="Portal GOV.BR">
                    <i class="fas fa-globe"></i> GOV.BR
                </a>
                <div class="divider-v"></div>
                <div class="ministry-name">
                    Ministério do Esporte
                    <small>Gerador de Declarações</small>
                </div>
            </div>
            <div class="header-actions">
                <button class="icon-btn" aria-label="Buscar">
                    <i class="fas fa-search"></i>
                </button>
                <button class="icon-btn" aria-label="Menu">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </div>
        <div class="header-bottom-row">
            <i class="fas fa-home" style="font-size:11px;"></i>
            Gerador de Declarações para Convênio — Ministério do Esporte
        </div>
    </header>

    <!-- BREADCRUMB -->
    <nav class="breadcrumb-bar" aria-label="Você está em:">
        <a href="https://www.gov.br">gov.br</a>
        <span class="sep">›</span>
        <a href="https://www.gov.br/esporte">Ministério do Esporte</a>
        <span class="sep">›</span>
        <a href="#">Portal de Formulários</a>
        <span class="sep">›</span>
        <span class="current">Declaração de Entidade Pública</span>
    </nav>

    <!-- CONTEÚDO PRINCIPAL -->
    <main id="main-content">

        <!-- Cabeçalho da página -->
        <div class="page-header">
            <div class="page-header-left">
                <div class="page-header-icon">
                    <i class="fas fa-file-contract"></i>
                </div>
                <div>
                    <h2>Declaração de Entidade Pública</h2>
                    <p>Preencha os dados abaixo para gerar as declarações do convênio</p>
                </div>
            </div>
            <span class="status-badge"><i class="fas fa-circle" style="font-size:8px; margin-right:4px;"></i> Emissão</span>
        </div>

        <!-- Navegação por etapas -->
        <div class="steps-nav" role="tablist">
            <div class="step-item active" id="step1">
                <button class="step-btn" role="tab" aria-selected="true" aria-controls="aba1"
                        onclick="mostrarAba('aba1')" title="Dados do Dirigente">
                    <i class="fas fa-user-tie"></i>
                </button>
                <span class="step-label">Dirigente</span>
            </div>
            <div class="step-item" id="step2">
                <button class="step-btn" role="tab" aria-selected="false" aria-controls="aba2"
                        onclick="mostrarAba('aba2')" title="Dados da Entidade" disabled>
                    <i class="fas fa-building"></i>
                </button>
                <span class="step-label">Entidade</span>
            </div>
            <div class="step-item" id="step3">
                <button class="step-btn" role="tab" aria-selected="false" aria-controls="aba3"
                        onclick="mostrarAba('aba3')" title="Opções de Geração" disabled>
                    <i class="fas fa-file-pdf"></i>
                </button>
                <span class="step-label">Geração</span>
            </div>
        </div>

        <!-- FORMULÁRIO -->
        <form id="declaracoesForm" onsubmit="return false;" aria-label="Formulário de Declaração">

            <!-- ABA 1 - DADOS DO DIRIGENTE -->
            <div id="aba1" class="tab active" role="tabpanel">
                <div class="form-card">
                    <div class="section-title">
                        <i class="fas fa-user-edit"></i>
                        Dados do Dirigente do Convênio
                    </div>

                    <div class="form-row">
                        <div class="half-width">
                            <label class="field-label" for="dirigente">Nome completo</label>
                            <input type="text" id="dirigente" class="govbr-input"
