                                    fontSize: 8.5, color: '#555555', alignment: 'left'
                                },
                                { text: `Página ${currentPage} de ${pageCount}`, fontSize: 8.5, color: '#555555', alignment: 'right' }
                            ]
                        },
                        { canvas: [{ type: 'line', x1: 0, y1: 10, x2: 515, y2: 10, lineWidth: 1, lineColor: '#003087' }] }
                    ]
                }),
                content: allPagesContent,
                styles: {
                    header: { fontSize: 14, bold: true, color: '#003087', alignment: 'center' },
                    subheader: { fontSize: 10, italic: true, color: '#333333', alignment: 'justify' },
                    tableHeader: { fontSize: 10, bold: true, color: '#FFFFFF', fillColor: '#003087', alignment: 'center' }
                },
                defaultStyle: { font: 'Roboto', alignment: 'justify' },
                permissions: { printing: 'highResolution', modifying: false, copying: false, annotating: false, fillingForms: false, contentAccessibility: false, documentAssembly: false }
            };

            const nomeArquivo = 'Declarações Consolidadas - Sem prazo de validade.pdf';
            const pdfDoc = pdfMake.createPdf(docDefinition);
            pdfDoc.download(nomeArquivo, () => {
                showToast('PDF gerado com sucesso!');
                isGeneratingPDF = false;
            }, (error) => {
                showToast('Erro ao gerar PDF: ' + error.message, true);
                isGeneratingPDF = false;
            });

        } catch (error) {
            showToast('Erro ao gerar PDF: ' + error.message, true);
            isGeneratingPDF = false;
        } finally {
            if (loadingMessage) loadingMessage.style.display = 'none';
        }
    }

    function validarDadosFormulario(dados) {
        const camposObrigatorios = ['dirigente', 'matricula', 'cargoDirigente', 'proposta', 'cnpj', 'entidade', 'endereco', 'uf', 'municipio', 'cep', 'opcaoSelecao'];
        const erros = camposObrigatorios.filter(campo => !dados[campo] || dados[campo].trim() === '').map(campo => `O campo ${campo} é obrigatório.`);
        if (!['00SL_emendas', '00SL_comissao', '20JP_emenda', '20JP_comissao', '00SL_comissao_mais65mil', '20JP_comissao_mais65mil'].includes(dados.opcaoSelecao)) {
            erros.push('A opção selecionada é inválida.');
        }
        if (dados.opcaoSelecao.startsWith('00SL') && (!dados.espacosFisicos || dados.espacosFisicos.length === 0)) {
            erros.push('Pelo menos um espaço físico deve ser informado para propostas 00SL.');
        }
        return erros;
    }

    // ═══════════════════════════════════════════════════════════
    // CONTROLE DE ABAS E STEPS
    // ═══════════════════════════════════════════════════════════
    function mostrarAba(abaId) {
        document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
        document.getElementById(abaId).classList.add('active');

        const abaIndex = { 'aba1': 0, 'aba2': 1, 'aba3': 2 };
        const steps = document.querySelectorAll('.step-item');
        steps.forEach((step, idx) => {
            step.classList.remove('active', 'done');
            if (idx < abaIndex[abaId]) step.classList.add('done');
            else if (idx === abaIndex[abaId]) step.classList.add('active');
        });

        const buttons = document.querySelectorAll('.steps-nav .step-btn');
        buttons.forEach(btn => btn.setAttribute('aria-selected', 'false'));
        const currentBtn = document.querySelector(`#step${abaIndex[abaId]+1} .step-btn`);
        if (currentBtn) currentBtn.setAttribute('aria-selected', 'true');
    }

    // ═══════════════════════════════════════════════════════════
    // VALIDAÇÃO
    // ═══════════════════════════════════════════════════════════
    function validarLetras(input) {
        const erro = document.getElementById(`erro-${input.id}`);
        input.value = input.value.replace(/[^A-Za-zÀ-ÿ\s]/g, '');
        if (erro) erro.style.display = input.value ? 'none' : 'block';
    }

    function validarLetrasApenas(event) {
        const char = String.fromCharCode(event.which || event.keyCode);
        return /^[A-Za-zÀ-ÿ\s]$/.test(char) || event.preventDefault();
    }

    function validarNumeros(input) {
        const erro = document.getElementById(`erro-${input.id}`);
        input.value = input.value.replace(/\D/g, '');
        if (erro) erro.style.display = input.value ? 'none' : 'block';
    }

    function validarProposta(input) {
        const erro = document.getElementById('erro-proposta');
        let value = input.value.replace(/\D/g, '');
        if (value.length > 10) value = value.slice(0, 10);
        if (value.length > 6) value = value.slice(0, 6) + '/' + value.slice(6);
        input.value = value;
        erro.style.display = input.value && !/^\d{6}\/\d{4}$/.test(input.value) ? 'block' : 'none';
    }

    function mascaraCNPJ(input) {
        const erro = document.getElementById('erro-cnpj');
        let value = input.value.replace(/\D/g, '');
        if (value.length >= 14) {
            erro.style.display = 'none';
            fetchCNPJData(value);
        } else {
            erro.textContent = 'Digite 14 números.';
            erro.style.display = 'block';
            ['entidade', 'endereco', 'uf', 'municipio', 'cep'].forEach(id => {
                document.getElementById(id).value = '';
                document.getElementById(`erro-${id}`).style.display = 'block';
            });
        }
        let valorFormatado = '';
        if (value.length > 0) valorFormatado = value.substring(0, 2);
        if (value.length > 2) valorFormatado += '.' + value.substring(2, 5);
        if (value.length > 5) valorFormatado += '.' + value.substring(5, 8);
        if (value.length > 8) valorFormatado += '/' + value.substring(8, 12);
        if (value.length > 12) valorFormatado += '-' + value.substring(12, 14);
        input.value = valorFormatado;
    }

    async function fetchCNPJData(cnpj) {
        const erro = document.getElementById('erro-cnpj');
        try {
            const response = await fetch(`https://open.cnpja.com/office/${cnpj}`);
            if (!response.ok) throw new Error('CNPJ não encontrado');
            const data = await response.json();
            const razaoSocial = data.company?.name || '';
            const isMunicipio = razaoSocial.toLowerCase().startsWith('município de') || razaoSocial.toLowerCase().startsWith('prefeitura de');
            const entidadeVal = isMunicipio && data.address?.city && data.address?.state
                ? `Município de ${data.address.city}/${data.address.state.toUpperCase()}`
                : razaoSocial || '';
            document.getElementById('entidade').value = entidadeVal;
            document.getElementById('erro-entidade').style.display = entidadeVal ? 'none' : 'block';

            const endereco = `${data.address?.street || ''}${data.address?.number ? `, ${data.address.number}` : ''}${data.address?.district ? `, ${data.address.district}` : ''}`.trim().replace(/^,|,$/g, '');
            document.getElementById('endereco').value = endereco;
            document.getElementById('erro-endereco').style.display = endereco ? 'none' : 'block';

            const ufVal = data.address?.state?.toUpperCase() || '';
            document.getElementById('uf').value = ufVal;
            document.getElementById('erro-uf').style.display = ufVal ? 'none' : 'block';

            const municipioVal = data.address?.city || '';
            document.getElementById('municipio').value = municipioVal;
            document.getElementById('erro-municipio').style.display = municipioVal ? 'none' : 'block';

            const cepVal = data.address?.zip?.replace(/(\d{5})(\d{3})/, '$1-$2') || '';
            document.getElementById('cep').value = cepVal;
            document.getElementById('erro-cep').style.display = cepVal ? 'none' : 'block';

        } catch (error) {
            erro.textContent = 'CNPJ inválido ou não encontrado.';
            erro.style.display = 'block';
            ['entidade', 'endereco', 'uf', 'municipio', 'cep'].forEach(id => {
                document.getElementById(id).value = '';
                document.getElementById(`erro-${id}`).style.display = 'block';
            });
        }
    }

    function validarAba(abaAtual, proximaAba) {
        const aba = document.getElementById(abaAtual);
        const inputs = aba.querySelectorAll('input[required]');
        let valido = true;
        inputs.forEach(input => {
            const erro = document.getElementById(`erro-${input.id}`);
            if (!input.value.trim()) {
                if (erro) erro.style.display = 'block';
                input.classList.add('error');
                valido = false;
            } else {
                if (erro) erro.style.display = 'none';
                input.classList.remove('error');
            }
        });

        if (valido) {
            // Habilita o botão da próxima aba
            const proxStep = { 'aba2': '#step2 .step-btn', 'aba3': '#step3 .step-btn' };
            const btn = document.querySelector(proxStep[proximaAba]);
            if (btn) btn.disabled = false;
            mostrarAba(proximaAba);
        } else {
            showToast('Preencha todos os campos obrigatórios.', true);
        }
    }

    function validarGerarPDF() {
        const tipoProposta = document.querySelector('input[name="tipo_proposta"]:checked')?.value || '';
        const origem00SL = document.querySelector('input[name="origem_00SL"]:checked')?.value || '';
        const origem20JP = document.querySelector('input[name="origem_20JP"]:checked')?.value || '';
        const espacosFisicos = Array.from(document.querySelectorAll('#espacoFisicoFields .form-row')).map(row => ({
            nome: row.querySelector('input[id^="nomeEspacoFisico"]')?.value,
            endereco: row.querySelector('input[id^="enderecoEspacoFisico"]')?.value
        })).filter(e => e.nome && e.endereco);

        const gerarPDFButton = document.getElementById('gerarPDF');
        let habilitar = false;

        if (tipoProposta === '00SL' && origem00SL) {
            habilitar = espacosFisicos.length > 0;
        } else if (tipoProposta === '20JP' && origem20JP) {
            habilitar = true;
        }

        gerarPDFButton.disabled = !habilitar;

        if (habilitar) {
            gerarPDFButton.onclick = () => {
                const formData = {
                    dirigente: document.getElementById('dirigente').value,
                    matricula: document.getElementById('matricula').value,
                    cargoDirigente: document.getElementById('cargoDirigente').value,
                    proposta: document.getElementById('proposta').value,
                    cnpj: document.getElementById('cnpj').value.replace(/\D/g, ''),
                    entidade: document.getElementById('entidade').value,
                    endereco: document.getElementById('endereco').value,
                    uf: document.getElementById('uf').value,
                    municipio: document.getElementById('municipio').value,
                    cep: document.getElementById('cep').value,
                    opcaoSelecao: tipoProposta === '00SL'
                        ? `00SL_${origem00SL}${document.getElementById('municipioMais65mil00SL')?.checked ? '_mais65mil' : ''}`
                        : `20JP_${origem20JP}${document.getElementById('municipioMais65mil20JP')?.checked ? '_mais65mil' : ''}`,
                    espacosFisicos: espacosFisicos,
                    municipioMais65mil00SL: document.getElementById('municipioMais65mil00SL')?.checked || false,
                    municipioMais65mil20JP: document.getElementById('municipioMais65mil20JP')?.checked || false
                };
                gerarPDF(formData);
            };
        }
    }

    function adicionarEspacoFisico() {
        const container = document.getElementById('espacoFisicoFields');
        const index = espacoFisicoCount++;
        const newRow = document.createElement('div');
        newRow.className = 'form-row';
        newRow.id = `espacoFisicoRow${index}`;
        newRow.innerHTML = `
            <div class="half-width">
                <label class="field-label" for="nomeEspacoFisico${index}">Nome do Espaço Físico</label>
                <input type="text" id="nomeEspacoFisico${index}" class="govbr-input"
                       oninput="validarLetras(this)" required
                       aria-describedby="erro-nomeEspacoFisico${index}"
                       placeholder="Ex: Ginásio Municipal">
                <span id="erro-nomeEspacoFisico${index}" class="error-message">Campo obrigatório.</span>
            </div>
            <div class="half-width">
                <label class="field-label" for="enderecoEspacoFisico${index}">Endereço do Espaço Físico</label>
                <input type="text" id="enderecoEspacoFisico${index}" class="govbr-input" required
                       aria-describedby="erro-enderecoEspacoFisico${index}"
                       placeholder="Ex: Rua das Flores, 100">
                <span id="erro-enderecoEspacoFisico${index}" class="error-message">Campo obrigatório.</span>
            </div>
            <button type="button" class="remove-btn" onclick="removerEspacoFisico(${index})">
                <i class="fas fa-trash"></i> Remover
            </button>
        `;
        container.appendChild(newRow);
        if (container.children.length > 1) {
            document.querySelectorAll('#espacoFisicoFields .remove-btn').forEach(btn => btn.style.display = 'inline-flex');
        }
        validarGerarPDF();
    }

    function removerEspacoFisico(index) {
        const row = document.getElementById(`espacoFisicoRow${index}`);
        if (row) row.remove();
        if (document.getElementById('espacoFisicoFields').children.length <= 1) {
            document.querySelectorAll('#espacoFisicoFields .remove-btn').forEach(btn => btn.style.display = 'none');
        }
        validarGerarPDF();
    }

    function salvarEspacoFisico() {
        const espacos = document.querySelectorAll('#espacoFisicoFields .form-row');
        let valido = true;
        espacos.forEach(row => {
            const nomeInput = row.querySelector('input[id^="nomeEspacoFisico"]');
            const enderecoInput = row.querySelector('input[id^="enderecoEspacoFisico"]');
            const erroNome = document.getElementById(`erro-${nomeInput.id}`);
            const erroEndereco = document.getElementById(`erro-${enderecoInput.id}`);
            if (!nomeInput.value.trim()) { if (erroNome) erroNome.style.display = 'block'; valido = false; }
            else { if (erroNome) erroNome.style.display = 'none'; }
            if (!enderecoInput.value.trim()) { if (erroEndereco) erroEndereco.style.display = 'block'; valido = false; }
            else { if (erroEndereco) erroEndereco.style.display = 'none'; }
        });
        if (valido) { showToast('Espaços físicos salvos com sucesso!'); validarGerarPDF(); }
        else { showToast('Preencha todos os campos dos espaços físicos.', true); }
    }

    function showToast(message, isError = false) {
        const toast = document.getElementById('toast');
        toast.textContent = message;
        toast.style.backgroundColor = isError ? '#C92300' : '#168821';
        toast.className = 'toast show';
        setTimeout(() => { toast.className = 'toast'; }, 3000);
    }

    // ═══════════════════════════════════════════════════════════
    // EVENT LISTENERS — GRUPOS DE OPÇÃO
    // ═══════════════════════════════════════════════════════════
    document.querySelectorAll('.option-group-header').forEach(header => {
        header.addEventListener('click', () => {
            const input = header.querySelector('input[type="radio"]');
            if (input) input.checked = true;

            document.querySelectorAll('.sub-options').forEach(sub => sub.classList.remove('open'));
            const subOptions = document.getElementById(`sub_options_${input.value}`);
            if (subOptions) subOptions.classList.add('open');

            document.getElementById('camposEspacoFisico').style.display =
                input.value === '00SL' ? 'block' : 'none';

            atualizarOpcao();
        });
    });

    // Inicialização
    document.querySelectorAll('.sub-options').forEach(sub => sub.classList.remove('open'));
    document.getElementById('camposEspacoFisico').style.display = 'none';
    validarGerarPDF();
    </script>

