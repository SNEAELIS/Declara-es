    // Funções auxiliares
    async function getBase64ImageFromUrl(imageUrl) {
        if (!imageUrl) return null;
        try {
            const response = await fetch(imageUrl);
            if (!response.ok) throw new Error(`Failed to load image: ${response.statusText}`);
            const blob = await response.blob();
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onloadend = () => resolve(reader.result);
                reader.onerror = reject;
                reader.readAsDataURL(blob);
            });
        } catch (error) {
            console.error("Error in getBase64ImageFromUrl:", error);
            return null;
        }
    }

    function substituirPlaceholders(texto, dados) {
        const dataAtual = new Date();
        return texto
            .replace(/\[dirigente]/g, dados.dirigente || 'Nome não informado')
            .replace(/\[matricula]/g, dados.matricula || 'Matrícula não informada')
            .replace(/\[cargoDirigente]/g, dados.cargoDirigente || 'Cargo não informado')
            .replace(/\[entidade]/g, dados.entidade || 'Entidade não informada')
            .replace(/\[cnpj]/g, dados.cnpj || 'CNPJ não informado')
            .replace(/\[endereco]/g, dados.endereco || 'Endereço não informado')
            .replace(/\[uf]/g, dados.uf || 'UF não informada')
            .replace(/\[municipio]/g, dados.municipio || 'Município não informado')
            .replace(/\[cep]/g, dados.cep || 'CEP não informado')
            .replace(/\[proposta]/g, dados.proposta || 'Proposta não informada')
            .replace(/\[diaAtual]/g, String(dataAtual.getDate()).padStart(2, '0'))
            .replace(/\[mesAtual]/g, dataAtual.toLocaleString('pt-BR', { month: 'long' }))
            .replace(/\[anoAtual]/g, dataAtual.getFullYear())
            .replace(/\[nomeEspacoFisico]/g, dados.espacosFisicos[0]?.nome || 'Nome não informado')
            .replace(/\[enderecoEspacoFisico]/g, dados.espacosFisicos[0]?.endereco || 'Endereço não informado');
    }

    function numeroParaExtenso(num) {
        const units = ['', 'um', 'dois', 'três', 'quatro', 'cinco', 'seis', 'sete', 'oito', 'nove', 'dez', 'onze', 'doze', 'treze', 'catorze', 'quinze', 'dezesseis', 'dezessete', 'dezoito', 'dezenove'];
        const tens = ['', '', 'vinte', 'trinta', 'quarenta', 'cinquenta', 'sessenta', 'setenta', 'oitenta', 'noventa'];
        if (num < 20) return units[num];
        if (num < 100) return tens[Math.floor(num / 10)] + (num % 10 ? ' e ' + units[num % 10] : '');
        return String(num);
    }

    // Função para atualizar a opção selecionada
    function atualizarOpcao() {
        const tipoProposta = document.querySelector('input[name="tipo_proposta"]:checked')?.value || '';
        const origem00SL = document.querySelector('input[name="origem_00SL"]:checked')?.value || '';
        const origem20JP = document.querySelector('input[name="origem_20JP"]:checked')?.value || '';
        const municipioMais65mil00SL = document.getElementById('municipioMais65mil00SL')?.checked || false;
        const municipioMais65mil20JP = document.getElementById('municipioMais65mil20JP')?.checked || false;

        let opcaoSelecao = '';

        if (tipoProposta === '20JP') {
            opcaoSelecao = origem20JP ? `20JP_${origem20JP}` : '20JP';
            if (municipioMais65mil20JP && origem20JP === 'comissao') {
                opcaoSelecao += '_mais65mil';
            }
        } else if (tipoProposta === '00SL' && !document.querySelector('#radio_20JP')?.checked) {
            opcaoSelecao = origem00SL ? `00SL_${origem00SL}` : '00SL';
            if (municipioMais65mil00SL && origem00SL === 'comissao') {
                opcaoSelecao += '_mais65mil';
            }
        }

        const opcaoSelecaoInput = document.getElementById('opcaoSelecao');
        if (opcaoSelecaoInput) {
            opcaoSelecaoInput.value = opcaoSelecao;
        }

        // Mostrar/esconder os campos de checkbox
        const municipioMais65milContainer00SL = document.getElementById('municipioMais65milContainer00SL');
        const municipioMais65milContainer20JP = document.getElementById('municipioMais65milContainer20JP');
        if (municipioMais65milContainer00SL) {
            municipioMais65milContainer00SL.style.display = (tipoProposta === '00SL' && origem00SL === 'comissao' && !document.querySelector('#radio_20JP')?.checked) ? 'block' : 'none';
        }
        if (municipioMais65milContainer20JP) {
            municipioMais65milContainer20JP.style.display = (tipoProposta === '20JP' && origem20JP === 'comissao') ? 'block' : 'none';
        }

        validarGerarPDF();
    }

async function gerarPDF(formData) {
    if (isGeneratingPDF) {
        console.warn('PDF generation already in progress.');
        return;
    }

    isGeneratingPDF = true;
    const loadingMessage = document.getElementById('loadingMessage');
    if (loadingMessage) loadingMessage.style.display = 'flex';

    const dados = {
        ...formData,
        diaAtual: String(new Date().getDate()).padStart(2, '0'),
        mesAtual: new Date().toLocaleString('pt-BR', { month: 'long' }),
        anoAtual: new Date().getFullYear()
    };

    try {
        const erros = validarDadosFormulario(dados);
        if (erros.length > 0) {
            console.error('Validation errors:', erros);
            showToast(erros.join(' '), true);
            return;
        }

        const letterheadImage = await getBase64ImageFromUrl('https://i.ibb.co/Lz10svWs/Declara-es-page-0001.jpg');
        if (!letterheadImage) throw new Error('Failed to load default letterhead.');

        const defaults = { leftRightMargin: 40, topMargin: 120, bottomMargin: 100, footerPosY: 770 }; // Reduzi topMargin para 120
        const layoutOptions = { topMargin: defaults.topMargin, footerPosition: defaults.footerPosY };
        const bottomMargin = Math.max(100, 841.89 - layoutOptions.footerPosition - 40);

        // Consolidar declarações sem duplicatas
        const todasDeclaracoes = new Map();
        declaracoesCompletas.forEach(decl => {
            const ehSustentabilidade = decl.title === "DECLARAÇÃO DE SUSTENTABILIDADE DO OBJETO";
            const condicaoSustentabilidade = dados.opcaoSelecao.startsWith('00SL') || dados.opcaoSelecao.startsWith('20JP');
            if (!ehSustentabilidade || condicaoSustentabilidade) {
                todasDeclaracoes.set(decl.title, decl);
            }
        });

        const opcaoBase = dados.opcaoSelecao.replace(/_mais65mil/g, '');
        const declaracoesEspecificasArray = declaracoesEspecificas[opcaoBase] || [];
        declaracoesEspecificasArray.forEach(decl => {
            todasDeclaracoes.set(decl.title, decl);
        });

        if ((dados.municipioMais65mil00SL && dados.opcaoSelecao === '00SL_comissao') || (dados.municipioMais65mil20JP && dados.opcaoSelecao === '20JP_comissao')) {
            const adimplencia = {
                title: "DECLARAÇÃO DE ADIMPLÊNCIA",
                content: `Eu, [dirigente], matrícula [matricula], na condição de representante legal do(a) [entidade], CNPJ nº [cnpj], DECLARO, no uso das atribuições que me foram delegadas e sob as penas da lei, que a presente Entidade não está inadimplente com a União, incluindo, mas não se limitando a, contribuições previstas nos artigos 195 e 239 da Constituição Federal (seguridade social, PIS/PASEP e FGTS), bem como obrigações decorrentes de convênios, contratos, acordos, ajustes, subvenções sociais, contribuições e auxílios previamente celebrados com a Administração Pública Federal. Esta declaração está baseada em certidões negativas atualizadas, arquivadas na [entidade], e me comprometo a apresentá-las quando requisitadas, nos termos da Lei nº 14.133/2021.`
            };
            todasDeclaracoes.set(adimplencia.title, adimplencia);
        }

        const declaracoesParaIncluir = Array.from(todasDeclaracoes.values());

        let currentPage = 1;
        const pageNumbers = new Map();

        const allPagesContent = declaracoesParaIncluir.map((decl, index) => {
            let content = substituirPlaceholders(decl.content, dados);
            const headerStack = [
                { text: (dados.entidade || 'Entidade não informada').toUpperCase(), bold: true, alignment: 'center', fontSize: 14, margin: [0, 15, 0, 5] },
                { text: `${(dados.endereco || 'Endereço não informado').toUpperCase()} - ${(dados.municipio || 'Município não informado').toUpperCase()}/${(dados.uf || 'UF não informada').toUpperCase()} - CEP: ${dados.cep || 'CEP não informado'}`, fontSize: 10, alignment: 'center', margin: [0, 0, 0, 8] },
                { canvas: [{ type: 'line', x1: 70, y1: 15, x2: 445, y2: 15, lineWidth: 0.5, lineColor: '#cccccc' }], margin: [0, 0, 0, 20] }
            ];

            if (['00SL_emendas', '00SL_comissao'].includes(opcaoBase) && 
                decl.title === "DECLARAÇÃO DE TITULARIDADE DO TERRENO" && 
                dados.espacosFisicos.length > 0) {
                
                const linhasPrimeiraPagina = 5;
                const linhasSegundaPagina = 15;

                const gruposEspacos = [];
                gruposEspacos.push(dados.espacosFisicos.slice(0, linhasPrimeiraPagina)); // 5 linhas na página 9
                if (dados.espacosFisicos.length > linhasPrimeiraPagina) {
                    gruposEspacos.push(dados.espacosFisicos.slice(linhasPrimeiraPagina, linhasPrimeiraPagina + linhasSegundaPagina));
                }
                if (dados.espacosFisicos.length > linhasPrimeiraPagina + linhasSegundaPagina) {
                    const linhasPorPaginaRestante = 20;
                    for (let i = linhasPrimeiraPagina + linhasSegundaPagina; i < dados.espacosFisicos.length; i += linhasPorPaginaRestante) {
                        gruposEspacos.push(dados.espacosFisicos.slice(i, i + linhasPorPaginaRestante));
                    }
                }

                const partesTabela = gruposEspacos.map((grupo, grupoIndex) => {
                    const isPrimeiraParte = grupoIndex === 0;
                    
                    return {
                        stack: [
                            ...(isPrimeiraParte ? [{
                                text: content.replace(/Informo que:\n\n- Nome do Espaço Físico:.*?(?=\n|$)/s, '').trim(),
                                alignment: 'justify',
                                fontSize: 12,
                                lineHeight: 1.15,
                                margin: [0, 0, 0, 5]
                            }] : []),
                            {
                                table: {
                                    widths: ['*', '*'],
                                    body: [
                                        [
                                            { text: 'Nome do Espaço Físico', bold: true, fontSize: 10, fillColor: '#e6e6e6' },
                                            { text: 'Endereço do Espaço Físico', bold: true, fontSize: 10, fillColor: '#e6e6e6' }
                                        ],
                                        ...grupo.map(espaco => [
                                            { text: espaco.nome || '', fontSize: 10 },
                                            { text: espaco.endereco || '', fontSize: 10 }
                                        ])
                                    ]
                                },
                                layout: {
                                    hLineWidth: (i, node) => (i === 0 || i === node.table.body.length) ? 1 : 0.5,
                                    vLineWidth: (i, node) => (i === 0 || i === node.table.widths.length) ? 1 : 0.5,
                                    hLineColor: (i, node) => (i === 0 || i === node.table.body.length) ? '#003087' : '#cccccc',
                                    vLineColor: (i, node) => (i === 0 || i === node.table.widths.length) ? '#003087' : '#cccccc',
                                    paddingLeft: () => 5,
                                    paddingRight: () => 5,
                                    paddingTop: () => 3,
                                    paddingBottom: () => 3
                                },
                                margin: [0, 65, 0, 10],
                                pageBreak: !isPrimeiraParte ? 'before' : undefined
                            }
                        ]
                    };
                });

                pageNumbers.set(decl.title, currentPage);
                currentPage += gruposEspacos.length;

                return {
                    margin: [defaults.leftRightMargin, layoutOptions.topMargin, defaults.leftRightMargin, bottomMargin],
                    stack: [
                        ...headerStack,
                        { text: `\n${substituirPlaceholders(decl.title, dados)}`, style: 'header', alignment: 'center', margin: [0, 0, 0, 20] },
                        ...partesTabela
                    ],
                    pageBreak: index < declaracoesParaIncluir.length - 1 ? 'after' : undefined
                };
            }

            pageNumbers.set(decl.title, currentPage);
            currentPage++;

            const formattedContent = {
                stack: content.split('\n\n').map(p => ({
                    text: p.trim(),
                    alignment: 'justify',
                    fontSize: 12,
                    lineHeight: 1.15,
                    margin: [0, 0, 0, 10],
                    unbreakable: true
                }))
            };

            return {
                pageBreak: index < declaracoesParaIncluir.length - 1 ? 'after' : undefined,
                margin: [defaults.leftRightMargin, layoutOptions.topMargin, defaults.leftRightMargin, bottomMargin],
                stack: [
                    ...headerStack,
                    { text: `\n${substituirPlaceholders(decl.title, dados)}`, style: 'header', alignment: 'center', margin: [0, 0, 0, 20] },
                    formattedContent
                ]
            };
        }).concat({
            pageBreak: 'before',
            margin: [defaults.leftRightMargin, 100, defaults.leftRightMargin, bottomMargin],
            stack: [
                { text: (dados.entidade || 'Entidade não informada').toUpperCase(), bold: true, alignment: 'center', fontSize: 14, margin: [0, 0, 0, 5] },
                { text: `${(dados.endereco || 'Endereço não informado').toUpperCase()} - ${(dados.municipio || 'Município não informado').toUpperCase()}/${(dados.uf || 'UF não informada').toUpperCase()} - CEP: ${dados.cep || 'CEP não informado'}`, fontSize: 10, alignment: 'center', margin: [0, 0, 0, 8] },
                { canvas: [{ type: 'line', x1: 70, y1: 15, x2: 445, y2: 15, lineWidth: 0.5, lineColor: '#cccccc' }], margin: [0, 0, 0, 20] },
                { text: 'DECLARAÇÕES REFERENCIAIS', style: 'header', alignment: 'center', margin: [0, 30, 0, 15] },
                { text: 'Relação das declarações contidas neste documento, assinadas eletronicamente na presente página.', style: 'subheader', alignment: 'justify', margin: [0, 5, 0, 5] },
                {
                    table: {
                        headerRows: 1,
                        widths: [40, '*'],
                        body: [
                            [{ text: 'Página', style: 'tableHeader' }, { text: '', style: 'tableHeader' }],
                            ...declaracoesParaIncluir.map((decl, idx) => [
                                { text: `${pageNumbers.get(decl.title)}`, alignment: 'center', fontSize: 9, fillColor: idx % 2 === 0 ? '#F5F6F5' : '#FFFFFF' },
                                { text: ` ${substituirPlaceholders(decl.title, dados)}`, linkToPage: pageNumbers.get(decl.title), decoration: 'underline', color: '#003087', fontSize: 9, alignment: 'left', fillColor: idx % 2 === 0 ? '#F5F6F5' : '#FFFFFF' }
                            ])
                        ]
                    },
                    layout: {
                        hLineWidth: (i, node) => (i === 0 || i === node.table.body.length) ? 1.5 : 0.5,
                        vLineWidth: () => 1,
                        hLineColor: () => '#003087',
                        vLineColor: () => '#003087',
                        paddingLeft: () => 5, paddingRight: () => 5, paddingTop: () => 2, paddingBottom: () => 2
                    },
                    margin: [0, 5, 0, 5],
                    alignment: 'center'
                },
                { text: `Por ser verdade, firmo o teor das ${declaracoesParaIncluir.length} (${numeroParaExtenso(declaracoesParaIncluir.length)}) declarações que compõem este arquivo:`, alignment: 'justify', fontSize: 11, margin: [0, 20, 0, 20] },
                { text: `${(dados.municipio || 'Município não informado').toUpperCase()}/${(dados.uf || 'UF não informada').toUpperCase()}, na data da assinatura eletrônica.`, alignment: 'center', fontSize: 11, margin: [0, 20, 0, 20] },
                { text: '__________________________________________', alignment: 'center', fontSize: 11, margin: [0, 20, 0, 10] },
                { text: dados.dirigente || 'Nome não informado', alignment: 'center', bold: true, fontSize: 11, margin: [0, 0, 0, 10] },
                { text: dados.cargoDirigente || 'Cargo não informado', alignment: 'center', italic: true, fontSize: 11, margin: [0, 0, 0, 10] }
            ]
        });

        const docDefinition = {
            pageSize: 'A4',
            pageMargins: [defaults.leftRightMargin, 0, defaults.leftRightMargin, bottomMargin],
            background: letterheadImage ? { image: letterheadImage, width: 595.28, height: 841.89, absolutePosition: { x: 0, y: 0 }, opacity: 1.0 } : null,
            footer: (currentPage, pageCount) => ({
                margin: [40, 0, 40, 0],
                stack: [
                    {
                        columns: [
                            { 
                                text: currentPage < pageCount 
                                    ? 'A assinatura eletrônica será realizada exclusivamente na última página, sendo considerada válida para todas as páginas anteriores.' 
                                    : `Documento composto por ${declaracoesParaIncluir.length} (${numeroParaExtenso(declaracoesParaIncluir.length)}) declarações, assinado eletronicamente nesta página, com validade jurídica para o conjunto.`, 
                                fontSize: 8.5, color: '#555555', alignment: 'left' 
                            },
                            { text: `Página ${currentPage} de ${pageCount}`, fontSize: 8.5, color: '#555555', alignment: 'right' }
                        ]
                    },
                    { canvas: [{ type: 'line', x1: 0, y1: 10, x2: 515, y2: 10, lineWidth: 1, lineColor: '#003087' }] }
                ]
            }),
            content: allPagesContent,
            styles: {
                header: { fontSize: 14, bold: true, color: '#003087', alignment: 'center' },
                subheader: { fontSize: 10, italic: true, color: '#333333', alignment: 'justify' },
                tableHeader: { fontSize: 10, bold: true, color: '#FFFFFF', fillColor: '#003087', alignment: 'center' }
            },
            defaultStyle: { font: 'Roboto', alignment: 'justify' },
            permissions: {
                printing: 'highResolution',
                modifying: false,
                copying: false,
                annotating: false,
                fillingForms: false,
                contentAccessibility: false,
                documentAssembly: false
            }
        };

        const nomeArquivo = 'Declarações Consolidadas - Sem prazo de validade.pdf';
        const pdfDoc = pdfMake.createPdf(docDefinition);
        pdfDoc.download(nomeArquivo, () => {
            console.log('PDF download completed:', nomeArquivo);
            showToast('PDF gerado com sucesso!');
            isGeneratingPDF = false;
        }, (error) => {
            console.error('Error downloading PDF:', error);
            showToast('Erro ao gerar PDF: ' + error.message, true);
            isGeneratingPDF = false;
        });
    } catch (error) {
        console.error('Error generating PDF:', error);
        showToast('Erro ao gerar PDF: ' + error.message, true);
        isGeneratingPDF = false;
    } finally {
        if (loadingMessage) loadingMessage.style.display = 'none';
    }
}
    // Função de validação do formulário
    function validarDadosFormulario(dados) {
        const camposObrigatorios = ['dirigente', 'matricula', 'cargoDirigente', 'proposta', 'cnpj', 'entidade', 'endereco', 'uf', 'municipio', 'cep', 'opcaoSelecao'];
        const erros = camposObrigatorios.filter(campo => !dados[campo] || dados[campo].trim() === '').map(campo => `O campo ${campo} é obrigatório.`);

        if (!['00SL_emendas', '00SL_comissao', '20JP_emenda', '20JP_comissao', '00SL_comissao_mais65mil', '20JP_comissao_mais65mil'].includes(dados.opcaoSelecao)) {
            erros.push('A opção selecionada é inválida.');
        }

        if (dados.opcaoSelecao.startsWith('00SL') && (!dados.espacosFisicos || dados.espacosFisicos.length === 0)) {
            erros.push('Pelo menos um espaço físico deve ser informado para propostas 00SL.');
        }

        return erros;
    }

    // Funções de controle de abas e validação
    function mostrarAba(abaId) {
        document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
        document.querySelectorAll('.tab-buttons button').forEach(btn => btn.classList.remove('active'));
        document.getElementById(abaId).classList.add('active');
        document.querySelector(`.tab-buttons button[onclick="mostrarAba('${abaId}')"]`).classList.add('active');
        document.querySelectorAll('.tab-buttons button').forEach(btn => {
            btn.setAttribute('aria-selected', btn.classList.contains('active'));
        });
    }

    function validarLetras(input) {
        const erro = document.getElementById(`erro-${input.id}`);
        if (erro) {
            input.value = input.value.replace(/[^A-Za-zÀ-ÿ\s]/g, '');
            erro.style.display = input.value ? 'none' : 'block';
        }
    }

    function validarLetrasApenas(event) {
        const char = String.fromCharCode(event.which || event.keyCode);
        return /^[A-Za-zÀ-ÿ\s]$/.test(char) || event.preventDefault();
    }

    function validarNumeros(input) {
        const erro = document.getElementById(`erro-${input.id}`);
        if (erro) {
            input.value = input.value.replace(/\D/g, '');
            erro.style.display = input.value ? 'none' : 'block';
        }
    }

    function validarProposta(input) {
        const erro = document.getElementById('erro-proposta');
        let value = input.value.replace(/\D/g, '');
        if (value.length > 10) value = value.slice(0, 10);
        if (value.length > 6) value = value.slice(0, 6) + '/' + value.slice(6);
        input.value = value;
        erro.style.display = input.value && !/^\d{6}\/\d{4}$/.test(input.value) ? 'block' : 'none';
    }

    function mascaraCNPJ(input) {
        const erro = document.getElementById('erro-cnpj');
        let value = input.value.replace(/\D/g, '');
        if (value.length >= 14) {
            erro.style.display = 'none';
            fetchCNPJData(value);
        } else {
            erro.textContent = 'Digite 14 números.';
            erro.style.display = 'block';
            document.getElementById('entidade').value = '';
            document.getElementById('endereco').value = '';
            document.getElementById('uf').value = '';
            document.getElementById('municipio').value = '';
            document.getElementById('cep').value = '';
            document.getElementById('erro-entidade').style.display = 'block';
            document.getElementById('erro-endereco').style.display = 'block';
            document.getElementById('erro-uf').style.display = 'block';
            document.getElementById('erro-municipio').style.display = 'block';
            document.getElementById('erro-cep').style.display = 'block';
        }
        let valorFormatado = '';
        if (value.length > 0) valorFormatado = value.substring(0, 2);
        if (value.length > 2) valorFormatado += '.' + value.substring(2, 5);
        if (value.length > 5) valorFormatado += '.' + value.substring(5, 8);
        if (value.length > 8) valorFormatado += '/' + value.substring(8, 12);
        if (value.length > 12) valorFormatado += '-' + value.substring(12, 14);
        input.value = valorFormatado;
    }

    async function fetchCNPJData(cnpj) {
        const erro = document.getElementById('erro-cnpj');
        const entidadeInput = document.getElementById('entidade');
        const enderecoInput = document.getElementById('endereco');
        const ufInput = document.getElementById('uf');
        const municipioInput = document.getElementById('municipio');
        const cepInput = document.getElementById('cep');
        try {
            const response = await fetch(`https://open.cnpja.com/office/${cnpj}`);
            if (!response.ok) throw new Error('CNPJ não encontrado');
            const data = await response.json();
            const razaoSocial = data.company?.name || '';
            const isMunicipio = razaoSocial.toLowerCase().startsWith('município de') || razaoSocial.toLowerCase().startsWith('prefeitura de'); // LINHA CORRIGIDA
            entidadeInput.value = isMunicipio && data.address?.city && data.address?.state ? 
                `Município de ${data.address.city}/${data.address.state.toUpperCase()}` : 
                razaoSocial || '';
            document.getElementById('erro-entidade').style.display = entidadeInput.value ? 'none' : 'block';
            const endereco = `${data.address?.street || ''}${data.address?.number ? `, ${data.address.number}` : ''}${data.address?.district ? `, ${data.address.district}` : ''}`;
            enderecoInput.value = endereco.trim().replace(/^,|,$/g, '') || '';
            document.getElementById('erro-endereco').style.display = enderecoInput.value ? 'none' : 'block';
            ufInput.value = data.address?.state?.toUpperCase() || '';
            document.getElementById('erro-uf').style.display = ufInput.value ? 'none' : 'block';
            municipioInput.value = data.address?.city || '';
            document.getElementById('erro-municipio').style.display = municipioInput.value ? 'none' : 'block';
            cepInput.value = data.address?.zip?.replace(/(\d{5})(\d{3})/, '$1-$2') || '';
            document.getElementById('erro-cep').style.display = cepInput.value ? 'none' : 'block';
        } catch (error) {
            console.error('Erro ao buscar dados do CNPJ:', error);
            erro.textContent = 'CNPJ inválido ou não encontrado.';
            erro.style.display = 'block';
            entidadeInput.value = '';
            enderecoInput.value = '';
            ufInput.value = '';
            municipioInput.value = '';
            cepInput.value = '';
            document.getElementById('erro-entidade').style.display = 'block';
            document.getElementById('erro-endereco').style.display = 'block';
            document.getElementById('erro-uf').style.display = 'block';
            document.getElementById('erro-municipio').style.display = 'block';
            document.getElementById('erro-cep').style.display = 'block';
        }
        validarAba('aba2', 'aba3');
    }

    function validarAba(abaAtual, proximaAba) {
        const aba = document.getElementById(abaAtual);
        const inputs = aba.querySelectorAll('input[required]');
        let valido = true;
        inputs.forEach(input => {
            const erro = document.getElementById(`erro-${input.id}`);
            if (!input.value.trim()) {
                erro.style.display = 'block';
                valido = false;
            } else {
                erro.style.display = 'none';
            }
        });
        if (valido) {
            const botaoProxima = document.querySelector(`.tab-buttons button[onclick="mostrarAba('${proximaAba}')"]`);
            if (botaoProxima) botaoProxima.disabled = false;
            mostrarAba(proximaAba);
        } else {
            showToast('Preencha todos os campos obrigatórios.', true);
        }
    }

    function validarGerarPDF() {
        const tipoProposta = document.querySelector('input[name="tipo_proposta"]:checked')?.value || '';
        const origem00SL = document.querySelector('input[name="origem_00SL"]:checked')?.value || '';
        const origem20JP = document.querySelector('input[name="origem_20JP"]:checked')?.value || '';
        const espacosFisicos = Array.from(document.querySelectorAll('#espacoFisicoFields .form-row')).map(row => ({
            nome: row.querySelector('input[id^="nomeEspacoFisico"]')?.value,
            endereco: row.querySelector('input[id^="enderecoEspacoFisico"]')?.value
        })).filter(espaco => espaco.nome && espaco.endereco);
        
        const gerarPDFButton = document.getElementById('gerarPDF');
        let habilitar = false;

        if (tipoProposta === '00SL' && origem00SL) {
            habilitar = espacosFisicos.length > 0;
        } else if (tipoProposta === '20JP' && origem20JP) {
            habilitar = true;
        }

        gerarPDFButton.disabled = !habilitar;
        if (habilitar) {
            gerarPDFButton.onclick = () => {
                const formData = {
                    dirigente: document.getElementById('dirigente').value,
                    matricula: document.getElementById('matricula').value,
                    cargoDirigente: document.getElementById('cargoDirigente').value,
                    proposta: document.getElementById('proposta').value,
                    cnpj: document.getElementById('cnpj').value.replace(/\D/g, ''),
                    entidade: document.getElementById('entidade').value,
                    endereco: document.getElementById('endereco').value,
                    uf: document.getElementById('uf').value,
                    municipio: document.getElementById('municipio').value,
                    cep: document.getElementById('cep').value,
                    opcaoSelecao: document.querySelector('input[name="tipo_proposta"]:checked')?.value === '00SL' 
                        ? `00SL_${origem00SL}${document.getElementById('municipioMais65mil00SL')?.checked ? '_mais65mil' : ''}`
                        : `20JP_${origem20JP}${document.getElementById('municipioMais65mil20JP')?.checked ? '_mais65mil' : ''}`,
                    espacosFisicos: espacosFisicos,
                    municipioMais65mil00SL: document.getElementById('municipioMais65mil00SL')?.checked || false,
                    municipioMais65mil20JP: document.getElementById('municipioMais65mil20JP')?.checked || false
                };
                gerarPDF(formData);
            };
        }
    }

    function adicionarEspacoFisico() {
        const container = document.getElementById('espacoFisicoFields');
        const index = espacoFisicoCount++;
        const newRow = document.createElement('div');
        newRow.className = 'form-row';
        newRow.id = `espacoFisicoRow${index}`;
        newRow.innerHTML = `
            <div class="half-width">
                <label for="nomeEspacoFisico${index}">Nome do Espaço Físico:</label>
                <input type="text" id="nomeEspacoFisico${index}" oninput="validarLetras(this)" required aria-describedby="erro-nomeEspacoFisico${index}">
                <span id="erro-nomeEspacoFisico${index}" class="error-message">Digite apenas letras e espaços.</span>
            </div>
            <div class="half-width">
                <label for="enderecoEspacoFisico${index}">Endereço do Espaço Físico:</label>
                <input type="text" id="enderecoEspacoFisico${index}" required aria-describedby="erro-enderecoEspacoFisico${index}">
                <span id="erro-enderecoEspacoFisico${index}" class="error-message">Campo obrigatório.</span>
            </div>
            <button type="button" class="remove-btn" onclick="removerEspacoFisico(${index})">Remover</button>
        `;
        container.appendChild(newRow);
        if (container.children.length > 1) {
            document.querySelectorAll('#espacoFisicoFields .remove-btn').forEach(btn => btn.style.display = 'inline-block');
        }
        validarGerarPDF();
    }

    function removerEspacoFisico(index) {
        const row = document.getElementById(`espacoFisicoRow${index}`);
        if (row) row.remove();
        if (document.getElementById('espacoFisicoFields').children.length <= 1) {
            document.querySelectorAll('#espacoFisicoFields .remove-btn').forEach(btn => btn.style.display = 'none');
        }
        validarGerarPDF();
    }

    function salvarEspacoFisico() {
        const espacos = document.querySelectorAll('#espacoFisicoFields .form-row');
        let valido = true;
        espacos.forEach(row => {
            const nomeInput = row.querySelector('input[id^="nomeEspacoFisico"]');
            const enderecoInput = row.querySelector('input[id^="enderecoEspacoFisico"]');
            const erroNome = row.querySelector(`#erro-${nomeInput.id}`);
            const erroEndereco = row.querySelector(`#erro-${enderecoInput.id}`);
            if (!nomeInput.value.trim()) {
                erroNome.style.display = 'block';
                valido = false;
            } else {
                erroNome.style.display = 'none';
            }
            if (!enderecoInput.value.trim()) {
                erroEndereco.style.display = 'block';
                valido = false;
            } else {
                erroEndereco.style.display = 'none';
            }
        });
        if (valido) {
            showToast('Espaços físicos salvos com sucesso!');
            validarGerarPDF();
        } else {
            showToast('Preencha todos os campos obrigatórios dos espaços físicos.', true);
        }
    }

    function showToast(message, isError = false) {
        const toast = document.getElementById('toast');
        toast.textContent = message;
        toast.style.backgroundColor = isError ? '#dc3545' : '#28a745';
        toast.className = 'toast show';
        setTimeout(() => {
            toast.className = 'toast';
        }, 3000);
    }

    document.getElementById('theme-switcher').addEventListener('click', () => {
        document.documentElement.classList.toggle('dark');
    });

    document.querySelectorAll('.option-group-header').forEach(header => {
        header.addEventListener('click', () => {
            const input = header.querySelector('input[type="radio"]');
            if (input) input.checked = true;
            document.querySelectorAll('.sub-options').forEach(sub => sub.style.display = 'none');
            const subOptions = document.getElementById(`sub_options_${input.value}`);
            if (subOptions) subOptions.style.display = 'block';
            if (input.value === '00SL') {
                document.getElementById('camposEspacoFisico').style.display = 'block';
            } else {
                document.getElementById('camposEspacoFisico').style.display = 'none';
            }
            atualizarOpcao();
        });
    });

    // Inicialização
    document.querySelectorAll('.sub-options').forEach(sub => sub.style.display = 'none');
    document.getElementById('camposEspacoFisico').style.display = 'none';
    validarGerarPDF();
</script>
