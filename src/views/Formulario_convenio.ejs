<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerador de Documentações - Ministério do Esporte</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        :root {
            --bg-color: #f4f4f9;
            --container-bg: #ffffff;
            --text-color: #333;
            --primary-color: #003087;
            --primary-text-color: #ffffff;
            --input-border-color: #ccc;
            --input-bg-color: #fff;
            --input-focus-border: #003087;
            --form-row-bg: #f9f9f9;
            --button-disabled-bg: #ccc;
            --header-shadow: rgba(0, 0, 0, 0.1);
            --container-shadow: rgba(0, 0, 0, 0.05);
            --success-color: #28a745;
            --error-color: #dc3545;
        }
        html.dark {
            --bg-color: #121212;
            --container-bg: #1e1e1e;
            --text-color: #e0e0e0;
            --primary-color: #5a9bff;
            --primary-text-color: #000;
            --input-border-color: #555;
            --input-bg-color: #2a2a2a;
            --input-focus-border: #5a9bff;
            --form-row-bg: #252525;
            --button-disabled-bg: #444;
            --header-shadow: rgba(255, 255, 255, 0.1);
            --container-shadow: rgba(0, 0, 0, 0.2);
            --success-color: #28a745;
            --error-color: #dc3545;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; transition: background-color 0.3s, color 0.3s, border-color 0.3s; }
        body { font-family: 'Arial', sans-serif; background-color: var(--bg-color); color: var(--text-color); line-height: 1.6; }
        header { background-color: var(--primary-color); color: var(--primary-text-color); padding: 10px 20px; display: flex; align-items: center; justify-content: space-between; position: fixed; width: 100%; top: 0; z-index: 1000; height: 60px; box-shadow: 0 2px 4px var(--header-shadow); }
        .header-left { display: flex; align-items: center; gap: 15px; }
        header img { max-width: 200px; height: auto; filter: brightness(0) invert(1); }
        html.dark header img { filter: none; }
        header h1 { font-size: 1.2rem; font-weight: bold; }
        .header-right { display: flex; align-items: center; gap: 10px; }
        .theme-switcher { display: flex; align-items: center; cursor: pointer; color: var(--primary-text-color); }
        .theme-switcher i { font-size: 1.2rem; padding: 5px; }
        #theme-icon-sun { display: none; }
        html.dark #theme-icon-sun { display: inline-block; }
        html.dark #theme-icon-moon { display: none; }
        .container { background: var(--container-bg); margin: 80px auto 30px; padding: 20px; border-radius: 8px; box-shadow: 0 2px 10px var(--container-shadow); max-width: 900px; }
        .container-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .container-header h2 { font-size: 1.5rem; font-weight: bold; color: var(--text-color); }
        .status { font-size: 0.9rem; color: #666; }
        .section { margin-bottom: 20px; }
        .section h3 { font-size: 1.2rem; font-weight: bold; color: var(--primary-color); margin-bottom: 10px; border-bottom: 2px solid var(--primary-color); padding-bottom: 5px; }
        .form-row { display: flex; flex-wrap: wrap; gap: 20px; background-color: var(--form-row-bg); padding: 15px; border-radius: 5px; border: 1px solid var(--input-border-color); margin-bottom: 15px; }
        .form-row .half-width, .form-row .third-width, .form-row .full-width { flex: 1; min-width: 200px; }
        .third-width { min-width: 150px; }
        label { font-size: 0.9rem; font-weight: bold; color: var(--text-color); margin-bottom: 5px; display: block; }
        input[type="text"], input[type="number"], input[type="file"], textarea, select { width: 100%; padding: 10px; border: 1px solid var(--input-border-color); border-radius: 4px; font-size: 0.9rem; background-color: var(--input-bg-color); color: var(--text-color); }
        input[readonly] { background-color: #f0f0f0; cursor: not-allowed; }
        html.dark input[readonly] { background-color: #333; color: #999; }
        input:focus, textarea:focus, select:focus { border-color: var(--input-focus-border); outline: none; box-shadow: 0 0 5px rgba(0, 48, 135, 0.3); }
        html.dark input:focus, html.dark textarea:focus, html.dark select:focus { box-shadow: 0 0 5px rgba(90, 155, 255, 0.4); }
        button { background-color: var(--primary-color); color: var(--primary-text-color); border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-size: 0.9rem; font-weight: bold; }
        button:hover:not(:disabled) { opacity: 0.9; }
        button:disabled { background-color: var(--button-disabled-bg); cursor: not-allowed; color: #888; }
        .button-container { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
        .tab-buttons { display: flex; justify-content: center; margin-bottom: 20px; gap: 15px; }
        .tab-buttons button { width: 50px; height: 50px; border-radius: 50%; border: 2px solid var(--primary-color); background-color: var(--container-bg); cursor: pointer; color: var(--primary-color); font-size: 1.2rem; }
        .tab-buttons button.active { background-color: var(--primary-color); color: var(--primary-text-color); }
        .tab { display: none; }
        .tab.active { display: block; animation: fadeIn 0.5s; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        .error-message { color: var(--error-color); font-size: 0.8rem; display: none; margin-top: 5px; }
        .option-group { border: 1px solid var(--input-border-color); border-radius: 5px; padding: 15px; margin-bottom: 15px; }
        .option-group-header { display: flex; align-items: center; gap: 10px; font-size: 1.1rem; font-weight: bold; cursor: pointer; }
        .sub-options { display: none; padding-left: 30px; margin-top: 15px; border-left: 3px solid var(--primary-color); }
        .radio-container { display: flex; flex-wrap: wrap; gap: 10px 20px; margin-top: 10px; }
        .espaco-fisico-container { margin-top: 15px; }
        .remove-btn { background-color: var(--error-color); color: #fff; padding: 5px 10px; margin-left: 10px; align-self: center; border-radius: 4px; }
        #loadingMessage { text-align: center; font-weight: bold; color: var(--primary-color); margin-top: 10px; display: none; }
        footer { text-align: center; padding: 10px; background-color: var(--primary-color); color: var(--primary-text-color); font-size: 0.8rem; margin-top: 20px; }
        .toast {
            visibility: hidden;
            min-width: 250px;
            background-color: #333;
            color: #fff;
            text-align: center;
            border-radius: 4px;
            padding: 16px;
            position: fixed;
            z-index: 1001;
            left: 50%;
            bottom: 30px;
            transform: translateX(-50%);
            font-size: 0.9rem;
        }
        .toast.show {
            visibility: visible;
            animation: fadein 0.5s, fadeout 0.5s 2.5s;
        }
        @keyframes fadein { from { bottom: 0; opacity: 0; } to { bottom: 30px; opacity: 1; } }
        @keyframes fadeout { from { bottom: 30px; opacity: 1; } to { bottom: 0; opacity: 0; } }
        @media (max-width: 600px) {
            .form-row { flex-direction: column; }
            .container { margin: 70px 10px 20px; padding: 15px; }
            .tab-buttons button { width: 40px; height: 40px; font-size: 1rem; }
        }
    </style>
</head>
<body>
    <header>
        <div class="header-left">
            <img src="https://homologacao.itech.ifsertaope.edu.br/forms/declaracoes/public/images/ASSINATURAS-ESPORTE-FUNDO-PRETO-2-HORIZONTAL.png" alt="Logo Ministério do Esporte">
            <h1>Ministério do Esporte</h1>
        </div>
        <div class="header-right">
            <div class="theme-switcher" id="theme-switcher" title="Alterar Tema" role="button" aria-label="Alternar entre tema claro e escuro">
                <i id="theme-icon-moon" class="fas fa-moon"></i>
                <i id="theme-icon-sun" class="fas fa-sun"></i>
            </div>
        </div>
    </header>
    <div class="container">
        <div class="container-header">
            <h2>Declaração de Entidade Pública</h2>
            <span class="status">Emissão</span>
        </div>
        <div class="tab-buttons" role="tablist">
            <button role="tab" aria-selected="true" aria-controls="aba1" onclick="mostrarAba('aba1')" class="active" title="Dados do Dirigente"><i class="fas fa-user-tie"></i></button>
            <button role="tab" aria-selected="false" aria-controls="aba2" onclick="mostrarAba('aba2')" disabled title="Dados da Entidade"><i class="fas fa-building"></i></button>
            <button role="tab" aria-selected="false" aria-controls="aba3" onclick="mostrarAba('aba3')" disabled title="Opções de Geração"><i class="fas fa-file-pdf"></i></button>
        </div>
        <form id="declaracoesForm" onsubmit="return false;" aria-label="Formulário de Declaração de Entidade Pública">
            <div id="aba1" class="tab active" role="tabpanel">
                <section class="section">
                    <h3><i class="fas fa-user-edit"></i> Dados do Dirigente da Entidade</h3>
                    <div class="form-row">
                        <div class="half-width">
                            <label for="dirigente">Nome:</label>
                            <input type="text" id="dirigente" oninput="validarLetras(this)" required aria-describedby="erro-dirigente">
                            <span id="erro-dirigente" class="error-message">Digite apenas letras e espaços.</span>
                        </div>
                        <div class="half-width">
                            <label for="matricula">Matrícula:</label>
                            <input type="text" id="matricula" oninput="validarNumeros(this)" required aria-describedby="erro-matricula">
                            <span id="erro-matricula" class="error-message">Digite apenas números.</span>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="half-width">
                            <label for="cargoDirigente">Cargo do Dirigente:</label>
                            <input type="text" id="cargoDirigente" placeholder="Ex: Prefeito(a), Secretário(a)" onkeypress="return validarLetrasApenas(event)" oninput="validarLetras(this)" required aria-describedby="erro-cargoDirigente">
                            <span id="erro-cargoDirigente" class="error-message">Digite apenas letras e espaços.</span>
                        </div>
                        <div class="half-width">
                            <label for="proposta">Proposta (XXXXXX/ANO):</label>
                            <input type="text" id="proposta" oninput="validarProposta(this)" maxlength="11" placeholder="Ex: 000123/2025" required aria-describedby="erro-proposta">
                            <span id="erro-proposta" class="error-message">Digite no formato XXXXXX/ANO (6 dígitos/ano).</span>
                        </div>
                    </div>
                </section>
                <div class="button-container">
                    <button type="button" onclick="validarAba('aba1', 'aba2')">Próxima</button>
                </div>
            </div>
            <div id="aba2" class="tab" role="tabpanel">
                <section class="section">
                    <h3><i class="fas fa-id-card"></i> Dados da Entidade</h3>
                    <div class="form-row">
                        <div class="half-width">
                            <label for="cnpj">CNPJ:</label>
                            <input type="text" id="cnpj" maxlength="18" oninput="mascaraCNPJ(this)" placeholder="00.000.000/0000-00" required aria-describedby="erro-cnpj">
                            <span id="erro-cnpj" class="error-message">Digite apenas números no formato CNPJ.</span>
                        </div>
                        <div class="half-width">
                            <label for="entidade">Nome da Entidade:</label>
                            <input type="text" id="entidade" readonly required aria-describedby="erro-entidade">
                            <span id="erro-entidade" class="error-message">Nome da entidade não preenchido.</span>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="full-width">
                            <label for="endereco">Endereço Completo:</label>
                            <input type="text" id="endereco" readonly required aria-describedby="erro-endereco">
                            <span id="erro-endereco" class="error-message">Endereço não preenchido.</span>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="third-width">
                            <label for="uf">UF:</label>
                            <input type="text" id="uf" readonly required aria-describedby="erro-uf">
                            <span id="erro-uf" class="error-message">UF não preenchida.</span>
                        </div>
                        <div class="third-width">
                            <label for="municipio">Município:</label>
                            <input type="text" id="municipio" readonly required aria-describedby="erro-municipio">
                            <span id="erro-municipio" class="error-message">Município não preenchido.</span>
                        </div>
                        <div class="third-width">
                            <label for="cep">CEP:</label>
                            <input type="text" id="cep" readonly required aria-describedby="erro-cep">
                            <span id="erro-cep" class="error-message">CEP não preenchido.</span>
                        </div>
                    </div>
                </section>
                <div class="button-container">
                    <button type="button" onclick="mostrarAba('aba1')">Voltar</button>
                    <button type="button" onclick="validarAba('aba2', 'aba3')">Próxima</button>
                </div>
            </div>
            <div id="aba3" class="tab" role="tabpanel">
                <section class="section">
                    <h3><i class="fas fa-cogs"></i> Escolha uma Opção para Gerar o PDF</h3>
                    <div class="option-group">
                        <label for="radio_00SL" class="option-group-header">
                            <input type="radio" id="radio_00SL" name="tipo_proposta" value="00SL" onchange="atualizarOpcao()"> Proposta 00SL
                        </label>
                        <div id="sub_options_00SL" class="sub-options">
                            <p><strong>Origem do Recurso:</strong></p>
                            <div class="radio-container">
                                <input type="radio" id="radio_00SL_emenda" name="origem_00SL" value="emendas" onchange="atualizarOpcao()">
                                <label for="radio_00SL_emenda">Emenda Individual e Bancada</label>
                                <input type="radio" id="radio_00SL_comissao" name="origem_00SL" value="comissao" onchange="atualizarOpcao()">
                                <label for="radio_00SL_comissao">Discricionário e Comissão</label>
                            </div>
                            <div id="camposEspacoFisico" class="espaco-fisico-container">
                                <h4>Dados do Espaço Físico</h4>
                                <div id="espacoFisicoFields">
                                    <div class="form-row" id="espacoFisicoRow0">
                                        <div class="half-width">
                                            <label for="nomeEspacoFisico0">Nome do Espaço Físico:</label>
                                            <input type="text" id="nomeEspacoFisico0" oninput="validarLetras(this)" required aria-describedby="erro-nomeEspacoFisico0">
                                            <span id="erro-nomeEspacoFisico0" class="error-message">Digite apenas letras e espaços.</span>
                                        </div>
                                        <div class="half-width">
                                            <label for="enderecoEspacoFisico0">Endereço do Espaço Físico:</label>
                                            <input type="text" id="enderecoEspacoFisico0" required aria-describedby="erro-enderecoEspacoFisico0">
                                            <span id="erro-enderecoEspacoFisico0" class="error-message">Campo obrigatório.</span>
                                        </div>
                                        <button type="button" class="remove-btn" onclick="removerEspacoFisico(0)" style="display: none;">Remover</button>
                                    </div>
                                </div>
                                <div class="button-container">
                                    <button type="button" onclick="adicionarEspacoFisico()"><i class="fas fa-plus"></i> Adicionar Espaço</button>
                                    <button type="button" onclick="salvarEspacoFisico()">Salvar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="option-group">
                        <label for="radio_20JP" class="option-group-header">
                            <input type="radio" id="radio_20JP" name="tipo_proposta" value="20JP" onchange="atualizarOpcao()"> Proposta 20JP
                        </label>
                        <div id="sub_options_20JP" class="sub-options">
                            <p><strong>Origem do Recurso:</strong></p>
                            <div class="radio-container">
                                <input type="radio" id="radio_20JP_emenda" name="origem_20JP" value="emenda" onchange="atualizarOpcao()">
                                <label for="radio_20JP_emenda">Emenda Individual e de Bancada</label>
                                <input type="radio" id="radio_20JP_comissao" name="origem_20JP" value="comissao" onchange="atualizarOpcao()">
                                <label for="radio_20JP_comissao">Discricionário e Comissão</label>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="button-container">
                    <button type="button" onclick="mostrarAba('aba2')">Voltar</button>
                    <button type="button" id="gerarPDF" disabled>Gerar PDF</button>
                </div>
            </div>
        </form>
        <div id="loadingMessage">Aguarde, gerando PDF...</div>
        <div id="toast" class="toast"></div>
    </div>
    <footer>
        <p>© 2025 Ministério do Esporte</p>
    </footer>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="/forms/declaracoes/public/js/script2.js"></script>
    <script>
        // Define Roboto fonts for pdfMake globally
        pdfMake.fonts = {
            Roboto: {
                normal: 'https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/fonts/Roboto/Roboto-Regular.ttf',
                bold: 'https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/fonts/Roboto/Roboto-Medium.ttf',
                italics: 'https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/fonts/Roboto/Roboto-Italic.ttf',
                bolditalics: 'https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/fonts/Roboto/Roboto-MediumItalic.ttf'
            }
        };

        let espacoFisicoCount = 1;
        let is00SLEnabled = false;

        // Tema claro/escuro
        const themeSwitcher = document.getElementById('theme-switcher');
        const html = document.documentElement;
        themeSwitcher.addEventListener('click', () => {
            html.classList.toggle('dark');
            localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
        });

        // Inicialização
        document.addEventListener('DOMContentLoaded', () => {
            if (localStorage.getItem('theme') === 'dark') html.classList.add('dark');
            setupAba3Listeners();
            const gerarPDFBtn = document.getElementById('gerarPDF');
            gerarPDFBtn.addEventListener('click', () => {
                document.getElementById('loadingMessage').style.display = 'block';
                try {
                    if (typeof gerarPDF === 'function') {
                        // Coleta dados para passar ao script2.js
                        const dados = {
                            dirigente: document.getElementById('dirigente').value,
                            matricula: document.getElementById('matricula').value,
                            cargoDirigente: document.getElementById('cargoDirigente').value,
                            proposta: document.getElementById('proposta').value,
                            cnpj: document.getElementById('cnpj').value,
                            entidade: document.getElementById('entidade').value,
                            endereco: document.getElementById('endereco').value,
                            uf: document.getElementById('uf').value,
                            municipio: document.getElementById('municipio').value,
                            cep: document.getElementById('cep').value,
                            opcaoSelecao: document.getElementById('opcaoSelecao').value,
                            espacosFisicos: []
                        };
                        document.querySelectorAll('#espacoFisicoFields .form-row').forEach(row => {
                            const nome = row.querySelector('input[id^="nomeEspacoFisico"]').value;
                            const endereco = row.querySelector('input[id^="enderecoEspacoFisico"]').value;
                            if (nome && endereco) {
                                dados.espacosFisicos.push({ nome, endereco });
                            }
                        });
                        gerarPDF(dados); // Chama a função do script2.js
                        document.getElementById('loadingMessage').style.display = 'none';
                        showToast('PDF gerado com sucesso!');
                    } else if (typeof generateDeclarationPDF === 'function') {
                        generateDeclarationPDF(); // Tenta chamar uma função alternativa
                        document.getElementById('loadingMessage').style.display = 'none';
                        showToast('PDF gerado com sucesso!');
                    } else {
                        throw new Error('Função de geração de PDF não encontrada.');
                    }
                } catch (error) {
                    document.getElementById('loadingMessage').style.display = 'none';
                    showToast('Erro ao gerar PDF: ' + error.message, true);
                }
            });
        });

        function mostrarAba(abaId) {
            document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.tab-buttons button').forEach(btn => btn.classList.remove('active'));
            document.getElementById(abaId).classList.add('active');
            document.querySelector(`.tab-buttons button[onclick="mostrarAba('${abaId}')"]`).classList.add('active');
            document.querySelectorAll('.tab-buttons button').forEach(btn => {
                btn.setAttribute('aria-selected', btn.classList.contains('active'));
            });
        }

        function validarLetras(input) {
            const erro = document.getElementById(`erro-${input.id}`);
            if (erro) {
                input.value = input.value.replace(/[^A-Za-zÀ-ÿ\s]/g, '');
                erro.style.display = input.value ? 'none' : 'block';
            }
        }

        function validarLetrasApenas(event) {
            const char = String.fromCharCode(event.which || event.keyCode);
            return /^[A-Za-zÀ-ÿ\s]$/.test(char) || event.preventDefault();
        }

        function validarNumeros(input) {
            const erro = document.getElementById(`erro-${input.id}`);
            if (erro) {
                input.value = input.value.replace(/\D/g, '');
                erro.style.display = input.value ? 'none' : 'block';
            }
        }

        function validarProposta(input) {
            const erro = document.getElementById('erro-proposta');
            let value = input.value.replace(/\D/g, '');
            if (value.length > 10) value = value.slice(0, 10);
            if (value.length > 6) value = value.slice(0, 6) + '/' + value.slice(6);
            input.value = value;
            erro.style.display = input.value && !/^\d{6}\/\d{4}$/.test(input.value) ? 'block' : 'none';
        }

        function mascaraCNPJ(input) {
            const erro = document.getElementById('erro-cnpj');
            let value = input.value.replace(/\D/g, '');
            if (value.length >= 14) {
                erro.style.display = 'none';
                fetchCNPJData(value);
            } else {
                erro.textContent = 'Digite 14 números.';
                erro.style.display = 'block';
                document.getElementById('entidade').value = '';
                document.getElementById('endereco').value = '';
                document.getElementById('uf').value = '';
                document.getElementById('municipio').value = '';
                document.getElementById('cep').value = '';
                document.getElementById('erro-entidade').style.display = 'block';
                document.getElementById('erro-endereco').style.display = 'block';
                document.getElementById('erro-uf').style.display = 'block';
                document.getElementById('erro-municipio').style.display = 'block';
                document.getElementById('erro-cep').style.display = 'block';
            }
            let valorFormatado = '';
            if (value.length > 0) valorFormatado = value.substring(0, 2);
            if (value.length > 2) valorFormatado += '.' + value.substring(2, 5);
            if (value.length > 5) valorFormatado += '.' + value.substring(5, 8);
            if (value.length > 8) valorFormatado += '/' + value.substring(8, 12);
            if (value.length > 12) valorFormatado += '-' + value.substring(12, 14);
            input.value = valorFormatado;
        }

        async function fetchCNPJData(cnpj) {
            const erro = document.getElementById('erro-cnpj');
            const entidadeInput = document.getElementById('entidade');
            const enderecoInput = document.getElementById('endereco');
            const ufInput = document.getElementById('uf');
            const municipioInput = document.getElementById('municipio');
            const cepInput = document.getElementById('cep');
            try {
                const response = await fetch(`https://brasilapi.com.br/api/cnpj/v1/${cnpj}`);
                if (!response.ok) throw new Error('CNPJ não encontrado');
                const data = await response.json();
                const razaoSocial = data.razao_social || '';
                const isMunicipio = razaoSocial.toLowerCase().includes('munic') || razaoSocial.toLowerCase().includes('prefeitura');
                entidadeInput.value = isMunicipio && data.municipio && data.uf ? 
                    `Município de ${data.municipio}/${data.uf.toUpperCase()}` : 
                    razaoSocial || '';
                document.getElementById('erro-entidade').style.display = entidadeInput.value ? 'none' : 'block';
                const endereco = `${data.logradouro || ''}${data.numero ? `, ${data.numero}` : ''}${data.bairro ? '' : ''}`;
                enderecoInput.value = endereco.trim().replace(/^,|,$/g, '') || '';
                document.getElementById('erro-endereco').style.display = enderecoInput.value ? 'none' : 'block';
                ufInput.value = data.uf ? data.uf.toUpperCase() : '';
                document.getElementById('erro-uf').style.display = ufInput.value ? 'none' : 'block';
                municipioInput.value = data.municipio ? data.municipio.replace(/[^A-Za-zÀ-ÿ\s]/g, '') : '';
                document.getElementById('erro-municipio').style.display = municipioInput.value ? 'none' : 'block';
                if (data.cep) {
                    const cleanCEP = data.cep.replace(/\D/g, '');
                    cepInput.value = cleanCEP.replace(/^(\d{5})(\d{3})$/, '$1-$2');
                    document.getElementById('erro-cep').style.display = 'none';
                } else {
                    cepInput.value = '';
                    document.getElementById('erro-cep').style.display = 'block';
                }
                erro.style.display = '';
            } catch (error) {
                erro.textContent = 'CNPJ inválido ou serviço indisponível.';
                erro.style.display = 'block';
                entidadeInput.value = '';
                enderecoInput.value = '';
                ufInput.value = '';
                municipioInput.value = '';
                cepInput.value = '';
                document.getElementById('erro-entidade').style.display = 'block';
                document.getElementById('erro-endereco').style.display = 'block';
                document.getElementById('erro-uf').style.display = 'block';
                document.getElementById('erro-municipio').style.display = 'block';
                document.getElementById('erro-cep').style.display = 'block';
            }
        }

        function validarAba(currentTab, nextTab) {
            let campos;
            switch (currentTab) {
                case 'aba1':
                    campos = ['dirigente', 'matricula', 'cargoDirigente', 'proposta'];
                    break;
                case 'aba2':
                    campos = ['cnpj', 'entidade', 'endereco', 'uf', 'municipio', 'cep'];
                    break;
                default:
                    return;
            }
            let valido = true;
            campos.forEach(id => {
                const input = document.getElementById(id);
                const erro = document.getElementById(`erro-${id}`);
                if (!input || !erro) {
                    console.warn(`Elemento ou erro não encontrado para ${id}`);
                    return;
                }
                let isInvalid = false;
                if (!input.value) {
                    isInvalid = true;
                } else if (id === 'cnpj' && input.value.replace(/\D/g, '').length !== 14) {
                    erro.textContent = 'O CNPJ deve conter 14 números.';
                    isInvalid = true;
                } else if (id === 'proposta' && !/^\d{6}\/\d{4}$/.test(input.value)) {
                    erro.textContent = 'Digite no formato XXXXXX/ANO (6 dígitos/ano).';
                    isInvalid = true;
                } else if (id === 'cep' && input.value.length !== 9) {
                    isInvalid = true;
                }
                erro.style.display = isInvalid ? 'block' : 'none';
                valido = valido && !isInvalid;
            });
            if (valido) {
                const nextButton = document.querySelector(`button[onclick="mostrarAba('${nextTab}')"]`);
                if (nextButton) {
                    nextButton.disabled = false;
                    mostrarAba(nextTab);
                }
            } else {
                showToast('Preencha todos os campos obrigatórios corretamente.', true);
            }
        }

        function setupAba3Listeners() {
            document.querySelectorAll('input[name="tipo_proposta"]').forEach(radio => {
                radio.addEventListener('change', () => {
                    document.getElementById('sub_options_00SL').style.display = radio.id === 'radio_00SL' && radio.checked ? 'block' : 'none';
                    document.getElementById('sub_options_20JP').style.display = radio.id === 'radio_20JP' && radio.checked ? 'block' : 'none';
                    document.getElementById('camposEspacoFisico').style.display = radio.id === 'radio_00SL' && radio.checked ? 'block' : 'none';
                    atualizarOpcao();
                    validarGerarPDF();
                });
            });
            document.querySelectorAll('input[name^="origem_"]').forEach(radio => {
                radio.addEventListener('change', () => {
                    atualizarOpcao();
                    validarGerarPDF();
                });
            });
            document.querySelectorAll('#espacoFisicoFields input').forEach(input => {
                input.addEventListener('input', validarGerarPDF);
            });
        }

        function adicionarEspacoFisico() {
            const container = document.getElementById('espacoFisicoFields');
            const index = espacoFisicoCount++;
            const div = document.createElement('div');
            div.className = 'form-row';
            div.id = `espacoFisicoRow${index}`;
            div.innerHTML = `
                <div class="half-width">
                    <label for="nomeEspacoFisico${index}">Nome do Espaço Físico:</label>
                    <input type="text" id="nomeEspacoFisico${index}" oninput="validarLetras(this)" required aria-describedby="erro-nomeEspacoFisico${index}">
                    <span id="erro-nomeEspacoFisico${index}" class="error-message">Digite apenas letras e espaços.</span>
                </div>
                <div class="half-width">
                    <label for="enderecoEspacoFisico${index}">Endereço do Espaço Físico:</label>
                    <input type="text" id="enderecoEspacoFisico${index}" required aria-describedby="erro-enderecoEspacoFisico${index}">
                    <span id="erro-enderecoEspacoFisico${index}" class="error-message">Campo necessário.</span>
                </div>
                <button type="button" class="remove-btn" onclick="removerEspacoFisico(${index})">Remover</button>
            `;
            container.appendChild(div);
            document.querySelectorAll('.remove-btn').forEach(btn => btn.style.display = 'inline-block');
            validarGerarPDF();
        }

        function removerEspacoFisico(index) {
            const toRemove = document.getElementById(`espacoFisicoRow${index}`);
            if (toRemove) toRemove.remove();
            if (document.querySelectorAll('#espacoFisicoFields .form-row').length <= 1) {
                document.querySelector('#espacoFisicoFields .remove-btn').style.display = 'none';
            }
            validarGerarPDF();
        }

        function salvarEspacoFisico() {
            let valido = true;
            const campos = document.querySelectorAll('#espacoFisicoFields .form-row');
            const tipoProposta = document.querySelector('input[name="tipo_proposta"]:checked');
            if (tipoProposta && tipoProposta.value === '00SL') {
                if (campos.length === 0) {
                    showToast('Adicione pelo menos um espaço físico.', true);
                    return;
                }
                campos.forEach(row => {
                    const nomeInput = row.querySelector('input[id^="nomeEspacoFisico"]');
                    const enderecoInput = row.querySelector('input[id^="enderecoEspacoFisico"]');
                    const erroNome = row.querySelector('span[id^="erro-nomeEspacoFisico"]');
                    const erroEndereco = row.querySelector('span[id^="erro-enderecoEspacoFisico"]');
                    if (!nomeInput.value.trim()) {
                        erroNome.style.display = 'block';
                        valido = false;
                    } else {
                        erroNome.style.display = 'none';
                    }
                    if (!enderecoInput.value.trim()) {
                        erroEndereco.style.display = 'block';
                        valido = false;
                    } else {
                        erroEndereco.style.display = 'none';
                    }
                });
            }
            if (valido) {
                is00SLEnabled = true;
                showToast('Dados do espaço físico salvos com sucesso!');
            } else {
                showToast('Preencha todos os campos dos espaços físicos corretamente.', true);
            }
            validarGerarPDF();
        }

        function validarGerarPDF() {
            const btn = document.getElementById('gerarPDF');
            let valido = false;
            const tipo = document.querySelector('input[name="tipo_proposta"]:checked');
            if (tipo) {
                if (tipo.value === '00SL') {
                    const origem = document.querySelector('input[name="origem_00SL"]:checked');
                    if (origem && is00SLEnabled) {
                        let espacosOk = true;
                        const espacos = document.querySelectorAll('#espacoFisicoFields input[required]');
                        if (espacos.length === 0) {
                            espacosOk = false;
                            showToast('Adicione pelo menos um espaço físico para a proposta 00SL.', true);
                        }
                        espacos.forEach(i => {
                            if (!i.value.trim()) {
                                espacosOk = false;
                                document.getElementById(`erro-${i.id}`).style.display = 'block';
                            } else {
                                document.getElementById(`erro-${i.id}`).style.display = 'none';
                            }
                        });
                        valido = espacosOk;
                    } else {
                        showToast('Selecione a origem do recurso e salve os espaços físicos.', true);
                    }
                } else if (tipo.value === '20JP') {
                    const origem = document.querySelector('input[name="origem_20JP"]:checked');
                    if (origem) {
                        valido = true;
                    } else {
                        showToast('Selecione a origem do recurso para a proposta 20JP.', true);
                    }
                }
            } else {
                showToast('Selecione o tipo de proposta (00SL ou 20JP).', true);
            }
            btn.disabled = !valido;
        }

        function showToast(message, isError = false) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.style.backgroundColor = isError ? 'var(--error-color)' : 'var(--success-color)';
            toast.className = 'toast show';
            setTimeout(() => toast.className = toast.className.replace('show', ''), 3000);
        }

        function atualizarOpcao() {
            const tipo = document.querySelector('input[name="tipo_proposta"]:checked')?.value;
            const origem = document.querySelector('input[name="origem_00SL"]:checked')?.value || document.querySelector('input[name="origem_20JP"]:checked')?.value;
            const opcaoInput = document.getElementById('opcaoSelecao');
            if (tipo && origem) {
                opcaoInput.value = `${tipo}_${origem}`;
            } else {
                opcaoInput.value = '';
            }
        }

        // Inicializar campo oculto
        document.body.insertAdjacentHTML('beforeend', '<input type="hidden" id="opcaoSelecao" value="">');
    </script>
</body>
</html>